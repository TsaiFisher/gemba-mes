@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Services
@inject IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL
@inject ISystemParamService SystemParamSvc

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartFactory.MES</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/select2/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap-5-theme/dist/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/csp-utilities.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartFactory.MES.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <button class="btn btn-link me-2" id="sidebarToggle">
                    <i class="bi bi-list fs-4"></i>
                </button>
                @{
                    var _isEn = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("en");
                    var _logoUrl = await SystemParamSvc.GetLogoUrlAsync();
                    var _shortName = await SystemParamSvc.GetCompanyShortAsync(_isEn);
                }
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-page="/Index">
                    @if (!string.IsNullOrEmpty(_logoUrl))
                    {
                        <img src="@_logoUrl" alt="Logo" class="u-height-32px u-width-auto u-object-fit-contain" />
                    }
                    <span>@_shortName</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">@Localizer["Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">@Localizer["Privacy"]</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @{
                            var screenHelpUrl = SmartFactory.MES.Services.HelpDocResolver.Resolve(
                                ViewContext.RouteData.Values["controller"]?.ToString());
                        }
                        @if (screenHelpUrl != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@screenHelpUrl" target="_blank" title="@SL["ScreenHelpTitle"]">
                                    <i class="bi bi-question-circle"></i>
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="docsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-book"></i>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="docsDropdown">
                                <li><h6 class="dropdown-header">@SL["DocsHeader"]</h6></li>
                                <li><a class="dropdown-item" href="/docs/index.html" target="_blank"><i class="bi bi-grid me-2"></i>@SL["DocsCenter"]</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                @* 使用手冊為中英同頁，UI 為英文時帶 ?lang=en；管理／維護手冊僅有中文版，不帶參數。 *@
                                <li><a class="dropdown-item" href="@SmartFactory.MES.Services.HelpDocResolver.WithLang("/docs/user/index.html")" target="_blank"><i class="bi bi-person-circle me-2"></i>@SL["UserManualLink"]</a></li>
                                <li><a class="dropdown-item" href="/docs/admin/index.html" target="_blank"><i class="bi bi-gear-wide-connected me-2"></i>@SL["AdminManualLink"]</a></li>
                                <li><a class="dropdown-item" href="/docs/maintenance/index.html" target="_blank"><i class="bi bi-tools me-2"></i>@SL["MaintenanceManualLink"]</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" href="/docs/admin/go-live-checklist.html" target="_blank"><i class="bi bi-check2-square me-2"></i>@SL["GoLiveChecklistLink"]</a></li>
                            </ul>
                        </li>
                        @await Component.InvokeAsync("PendingApprovalBadge")
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-translate"></i> @System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName.ToUpper()
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                                @* returnUrl 必須含 QueryString：登入頁的 ?ReturnUrl=... 若被丟掉，
                                   切換語系後登入會跑回首頁而非使用者原本要去的頁面。 *@
                                @{ var _returnUrl = Context.Request.Path + Context.Request.QueryString; }
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    @* 已登入：POST＋anti-forgery，同時寫回帳號偏好（推播、手機登入預設語系讀它）。
                                       GET 不得改狀態，所以登入後不能沿用下面的連結。 *@
                                    <li>
                                        <form method="post" class="m-0" action="@Url.Action("SetLanguage", "UserSettings", new { culture = "zh-TW", returnUrl = _returnUrl })">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">
                                                繁體中文
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form method="post" class="m-0" action="@Url.Action("SetLanguage", "UserSettings", new { culture = "en-US", returnUrl = _returnUrl })">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item">
                                                English
                                            </button>
                                        </form>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("SetLanguage", "UserSettings", new { culture = "zh-TW", returnUrl = _returnUrl })">
                                            繁體中文
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("SetLanguage", "UserSettings", new { culture = "en-US", returnUrl = _returnUrl })">
                                            English
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <div class="row">
            <nav id="sidebar-container" class="col-md-3 col-lg-2 sidebar">
                <div class="position-sticky">
                    @await Component.InvokeAsync("SidebarMenu")
                </div>
            </nav>

            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="pt-3 pb-2 mb-3">
                    @await Component.InvokeAsync("LicenseBanner")
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - SmartFactory.MES - <a asp-area="" asp-page="/Privacy">@Localizer["Privacy"]</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/select2/dist/js/select2.min.js"></script>
    <script src="~/lib/dompurify/dist/purify.min.js"></script>
    @await Html.PartialAsync("/Views/Shared/_PlantContextScripts.cshtml")
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/data-action.js" asp-append-version="true"></script>
    <script src="~/js/uom-step.js" asp-append-version="true"></script>
    <script src="~/js/currency-format.js" asp-append-version="true"></script>
    <script src="~/js/inv-source-picker.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>