# SmartFactory.MES 反向代理範本（安全修正 H1）
# ─────────────────────────────────────────────────────────────────────────
# 用途：於應用程式前置一層 nginx 終結 TLS，並帶入 X-Forwarded-* 標頭，
#       使 Kestrel（綁 127.0.0.1:8080，見 docker-compose.yml）取得正確的
#       scheme 與 client IP（Program.cs 的 UseForwardedHeaders 依此運作）。
#
# 部署步驟：
#   1. 複製本檔為 /etc/nginx/conf.d/smartfactory.conf 並改 server_name / 憑證路徑。
#   2. 憑證建議用 Let's Encrypt（certbot）或企業 CA 簽發。
#   3. reload：nginx -t && systemctl reload nginx
#
# 注意：本範本僅供 ops 參考，不由應用程式讀取。

# HTTP → HTTPS 強制轉址
server {
    listen 80;
    server_name mes.example.com;          # ← 改成實際網域

    # ACME 挑戰（certbot webroot）例外，其餘一律轉 HTTPS
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name mes.example.com;          # ← 改成實際網域

    # ── TLS ──────────────────────────────────────────────────────────────
    ssl_certificate     /etc/letsencrypt/live/mes.example.com/fullchain.pem;   # ← 改
    ssl_certificate_key /etc/letsencrypt/live/mes.example.com/privkey.pem;     # ← 改
    ssl_protocols       TLSv1.2 TLSv1.3;   # 停用 TLS 1.0/1.1
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # 上傳大小上限（Logo 上限 2MB，留餘裕）
    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:8080;   # ← 對應 docker-compose app 綁定的 loopback 埠

        # UseForwardedHeaders 依賴以下標頭還原真實 scheme 與 client IP
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SignalR / WebSocket（如未來啟用推播即時通道）
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 120s;
    }

    # 健康檢查（若由外部負載平衡探測，可在此限制來源）
    # location = /health { proxy_pass http://127.0.0.1:8080; allow 10.0.0.0/8; deny all; }
}
