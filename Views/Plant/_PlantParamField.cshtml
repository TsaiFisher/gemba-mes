@using SmartFactory.MES.Modules.BAS.Models
@model PlantParamFieldModel
@*
    單一廠別參數的三態欄位（繼承全域／覆寫）。純 HTML，不得加 JS 或行內樣式——理由見
    _ProjectZPlantParams.cshtml 檔頭。未勾「覆寫」時值控制項仍可編輯（沒有 JS 可以 disable），
    但 PlantFormEnhancementFilter 會忽略它並清掉該廠覆寫，語意以核取方塊為準。
*@
@{
    var d      = Model.Def;
    var ovrId  = "ovr_" + d.Key;
    var valId  = "val_" + d.Key;
    var isOn   = string.Equals(Model.Value, "true", StringComparison.OrdinalIgnoreCase);

    string Display(string? raw) =>
        string.IsNullOrWhiteSpace(raw) ? Localizer["NotSet"].Value
        : d.Kind == PlantParamKind.Bool
            ? Localizer[string.Equals(raw, "true", StringComparison.OrdinalIgnoreCase) ? "On" : "Off"].Value
        : d.Kind == PlantParamKind.Choice ? Localizer["Choice" + raw].Value
        : raw;
}
<div class="mb-3">
    <label class="form-label small fw-semibold mb-1" for="@valId">@Localizer[d.ResourceKey]</label>
    <div class="d-flex align-items-center gap-2">
        <div class="form-check mb-0 text-nowrap">
            @* checkbox 在前、hidden 在後（與 ASP.NET checkbox tag helper 一致）。
               後端仍以「任一值為 true」判定，不依賴先後——見 PlantFormEnhancementFilter.IsChecked。 *@
            <input class="form-check-input" type="checkbox" id="@ovrId"
                   name="@d.OverrideField" value="true" @(Model.IsOverridden ? "checked" : "") />
            <input type="hidden" name="@d.OverrideField" value="false" />
            <label class="form-check-label small" for="@ovrId">@Localizer["Override"]</label>
        </div>
        <div class="flex-grow-1">
            @switch (d.Kind)
            {
                case PlantParamKind.Bool:
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" type="checkbox" id="@valId"
                               name="@d.ValueField" value="true" @(isOn ? "checked" : "") />
                        <input type="hidden" name="@d.ValueField" value="false" />
                        <label class="form-check-label small" for="@valId">@Localizer[isOn ? "On" : "Off"]</label>
                    </div>
                    break;

                case PlantParamKind.Choice:
                    <select class="form-select form-select-sm" id="@valId" name="@d.ValueField">
                        @foreach (var c in d.Choices ?? [])
                        {
                            <option value="@c" selected="@(string.Equals(Model.Value, c, StringComparison.OrdinalIgnoreCase))">@Localizer["Choice" + c]</option>
                        }
                    </select>
                    break;

                case PlantParamKind.Number:
                    <input class="form-control form-control-sm" type="number" min="0" step="any"
                           id="@valId" name="@d.ValueField" value="@Model.Value" />
                    break;

                default:
                    <input class="form-control form-control-sm" type="text" maxlength="100"
                           id="@valId" name="@d.ValueField" value="@Model.Value" />
                    break;
            }
        </div>
    </div>
    <div class="form-text">
        @Localizer["GlobalValue"]：
        @if (Model.IsOverridden)
        {
            <del class="text-muted">@Display(Model.GlobalValue)</del>
        }
        else
        {
            <span>@Display(Model.GlobalValue)</span>
        }
    </div>
</div>
