@{
    ViewData["Title"] = Localizer["Title"];
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-shield-lock"></i> @Localizer["Header"]</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted small">@Localizer["Intro"]</p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label">@Localizer["NewPassword"]</label>
                            <input type="password" name="newPassword" class="form-control" required minlength="6" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Localizer["ConfirmNewPassword"]</label>
                            <input type="password" name="confirmPassword" class="form-control" required minlength="6" />
                        </div>
                        <button type="submit" class="btn btn-warning w-100">
                            <i class="bi bi-check-circle"></i> @Localizer["Submit"]
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
