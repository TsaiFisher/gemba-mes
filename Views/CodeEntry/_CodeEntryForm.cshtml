@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.CodeEntry

@{
    bool isEdit = ViewBag.IsEdit == true;
    bool isReadOnly = ViewBag.IsReadOnly == true;
    string action = isEdit ? "Edit" : "Create";
}

<form method="post" asp-action="@action" asp-controller="CodeEntry" data-ajax="true">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" asp-for="Id" /> }
<fieldset @(isReadOnly ? Html.Raw("disabled=\"disabled\"") : Html.Raw(""))>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["Category"] <span class="text-danger">*</span></label>
        @if (isEdit)
        {
            <input type="text" class="form-control" value="@Model.Category" readonly />
            <input type="hidden" asp-for="Category" />
            <div class="form-text">@Localizer["CategoryReadonlyHint"]</div>
        }
        else
        {
            <input asp-for="Category" class="form-control" placeholder="@Localizer["CategoryPlaceholder"]" />
            <div class="form-text">@Localizer["CategoryHint"]</div>
        }
        <span asp-validation-for="Category" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["Code"] <span class="text-danger">*</span></label>
        @if (isEdit)
        {
            <input type="text" class="form-control" value="@Model.Code" readonly />
            <input type="hidden" asp-for="Code" />
            <div class="form-text">@Localizer["CodeReadonlyHint"]</div>
        }
        else
        {
            <input asp-for="Code" class="form-control" placeholder="@Localizer["CodePlaceholder"]" />
        }
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["NameZh"] <span class="text-danger">*</span></label>
        <input asp-for="NameZh" class="form-control" placeholder="@Localizer["NameZhPlaceholder"]" />
        <span asp-validation-for="NameZh" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["NameEn"]</label>
        <input asp-for="NameEn" class="form-control" placeholder="@Localizer["NameEnPlaceholder"]" />
        <span asp-validation-for="NameEn" class="text-danger small"></span>
    </div>

    <div class="row mb-3">
        <div class="col-6">
            <label class="form-label fw-semibold">@Localizer["SortOrder"]</label>
            <input asp-for="SortOrder" type="number" class="form-control" />
            <div class="form-text">@Localizer["SortOrderHint"]</div>
        </div>
        <div class="col-6 d-flex align-items-end pb-1">
            <div class="form-check">
                <input type="checkbox" asp-for="IsActive" class="form-check-input" id="isActive" />
                <label class="form-check-label fw-semibold" for="isActive">@Localizer["IsActive"]</label>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["Remark"]</label>
        <textarea asp-for="Remark" class="form-control" rows="2" placeholder="@Localizer["RemarkPlaceholder"]"></textarea>
        <span asp-validation-for="Remark" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary" data-dismiss-panel="true">
            @Localizer["Cancel"]
        </button>
    </div>
</fieldset>
@if (isReadOnly)
{
    <div class="px-3 pb-3 pt-2 border-top text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">
            <i class="bi bi-x-lg me-1"></i>@Localizer["Close"]
        </button>
    </div>
}
</form>
