@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Models
@inject IViewLocalizer Localizer
@inject SmartFactory.MES.Services.IApprovalDocumentTypeLabels DocTypeLabels
@model SmartFactory.MES.Models.ApprovalRequest

@{
    var request = Model;
    var step = ViewBag.Step as ApprovalStep;
}

<!-- 單據資訊 -->
<div class="mb-4">
    <div class="row g-2 text-sm">
        <div class="col-6">
            <div class="text-muted small">@Localizer["DocumentType"]</div>
            <span class="badge bg-secondary">@DocTypeLabels.Get(request.DocumentType)</span>
        </div>
        <div class="col-6">
            <div class="text-muted small">@Localizer["DocumentId"]</div>
            <strong>@request.DocumentId</strong>
        </div>
        @if (step != null)
        {
            string approverLabel = step.ApproverType == ApproverType.Supervisor
                ? Localizer["Supervisor"].Value
                : step.ApproverType == ApproverType.Role
                    ? Localizer["RoleApprover"].Value
                    : Localizer["UserApprover"].Value;
            <div class="col-6">
                <div class="text-muted small">@Localizer["CurrentStep"]</div>
                <span>@string.Format(Localizer["StepNoFmt"].Value, step.Sequence) — @approverLabel</span>
            </div>
            @if (!string.IsNullOrEmpty(step.Condition))
            {
                <div class="col-6">
                    <div class="text-muted small">@Localizer["TriggerCondition"]</div>
                    <code class="small">@step.Condition</code>
                </div>
            }
        }
    </div>
</div>

<hr />

<form method="post" asp-action="Process" asp-controller="Approval" asp-route-id="@request.Id" data-ajax="true">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["ReviewComment"]</label>
        <textarea name="comment" class="form-control" rows="3"
                  placeholder="@Localizer["CommentPlaceholder"]"></textarea>
    </div>

    <div class="d-flex gap-2 mt-4">
        <button type="submit" name="approvalAction" value="@((int)ApprovalStatus.Approved)"
                class="btn btn-success flex-fill">
            <i class="bi bi-check-circle"></i> @Localizer["Approve"]
        </button>
        <button type="submit" name="approvalAction" value="@((int)ApprovalStatus.ReturnedForRevision)"
                class="btn btn-warning flex-fill">
            <i class="bi bi-arrow-return-left"></i> @Localizer["ReturnForRevision"]
        </button>
        <button type="submit" name="approvalAction" value="@((int)ApprovalStatus.Rejected)"
                class="btn btn-outline-danger flex-fill">
            <i class="bi bi-x-circle"></i> @Localizer["Reject"]
        </button>
    </div>
    <div class="mt-2">
        <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="offcanvas">@Localizer["Cancel"]</button>
    </div>
</form>
