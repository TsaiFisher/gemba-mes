@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Models
@using SmartFactory.MES.Services
@inject IViewLocalizer Localizer
@inject SmartFactory.MES.Services.IApprovalDocumentTypeLabels DocTypeLabels
@inject IPermissionService PermissionService
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Models.ApprovalRequest>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.SharedResource> SL

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var stepsMap = ViewBag.StepsMap as Dictionary<string, ApprovalStep> ?? new();
    var requesterNames = ViewBag.RequesterNames as Dictionary<string, string> ?? new();
    bool unassignedFilter = ViewBag.UnassignedFilter as bool? ?? false;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-list-check"></i> @Localizer["PageTitle"]</h1>
        <a asp-action="PendingIndex" asp-controller="Approval" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-pen"></i> @Localizer["PendingApprovals"]
        </a>
    </div>

    <!-- 篩選列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-center">
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-md-3">
                    <select name="status" class="form-select form-select-sm" data-action-change="submitOwnForm">
                        <option value="">@Localizer["AllStatus"]</option>
                        @if (ViewBag.StatusFilter == "Pending") { <option value="Pending" selected>@Localizer["StatusPending"]</option> }
                        else { <option value="Pending">@Localizer["StatusPending"]</option> }
                        @if (ViewBag.StatusFilter == "Approved") { <option value="Approved" selected>@Localizer["StatusApproved"]</option> }
                        else { <option value="Approved">@Localizer["StatusApproved"]</option> }
                        @if (ViewBag.StatusFilter == "Rejected") { <option value="Rejected" selected>@Localizer["StatusRejected"]</option> }
                        else { <option value="Rejected">@Localizer["StatusRejected"]</option> }
                        @if (ViewBag.StatusFilter == "Withdrawn") { <option value="Withdrawn" selected>@Localizer["StatusWithdrawn"]</option> }
                        else { <option value="Withdrawn">@Localizer["StatusWithdrawn"]</option> }
                        @if (ViewBag.StatusFilter == "ReturnedForRevision") { <option value="ReturnedForRevision" selected>@Localizer["StatusReturned"]</option> }
                        else { <option value="ReturnedForRevision">@Localizer["StatusReturned"]</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <input type="text" name="documentType" class="form-control form-control-sm"
                           placeholder="@Localizer["DocumentTypeFilter"]" value="@ViewBag.DocTypeFilter" />
                </div>
                <div class="col-auto">
                    <div class="form-check form-check-inline mb-0">
                        <input class="form-check-input" type="checkbox" name="unassigned" value="true"
                               id="unassignedFilter" checked="@unassignedFilter" data-action-change="submitOwnForm" />
                        <label class="form-check-label small" for="unassignedFilter">@Localizer["UnassignedOnly"]</label>
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary btn-sm">@Localizer["Filter"]</button>
                    <a asp-action="AllRequests" class="btn btn-outline-secondary btn-sm ms-1">@Localizer["ClearFilter"]</a>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">
                            <a class="text-dark text-decoration-none" asp-action="AllRequests"
                               asp-route-sortOrder="@ViewBag.DocTypeSort"
                               asp-route-status="@ViewBag.StatusFilter"
                               asp-route-documentType="@ViewBag.DocTypeFilter"
                               asp-route-unassigned="@unassignedFilter"
                               asp-route-pageSize="@ViewBag.CurrentPageSize">
                                @Localizer["DocumentType"]
                                @if (ViewBag.CurrentSort == "doctype_asc") { <i class="bi bi-sort-up"></i> }
                                else if (ViewBag.CurrentSort == "doctype_desc") { <i class="bi bi-sort-down"></i> }
                            </a>
                        </th>
                        <th>@Localizer["DocumentId"]</th>
                        <th>@Localizer["Requester"]</th>
                        <th>
                            <a class="text-dark text-decoration-none" asp-action="AllRequests"
                               asp-route-sortOrder="@ViewBag.CreatedSort"
                               asp-route-status="@ViewBag.StatusFilter"
                               asp-route-documentType="@ViewBag.DocTypeFilter"
                               asp-route-unassigned="@unassignedFilter"
                               asp-route-pageSize="@ViewBag.CurrentPageSize">
                                @Localizer["SubmittedAt"]
                                @if (ViewBag.CurrentSort == "created_asc") { <i class="bi bi-sort-up"></i> }
                                else if (string.IsNullOrEmpty(ViewBag.CurrentSort as string) || ViewBag.CurrentSort == "created_desc") { <i class="bi bi-sort-down"></i> }
                            </a>
                        </th>
                        <th>@Localizer["CurrentStep"]</th>
                        <th>
                            <a class="text-dark text-decoration-none" asp-action="AllRequests"
                               asp-route-sortOrder="@ViewBag.StatusSort"
                               asp-route-status="@ViewBag.StatusFilter"
                               asp-route-documentType="@ViewBag.DocTypeFilter"
                               asp-route-unassigned="@unassignedFilter"
                               asp-route-pageSize="@ViewBag.CurrentPageSize">
                                @Localizer["Status"]
                                @if (ViewBag.CurrentSort == "status_asc") { <i class="bi bi-sort-up"></i> }
                                else if (ViewBag.CurrentSort == "status_desc") { <i class="bi bi-sort-down"></i> }
                            </a>
                        </th>
                        <th class="text-end pe-4">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">@Localizer["NoData"]</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model)
                        {
                            var step = stepsMap.GetValueOrDefault(r.CurrentStepId);
                            string statusLabel, statusCss;
                            switch (r.Status)
                            {
                                case ApprovalStatus.Approved:
                                    statusLabel = Localizer["StatusApproved"].Value;
                                    statusCss = "success";
                                    break;
                                case ApprovalStatus.Rejected:
                                    statusLabel = Localizer["StatusRejected"].Value;
                                    statusCss = "danger";
                                    break;
                                case ApprovalStatus.Withdrawn:
                                    statusLabel = Localizer["StatusWithdrawn"].Value;
                                    statusCss = "secondary";
                                    break;
                                case ApprovalStatus.ReturnedForRevision:
                                    statusLabel = Localizer["StatusReturned"].Value;
                                    statusCss = "info text-dark";
                                    break;
                                default:
                                    statusLabel = Localizer["StatusPending"].Value;
                                    statusCss = "warning text-dark";
                                    break;
                            }
                            bool isUnassigned = r.Status == ApprovalStatus.Pending
                                && string.IsNullOrEmpty(r.ActiveApproverId)
                                && step?.ApproverType == ApproverType.Supervisor;
                            <tr>
                                <td class="ps-4"><span class="badge bg-secondary">@DocTypeLabels.Get(r.DocumentType)</span></td>
                                <td>
                                    <button type="button" class="btn btn-link p-0 fw-semibold text-decoration-none"
                                            data-action="openDocDetails" data-doc-type="@r.DocumentType" data-doc-id="@r.DocumentId">
                                        @r.DocumentId
                                    </button>
                                </td>
                                <td>
                                    @(r.RequesterId != null ? requesterNames.GetValueOrDefault(r.RequesterId, r.RequesterId) : "—")
                                </td>
                                <td class="text-muted small">
                                    @DateTimeSvc.ToLocalTime(r.CreatedAt).ToString("yyyy-MM-dd HH:mm")
                                </td>
                                <td>
                                    @if (r.Status == ApprovalStatus.Pending && step != null)
                                    {
                                        <span class="badge bg-light text-dark border">@string.Format(Localizer["StepLabel"].Value, step.Sequence)</span>
                                        @if (isUnassigned)
                                        {
                                            <span class="badge bg-danger ms-1" title="@Localizer["UnassignedHint"]">
                                                <i class="bi bi-person-x"></i> @Localizer["Unassigned"]
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td><span class="badge bg-@statusCss">@statusLabel</span></td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            data-action="openPanel" data-url="@Url.Action("History", "Approval", new { id = r.Id })" data-label="@Localizer["History"]">
                                        <i class="bi bi-clock-history"></i> @Localizer["History"]
                                    </button>
                                    @if (r.Status == ApprovalStatus.Pending && await PermissionService.CanUpdate("AllApprovalRequests"))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning ms-1"
                                                data-url="@Url.Action("ReassignForm", "Approval", new { id = r.Id })"
                                                data-label="@($"{Localizer["ReassignLabel"].Value}：{DocTypeLabels.Get(r.DocumentType)} {r.DocumentId}")"
                                                data-action="openPanel"
                                                title="@Localizer["ReassignApprover"]"><i class="bi bi-person-fill-gear"></i> @Localizer["ReassignApprover"]</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@await Html.PartialAsync("_Pagination", Model)

<!-- Side Panel (Bootstrap Offcanvas) -->
<div class="offcanvas offcanvas-end shadow-lg u-width-min-520px-95vw" id="crudPanel" tabindex="-1"
     aria-labelledby="crudPanelLabel">
    <div class="offcanvas-header border-bottom bg-primary text-white py-3">
        <h5 class="offcanvas-title mb-0" id="crudPanelLabel">
            <i class="bi bi-clock-history me-2"></i><span id="crudPanelTitle"></span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-3" id="crudPanelBody"></div>
</div>

<!-- Success / Error Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i><span id="successToastMsg"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><span id="errorToastMsg"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    // 各模組在此登錄文件類型對應的 Details URL（由各部署專案的 _DocDetailsUrls.cshtml 填入）
    const docDetailsUrls = {};
    @await Html.PartialAsync("_DocDetailsUrls")

    function openDocDetails(e, el) {
        const docType = el.dataset.docType, docId = el.dataset.docId;
        const urlFn = docDetailsUrls[docType];
        if (!urlFn) return;
        openPanel(urlFn(docId), docType + ' ' + docId);
    }

    function openPanel(a, b) {
        const url = (a instanceof Event) ? b.dataset.url : a;
        const title = (a instanceof Event) ? b.dataset.label : b;
        document.getElementById('crudPanelTitle').textContent = title;
        const body = document.getElementById('crudPanelBody');
        body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted small">' + @(Json.Serialize(SL["Loading"].Value)) + '</p></div>';
        new bootstrap.Offcanvas(document.getElementById('crudPanel')).show();
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { if (!r.ok) throw r.status; return r.text(); })
            .then(html => { body.innerHTML = DOMPurify.sanitize(html); bindPanelForms(); })
            .catch(status => {
                const msg = status === 404
                    ? @(Json.Serialize(SL["DocNotFoundMaybeDeleted"].Value))
                    : @(Json.Serialize(SL["LoadFailedRetry"].Value));
                body.innerHTML = `<div class="alert alert-warning m-3"><i class="bi bi-exclamation-triangle me-2"></i>${msg}</div>`;
            });
    }

    function bindPanelForms() {
        document.querySelectorAll('#crudPanelBody form[data-ajax="true"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                submitPanel(this);
            });
        });
    }

    function submitPanel(form) {
        const btn = form.querySelector('[type="submit"]');
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => {
            const ct = r.headers.get('Content-Type') || '';
            return ct.includes('application/json')
                ? r.json().then(d => ({ isJson: true, data: d }))
                : r.text().then(h => ({ isJson: false, html: h }));
        })
        .then(result => {
            if (result.isJson && result.data.success) {
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel')).hide();
                document.getElementById('successToastMsg').textContent = result.data.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else if (result.isJson && !result.data.success) {
                btn.disabled = false; btn.innerHTML = orig;
                document.getElementById('errorToastMsg').textContent = result.data.message;
                new bootstrap.Toast(document.getElementById('errorToast')).show();
            } else {
                document.getElementById('crudPanelBody').innerHTML = DOMPurify.sanitize(result.html);
                bindPanelForms();
            }
        })
        .catch(() => { btn.disabled = false; btn.innerHTML = orig; alert(@(Json.Serialize(SL["OperationFailedRetry"].Value))); });
    }
</script>
}
