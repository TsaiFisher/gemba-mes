@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Models.ApplicationRole>
@using SmartFactory.MES.Services
@inject IPermissionService PermissionService
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.SharedResource> SL

@{
    ViewData["Title"] = Localizer["PermissionSettings"];
    bool hasSearched = ViewBag.Searched == true;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-key"></i> @Localizer["FunctionalPermission"]</h1>
    </div>

    <!-- 搜尋與分頁設定區塊 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control border-end-0" placeholder="@Localizer["SearchPlaceholder"]" value="@ViewBag.SearchTerm" />
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                        {
                            <a asp-action="Index" asp-route-pageSize="@ViewBag.CurrentPageSize" asp-route-searched="true" class="btn btn-outline-secondary border-start-0 border-end-0 bg-white text-muted">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                        @if (await PermissionService.CanPrint("PermissionSettings"))
                        {
                            <button type="button" class="btn btn-outline-info ms-2" data-action="printPage">
                                <i class="bi bi-printer"></i> @Localizer["Print"]
                            </button>
                            <div class="btn-group ms-1">
                                <a asp-action="Export" asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-sortOrder="@ViewBag.CurrentSort" asp-route-format="xlsx"
                                   class="btn btn-outline-success">
                                    <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
                                </a>
                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split"
                                        data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Export" asp-route-searchTerm="@ViewBag.SearchTerm"
                                           asp-route-sortOrder="@ViewBag.CurrentSort" asp-route-format="csv">
                                        <i class="bi bi-filetype-csv me-2"></i>@Localizer["ExportCsv"]</a></li>
                                    <li><a class="dropdown-item" asp-action="Export" asp-route-searchTerm="@ViewBag.SearchTerm"
                                           asp-route-sortOrder="@ViewBag.CurrentSort" asp-route-format="json">
                                        <i class="bi bi-filetype-json me-2"></i>@Localizer["ExportJson"]</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-search fs-1 d-block mb-3 opacity-25"></i>
                <p class="mb-0">@Localizer["SearchFirst"]</p>
            </div>
        </div>
    }
    else
    {

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">
                            <a class="text-dark text-decoration-none" asp-action="Index"
                               asp-route-sortOrder="@ViewBag.NameSort"
                               asp-route-searchTerm="@ViewBag.SearchTerm"
                               asp-route-pageSize="@ViewBag.CurrentPageSize"
                               asp-route-searched="true">
                                @Localizer["RoleName"]
                                @if (string.IsNullOrEmpty(ViewBag.CurrentSort) || ViewBag.CurrentSort == "name_asc") { <i class="bi bi-sort-up"></i> }
                                else if (ViewBag.CurrentSort == "name_desc") { <i class="bi bi-sort-down"></i> }
                            </a>
                        </th>
                        <th>
                            <a class="text-dark text-decoration-none" asp-action="Index"
                               asp-route-sortOrder="@ViewBag.OrgSort"
                               asp-route-searchTerm="@ViewBag.SearchTerm"
                               asp-route-pageSize="@ViewBag.CurrentPageSize"
                               asp-route-searched="true">
                                @Localizer["Organization"]
                                @if (ViewBag.CurrentSort == "org_asc") { <i class="bi bi-sort-up"></i> }
                                else if (ViewBag.CurrentSort == "org_desc") { <i class="bi bi-sort-down"></i> }
                            </a>
                        </th>
                        <th class="text-end pe-4">@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-5 text-muted">@Localizer["NoData"]</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@role.Name</td>
                                <td>@(role.OrganizationUnit?.Name ?? "-")</td>
                                <td class="text-end pe-4">
                                    @if (await PermissionService.CanUpdate("PermissionSettings"))
                                    {
                                        <button type="button" class="btn btn-sm btn-primary"
                                                data-action="openPermissionPanel" data-role-id="@role.Id" data-role-name="@role.Name">
                                            <i class="bi bi-shield-check"></i> @Localizer["SetPermissions"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" disabled>
                                            <i class="bi bi-shield-lock"></i> @Localizer["SetPermissions"]
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 分頁導航 -->
    @await Html.PartialAsync("_Pagination", Model)

    } <!-- end hasSearched -->
</div>

<!-- ── Side Panel（Bootstrap Offcanvas）── -->
<div class="offcanvas offcanvas-end shadow-lg u-width-min-720px-95vw" id="permissionPanel" tabindex="-1"
     aria-labelledby="permissionPanelLabel">
    <div class="offcanvas-header border-bottom bg-primary text-white py-3">
        <h5 class="offcanvas-title mb-0" id="permissionPanelLabel">
            <i class="bi bi-shield-check me-2"></i>
            <span id="permissionPanelRoleName"></span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0" id="permissionPanelBody">
        <!-- 內容由 AJAX 載入 -->
    </div>
</div>

<!-- 成功 Toast 提示 -->
<div class="toast-container position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="permissionSuccessToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i> @Localizer["SaveSettingsSuccess"]
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    function openPermissionPanel(e, el) {
        const roleId = el.dataset.roleId, roleName = el.dataset.roleName;
        document.getElementById('permissionPanelRoleName').textContent = roleName;
        document.getElementById('permissionPanelBody').innerHTML =
            '<div class="text-center py-5">' +
            '<div class="spinner-border text-primary"></div>' +
            '<p class="mt-3 text-muted small">' + @(Json.Serialize(SL["Loading"].Value)) + '</p>' +
            '</div>';

        const offcanvas = new bootstrap.Offcanvas(document.getElementById('permissionPanel'));
        offcanvas.show();

        fetch('/Permission/Edit/' + roleId, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.text();
        })
        .then(html => {
            document.getElementById('permissionPanelBody').innerHTML = DOMPurify.sanitize(html);
            initPermissionPanel();
        })
        .catch(() => {
            document.getElementById('permissionPanelBody').innerHTML =
                '<div class="alert alert-danger m-3">' + @(Json.Serialize(SL["LoadFailedRetry"].Value)) + '</div>';
        });
    }

    function initPermissionPanel() {
        // Toggle module expand/collapse
        document.querySelectorAll('.toggle-module').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var mod = this.dataset.mod;
                var rows = document.querySelectorAll('.' + mod);
                var icon = this.querySelector('i');
                var collapsed = rows[0] && rows[0].style.display === 'none';
                rows.forEach(function (r) { r.style.display = collapsed ? '' : 'none'; });
                icon.classList.toggle('bi-chevron-down', collapsed);
                icon.classList.toggle('bi-chevron-up', !collapsed);
            });
        });
        // Select all / Deselect all per module
        document.querySelectorAll('[data-bulk="select-all"], [data-bulk="deselect-all"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var mod = this.dataset.mod;
                var checked = this.dataset.bulk === 'select-all';
                document.querySelectorAll('tr.' + mod + ' input[type="checkbox"]').forEach(function (cb) {
                    cb.checked = checked;
                });
            });
        });
    }

    function submitPermissionPanel(arg, el) {
        const form = (arg instanceof Event) ? el : arg;
        if (arg instanceof Event) arg.preventDefault();
        const btn = form.querySelector('[type="submit"]');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> ' + @(Json.Serialize(SL["Saving"].Value));

        const formData = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                bootstrap.Offcanvas.getInstance(document.getElementById('permissionPanel')).hide();
                new bootstrap.Toast(document.getElementById('permissionSuccessToast')).show();
            }
        })
        .catch(() => {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-save"></i> ' + @(Json.Serialize(Localizer["SaveSettings"].Value));
            alert(@(Json.Serialize(SL["SaveFailedRetry"].Value)));
        });
    }
</script>
}
