@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Services
@inject IViewLocalizer Localizer
@inject IPermissionService PermissionService
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Models.ApprovalTemplate>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.SharedResource> SL

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var canCreate = await PermissionService.CanCreate("ApprovalTemplateSetting");
    var canUpdate = await PermissionService.CanUpdate("ApprovalTemplateSetting");
    var canDelete = await PermissionService.CanDelete("ApprovalTemplateSetting");
    var canPrint  = await PermissionService.CanPrint("ApprovalTemplateSetting");
    bool hasSearched = ViewBag.Searched == true;

    Func<string, string> sortIcon = col => {
        var cur = ViewBag.CurrentSort as string ?? "";
        if (cur == col + "_asc")  return "bi-sort-up";
        if (cur == col + "_desc") return "bi-sort-down";
        return "bi-arrow-down-up opacity-25";
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-diagram-2"></i> @Localizer["PageTitle"]</h1>
        @if (canCreate)
        {
            <button type="button" class="btn btn-primary"
                    data-action="openPanel" data-url="@Url.Action("Create", "ApprovalTemplate")" data-label="@Localizer["AddTemplate"]">
                <i class="bi bi-plus-lg"></i> @Localizer["AddTemplate"]
            </button>
        }
    </div>

    <!-- 搜尋區塊 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-center">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control border-end-0"
                               placeholder="@Localizer["SearchPlaceholder"]" value="@ViewBag.SearchTerm" />
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                        {
                            <a asp-action="Index" asp-route-searched="true" asp-route-pageSize="@ViewBag.CurrentPageSize"
                               class="btn btn-outline-secondary border-start-0 border-end-0 bg-white text-muted">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                        @if (canPrint)
                        {
                            <button type="button" class="btn btn-outline-info ms-2" data-action="printPage">
                                <i class="bi bi-printer"></i> @Localizer["Print"]
                            </button>
                            <div class="btn-group ms-1">
                                <a asp-action="Export"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-sortOrder="@ViewBag.CurrentSort"
                                   asp-route-format="xlsx"
                                   class="btn btn-outline-success">
                                    <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
                                </a>
                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split"
                                        data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm"
                                           asp-route-sortOrder="@ViewBag.CurrentSort"
                                           asp-route-format="csv">
                                        <i class="bi bi-filetype-csv me-2"></i>@Localizer["ExportCsv"]</a></li>
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm"
                                           asp-route-sortOrder="@ViewBag.CurrentSort"
                                           asp-route-format="json">
                                        <i class="bi bi-filetype-json me-2"></i>@Localizer["ExportJson"]</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-search fs-1 d-block mb-3 opacity-25"></i>
                <p class="mb-0">@Localizer["SearchPrompt"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">
                                <a asp-action="Index" asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-searched="true" asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-sortOrder="@ViewBag.NameSort" class="text-decoration-none text-dark">
                                    @Localizer["TemplateName"] <i class="bi @sortIcon("name")"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-searched="true" asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-sortOrder="@ViewBag.DocTypeSort" class="text-decoration-none text-dark">
                                    @Localizer["DocumentType"] <i class="bi @sortIcon("doctype")"></i>
                                </a>
                            </th>
                            <th class="text-center">@Localizer["StepCount"]</th>
                            <th class="text-end pe-4">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5 text-muted">@Localizer["NoData"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var t in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@t.Name</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(t.TargetDocumentType))
                                        {
                                            <span class="badge bg-secondary">@t.TargetDocumentType</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@t.Steps.Count</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-info"
                                                    data-url="@Url.Action("Details", "ApprovalTemplate", new { id = t.Id })"
                                                    data-label="@($"{Localizer["Steps"].Value}：{t.Name}")"
                                                    data-action="openPanel">
                                                <i class="bi bi-list-ol"></i> @Localizer["Steps"]
                                            </button>
                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        data-url="@Url.Action("Edit", "ApprovalTemplate", new { id = t.Id })"
                                                        data-label="@($"{Localizer["Edit"].Value}：{t.Name}")"
                                                        data-action="openPanel"><i class="bi bi-pencil"></i> @Localizer["Edit"]</button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-url="@Url.Action("Delete", "ApprovalTemplate", new { id = t.Id })"
                                                        data-label="@t.Name"
                                                        data-action="deleteItem"><i class="bi bi-trash"></i> @Localizer["Delete"]</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", Model)
        </div>
    }
</div>

<!-- Side Panel (Bootstrap Offcanvas) -->
<div class="offcanvas offcanvas-end shadow-lg u-width-min-560px-95vw" id="crudPanel" tabindex="-1"
     aria-labelledby="crudPanelLabel">
    <div class="offcanvas-header border-bottom bg-primary text-white py-3">
        <h5 class="offcanvas-title mb-0" id="crudPanelLabel">
            <i class="bi bi-diagram-2 me-2"></i><span id="crudPanelTitle"></span>
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-3" id="crudPanelBody"></div>
</div>

<!-- Success Toast -->
<div class="toast-container position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-check-circle-fill me-2"></i><span id="successToastMsg"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
    <div id="errorToast" class="toast align-items-center text-white bg-danger border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body">
                <i class="bi bi-exclamation-triangle-fill me-2"></i><span id="errorToastMsg"></span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- Anti-Forgery token for AJAX DELETE -->
<form class="u-display-none" id="__AjaxAntiForgery">@Html.AntiForgeryToken()</form>

<!-- 修改步驟 Modal -->
<div class="modal fade" id="editStepModal" tabindex="-1" aria-labelledby="editStepModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editStepModalLabel"><i class="bi bi-pencil me-2"></i>@Localizer["EditStep"]</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editStepForm">
                <div class="modal-body">
                    <input type="hidden" id="editStepId" name="id" />
                    <input type="hidden" id="editTemplateId" name="templateId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@Localizer["ApproverType"] <span class="text-danger">*</span></label>
                        <select id="editApproverType" name="approverType" class="form-select"></select>
                    </div>
                    <div class="mb-3 u-display-none" id="editTargetRoleDiv">
                        <label class="form-label fw-semibold">@Localizer["Role"]</label>
                        <select id="editTargetRoleId" name="targetRoleId" class="form-select"></select>
                    </div>
                    <div class="mb-3 u-display-none" id="editTargetUserDiv">
                        <label class="form-label fw-semibold">@Localizer["User"]</label>
                        <select id="editTargetUserId" name="targetUserId" class="form-select"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Cancel"]</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>@Localizer["Save"]</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    let currentPanelUrl = '', currentPanelTitle = '';

    function openPanel(a, b) {
        const url = (a instanceof Event) ? b.dataset.url : a;
        const title = (a instanceof Event) ? b.dataset.label : b;
        currentPanelUrl = url;
        currentPanelTitle = title;
        document.getElementById('crudPanelTitle').textContent = title;
        const body = document.getElementById('crudPanelBody');
        body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted small">' + @(Json.Serialize(SL["Loading"].Value)) + '</p></div>';
        new bootstrap.Offcanvas(document.getElementById('crudPanel')).show();
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(html => { body.innerHTML = DOMPurify.sanitize(html); bindPanelForms(); })
            .catch(() => { body.innerHTML = '<div class="alert alert-danger m-3">' + @(Json.Serialize(SL["LoadFailedRetry"].Value)) + '</div>'; });
    }

    function closePanel() {
        bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel'))?.hide();
    }

    // 只更新面板內容，不重新顯示 offcanvas（避免閃爍）
    function reloadPanelContent() {
        const body = document.getElementById('crudPanelBody');
        body.innerHTML = '<div class="text-center py-3"><div class="spinner-border text-primary"></div></div>';
        fetch(currentPanelUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(html => { body.innerHTML = DOMPurify.sanitize(html); bindPanelForms(); })
            .catch(() => { body.innerHTML = '<div class="alert alert-danger m-3">' + @(Json.Serialize(SL["LoadFailedRetry"].Value)) + '</div>'; });
    }

    function bindPanelForms() {
        document.querySelectorAll('#crudPanelBody form[data-ajax="true"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                submitPanel(this);
            });
        });

        // 簽核者類型切換（DOMPurify 會移除 onchange，改用事件委派）
        const approverTypeSelect = document.querySelector('#crudPanelBody #approverType');
        if (approverTypeSelect) {
            approverTypeSelect.addEventListener('change', function() {
                toggleApproverTarget(this.value);
            });
        }

        // 刪除步驟按鈕（DOMPurify 會移除 onclick，改用資料屬性）
        document.querySelectorAll('#crudPanelBody [data-delete-step-url]').forEach(btn => {
            btn.addEventListener('click', function() {
                deleteStep(this.dataset.deleteStepUrl, this.dataset.confirmMsg);
            });
        });

        // 修改步驟按鈕
        document.querySelectorAll('#crudPanelBody [data-edit-step]').forEach(btn => {
            btn.addEventListener('click', function() {
                openEditStepModal(this.dataset);
            });
        });
    }

    function submitPanel(arg, el) {
        const form = (arg instanceof Event) ? el : arg;
        if (arg instanceof Event) arg.preventDefault();
        const doReloadPanel = form.dataset.reloadPanel === 'true';
        const btn = form.querySelector('[type="submit"]');
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => {
            const ct = r.headers.get('Content-Type') || '';
            return ct.includes('application/json')
                ? r.json().then(d => ({ isJson: true, data: d }))
                : r.text().then(h => ({ isJson: false, html: h }));
        })
        .then(result => {
            if (result.isJson && result.data.success) {
                if (doReloadPanel) {
                    // 步驟操作成功：只更新面板內容，不重新觸發 offcanvas 動畫
                    reloadPanelContent();
                } else {
                    // 模板 CRUD 成功：關閉面板並重整頁面
                    bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel')).hide();
                    document.getElementById('successToastMsg').textContent = result.data.message;
                    new bootstrap.Toast(document.getElementById('successToast')).show();
                    setTimeout(() => location.reload(), 1200);
                }
            } else if (result.isJson && !result.data.success) {
                btn.disabled = false;
                btn.innerHTML = orig;
                document.getElementById('errorToastMsg').textContent = result.data.message;
                new bootstrap.Toast(document.getElementById('errorToast')).show();
            } else {
                document.getElementById('crudPanelBody').innerHTML = DOMPurify.sanitize(result.html);
                bindPanelForms();
            }
        })
        .catch(() => {
            btn.disabled = false;
            btn.innerHTML = orig;
            alert(@(Json.Serialize(SL["SaveFailedRetry"].Value)));
        });
    }

    // 刪除模板（成功後重整頁面）
    function deleteItem(e, el) {
        const url = el.dataset.url, name = el.dataset.label;
        if (!confirm('@Html.Raw(Localizer["ConfirmDelete"].Value)「' + name + '」？')) return;
        const token = document.querySelector('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').value;
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                document.getElementById('successToastMsg').textContent = result.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else {
                document.getElementById('errorToastMsg').textContent = result.message;
                new bootstrap.Toast(document.getElementById('errorToast')).show();
            }
        })
        .catch(() => alert(@(Json.Serialize(SL["DeleteFailedRetry"].Value))));
    }

    // 刪除步驟（成功後只更新面板內容）
    function deleteStep(url, name) {
        if (!confirm('@Html.Raw(Localizer["ConfirmDelete"].Value)「' + name + '」？')) return;
        const token = document.querySelector('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').value;
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) reloadPanelContent();
            else alert(result.message || @(Json.Serialize(SL["DeleteFailedRetry"].Value)));
        })
        .catch(() => alert(@(Json.Serialize(SL["DeleteFailedRetry"].Value))));
    }

    // 簽核者類型顯示切換（新增步驟用）
    function toggleApproverTarget(val) {
        const roleDiv = document.getElementById('targetRoleDiv');
        const userDiv = document.getElementById('targetUserDiv');
        if (roleDiv) roleDiv.classList.toggle('u-display-none', val !== '@((int)SmartFactory.MES.Models.ApproverType.Role)');
        if (userDiv) userDiv.classList.toggle('u-display-none', val !== '@((int)SmartFactory.MES.Models.ApproverType.User)');
    }

    // 簽核者類型顯示切換（修改步驟 modal 用）
    function toggleEditApproverTarget(val) {
        const roleVal = '@((int)SmartFactory.MES.Models.ApproverType.Role)';
        const userVal = '@((int)SmartFactory.MES.Models.ApproverType.User)';
        document.getElementById('editTargetRoleDiv').classList.toggle('u-display-none', val !== roleVal);
        document.getElementById('editTargetUserDiv').classList.toggle('u-display-none', val !== userVal);
    }

    // 開啟修改步驟 modal，從 offcanvas 中複製選單選項
    function openEditStepModal(data) {
        document.getElementById('editStepId').value = data.stepId;
        document.getElementById('editTemplateId').value = data.templateId;

        // 複製「簽核者類型」選項
        const srcApprover = document.querySelector('#crudPanelBody #approverType');
        const editApprover = document.getElementById('editApproverType');
        if (srcApprover) editApprover.innerHTML = srcApprover.innerHTML;
        editApprover.value = data.approverType;
        editApprover.onchange = function() { toggleEditApproverTarget(this.value); };

        // 複製「角色」選項
        const srcRoles = document.querySelector('#crudPanelBody #targetRoleDiv select');
        const editRoles = document.getElementById('editTargetRoleId');
        if (srcRoles) editRoles.innerHTML = srcRoles.innerHTML;
        if (data.targetRoleId) editRoles.value = data.targetRoleId;

        // 複製「使用者」選項
        const srcUsers = document.querySelector('#crudPanelBody #targetUserDiv select');
        const editUsers = document.getElementById('editTargetUserId');
        if (srcUsers) editUsers.innerHTML = srcUsers.innerHTML;
        if (data.targetUserId) editUsers.value = data.targetUserId;

        toggleEditApproverTarget(data.approverType);

        new bootstrap.Modal(document.getElementById('editStepModal')).show();
    }

    // 修改步驟 modal 表單送出
    document.getElementById('editStepForm').addEventListener('submit', function(e) {
        e.preventDefault();
        const btn = this.querySelector('[type="submit"]');
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';

        const token = document.querySelector('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').value;
        const params = new URLSearchParams(new FormData(this));
        params.set('__RequestVerificationToken', token);

        fetch('@Url.Action("EditStep", "ApprovalTemplate")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: params.toString()
        })
        .then(r => r.json())
        .then(result => {
            btn.disabled = false;
            btn.innerHTML = orig;
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editStepModal')).hide();
                reloadPanelContent();
            } else {
                alert(result.message || @(Json.Serialize(SL["UpdateFailedRetry"].Value)));
            }
        })
        .catch(() => {
            btn.disabled = false;
            btn.innerHTML = orig;
            alert(@(Json.Serialize(SL["UpdateFailedRetry"].Value)));
        });
    });
</script>
}
