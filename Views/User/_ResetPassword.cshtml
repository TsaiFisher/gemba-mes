@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.ApplicationUser
@*
    重設密碼面板（UserController.ResetPassword）。同一個檢視三種狀態：
    確認前（說明＋確認鈕）、成功（顯示臨時密碼，只這一次）、失敗（原因）。
    臨時密碼留在面板上而不是用提示訊息帶：提示幾秒就消失，管理員來不及抄。
*@
@{
    var password = ViewBag.TemporaryPassword as string;
    var errors = ViewBag.Errors as List<string> ?? new List<string>();
}

@if (password != null)
{
    <div class="p-4">
        <div class="alert alert-success mb-3"><i class="bi bi-check-circle-fill me-1"></i>@Localizer["DoneTitle", Model.UserName ?? ""]</div>
        <label class="form-label fw-bold">@Localizer["TemporaryPassword"]</label>
        <div class="border rounded p-3 bg-light text-center mb-3">
            <code class="fs-4 user-select-all" id="temporaryPassword">@password</code>
        </div>
        <ul class="small text-muted mb-0">
            <li>@Localizer["DoneShownOnce"]</li>
            <li>@Localizer["DoneMustChange"]</li>
            <li>@Localizer["DoneUnlocked"]</li>
        </ul>
    </div>
    <div class="p-3 border-top bg-light d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-primary px-4" data-dismiss-panel>@Localizer["Close"]</button>
    </div>
}
else
{
    <form id="panelForm" action="@Url.Action("ResetPassword", "User", new { id = Model.Id })" method="post" data-ajax="true">
        @Html.AntiForgeryToken()
        <div class="p-4">
            @if (errors.Count > 0)
            {
                <div class="alert alert-danger py-2 mb-3">
                    @foreach (var error in errors)
                    {
                        <div>@error</div>
                    }
                </div>
            }
            <p class="fw-bold mb-2">@Localizer["ConfirmTitle", Model.UserName ?? ""]</p>
            <ul class="small text-muted mb-0">
                <li>@Localizer["ConfirmGenerated"]</li>
                <li>@Localizer["ConfirmOldInvalid"]</li>
                <li>@Localizer["ConfirmTwoFactorKept"]</li>
            </ul>
        </div>
        <div class="p-3 border-top bg-light d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" data-dismiss-panel>@Localizer["Cancel"]</button>
            <button type="submit" class="btn btn-warning px-4">
                <i class="bi bi-key"></i> @Localizer["ResetPassword"]
            </button>
        </div>
    </form>
}
