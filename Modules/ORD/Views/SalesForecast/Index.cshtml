@using SmartFactory.MES.Modules.BAS.Services
@inject SmartFactory.MES.Modules.BAS.Services.IDisplayPrecision Precision
@using SmartFactory.MES.Services
@model List<SmartFactory.MES.Modules.ORD.ViewModels.SalesForecastRowVm>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    var moneyFmt         = await Precision.BaseMoneyFormatAsync();
    ViewData["Title"] = L["PageTitle"].Value;
    bool searched       = ViewBag.Searched == true;
    bool canPrint       = ViewBag.CanPrint == true;
    int forecastMonths  = (int)(ViewBag.ForecastMonths ?? 3);
    var rows            = Model ?? new();
    var actualRows      = rows.Where(r => !r.IsForecast).ToList();
    var forecastRows    = rows.Where(r => r.IsForecast).ToList();
    var products        = rows.Select(r => r.ProductCode).Distinct().OrderBy(x => x).ToList();
    string curProduct   = ViewBag.SearchProduct as string ?? "";
    var productOptions  = ViewBag.ProductOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="container-fluid py-3">
    <h4 class="mb-3">@L["PageTitle"]</h4>

    <form method="get" asp-action="Index" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@L["Product"]</label>
                <select name="searchProduct" class="form-select form-select-sm select2-enable w-100"
                        data-placeholder="@L["AllProducts"]" data-allow-clear="true">
                    <option value=""></option>
                    @foreach (var p in productOptions)
                    {
                        <option value="@p.ProductCode" selected="@(curProduct == (string)p.ProductCode)">@p.ProductCode — @p.ProductName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["ForecastMonths"]</label>
                <select name="forecastMonths" class="form-select">
                    <option value="3" selected="@(forecastMonths == 3)">3</option>
                    <option value="6" selected="@(forecastMonths == 6)">6</option>
                    <option value="12" selected="@(forecastMonths == 12)">12</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" name="searched" value="true" class="btn btn-primary w-100 px-4">
                    <i class="bi bi-search"></i> @L["Search"]
                </button>
            </div>
        </div>
    @await Html.PartialAsync("_PageSizeSelect")
    </form>

    @if (!searched)
    {
        <div class="alert alert-info">@L["SearchFirst"]</div>
    }
    else if (!rows.Any())
    {
        <div class="alert alert-warning">@L["NoData"]</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong>@L["ResultTitle"]</strong>
            @if (canPrint)
            {
                <a asp-action="Export"
                   asp-route-searchProduct="@ViewBag.SearchProduct" asp-route-forecastMonths="@forecastMonths"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> @L["ExportExcel"]
                </a>
            }
        </div>

        @foreach (var pc in products)
        {
            var pcRows = rows.Where(r => r.ProductCode == pc).OrderBy(r => r.Year).ThenBy(r => r.Month).ToList();
            <h6 class="mt-3 mb-1">@pc</h6>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-hover table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>@L["YearMonth"]</th>
                            <th class="text-end">@L["Actual"]</th>
                            <th class="text-end">@L["MovingAvg"]</th>
                            <th class="text-end">@L["SeasonalIndex"]</th>
                            <th class="text-end">@L["ForecastAmount"]</th>
                            <th>@L["Type"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var paged = ReportPaging.Page(pcRows, ViewData, Context); }
                        @foreach (var r in paged)
                        {
                            <tr class="@(r.IsForecast ? "table-warning" : "")">
                                <td>@r.YearMonth</td>
                                <td class="text-end">@(r.IsForecast ? "—" : r.ActualAmount.ToString(moneyFmt))</td>
                                <td class="text-end text-muted">@(r.MovingAvg?.ToString(moneyFmt) ?? "—")</td>
                                <td class="text-end">@(r.SeasonalIndex?.ToString("N2") ?? "—")</td>
                                <td class="text-end">
                                    @if (r.IsForecast)
                                    {
                                        <span class="text-warning fw-bold">@(r.ForecastAmount?.ToString(moneyFmt) ?? "—")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (r.IsForecast)
                                    {
                                        <span class="badge bg-warning text-dark">@L["ForecastLabel"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@L["ActualLabel"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @await Html.PartialAsync("_Pagination", paged)
        }
        <div class="text-muted small">@L["MethodNote"]</div>
    }
</div>
