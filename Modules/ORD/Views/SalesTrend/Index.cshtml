@using SmartFactory.MES.Modules.BAS.Services
@inject SmartFactory.MES.Modules.BAS.Services.IDisplayPrecision Precision
@using SmartFactory.MES.Services
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model List<SmartFactory.MES.Modules.ORD.ViewModels.SalesTrendRowVm>

@{
    var moneyFmt         = await Precision.BaseMoneyFormatAsync();
    ViewData["Title"] = Localizer["PageTitle"].Value;
    bool hasSearched = ViewBag.Searched as bool? ?? false;
    bool canPrint    = ViewBag.CanPrint == true;
    int  year        = ViewBag.Year as int? ?? DateTime.Today.Year;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-graph-up me-2 text-success"></i>@Localizer["PageTitle"]</h1>
        @if (canPrint && hasSearched && Model != null && Model.Any())
        {
            <a asp-action="Export" asp-route-year="@year" class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
            </a>
        }
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["Year"]</label>
                    <input type="number" name="year" class="form-control" value="@year" min="2000" max="2099" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                </div>
            @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchFirst"]
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-success text-center"><i class="bi bi-check-circle me-1"></i>@Localizer["NoData"]</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">@Localizer["ResultTitle", year]</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Localizer["YearMonth"]</th>
                                <th class="text-end">@Localizer["Amount"]</th>
                                <th class="text-end">@Localizer["PrevMonth"]</th>
                                <th class="text-end">@Localizer["MoM"]</th>
                                <th class="text-end">@Localizer["SameMonthLY"]</th>
                                <th class="text-end">@Localizer["YoY"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var paged = ReportPaging.Page(Model, ViewData, Context); }
                            @foreach (var row in paged)
                            {
                                <tr>
                                    <td class="fw-semibold">@row.YearMonth</td>
                                    <td class="text-end">@row.Amount.ToString(moneyFmt)</td>
                                    <td class="text-end text-muted">@(row.PrevMonthAmount.HasValue ? row.PrevMonthAmount.Value.ToString(moneyFmt) : "-")</td>
                                    <td class="text-end @(row.MomPct > 0 ? "text-success" : row.MomPct < 0 ? "text-danger" : "")">
                                        @(row.MomPct.HasValue ? $"{row.MomPct:+0.00;-0.00}%" : "-")
                                    </td>
                                    <td class="text-end text-muted">@(row.SameMonthLastYearAmount.HasValue ? row.SameMonthLastYearAmount.Value.ToString(moneyFmt) : "-")</td>
                                    <td class="text-end @(row.YoyPct > 0 ? "text-success" : row.YoyPct < 0 ? "text-danger" : "")">
                                        @(row.YoyPct.HasValue ? $"{row.YoyPct:+0.00;-0.00}%" : "-")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold">
                            <tr>
                                <td>@Localizer["Total"]</td>
                                <td class="text-end">@Model.Sum(r => r.Amount).ToString(moneyFmt)</td>
                                <td colspan="4"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            @await Html.PartialAsync("_Pagination", paged)
        </div>
    }
</div>
