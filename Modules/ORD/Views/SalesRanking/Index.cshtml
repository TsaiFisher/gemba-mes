@using SmartFactory.MES.Modules.BAS.Services
@inject SmartFactory.MES.Modules.BAS.Services.IDisplayPrecision Precision
@using SmartFactory.MES.Services
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model List<SmartFactory.MES.Modules.ORD.ViewModels.SalesRankingRowVm>

@{
    var moneyFmt         = await Precision.BaseMoneyFormatAsync();
    ViewData["Title"] = Localizer["PageTitle"].Value;
    bool   hasSearched = ViewBag.Searched as bool? ?? false;
    bool   canPrint    = ViewBag.CanPrint == true;
    string fromDate    = ViewBag.FromDate as string ?? "";
    string toDate      = ViewBag.ToDate   as string ?? "";
    string groupBy     = ViewBag.GroupBy  as string ?? "Customer";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-bar-chart-line me-2 text-primary"></i>@Localizer["PageTitle"]</h1>
        @if (canPrint && hasSearched && Model != null && Model.Any())
        {
            <a asp-action="Export" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-groupBy="@groupBy"
               class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
            </a>
        }
    </div>

    @* 常用查詢入口（§7.9-6）。放在查詢卡片之外——partial 內有按鈕與輸入框，
       塞進下面那張卡的 <form> 內會變成巢狀表單。 *@
    @await Html.PartialAsync("_SavedQueries", "SalesRanking")

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["FromDate"]</label>
                    <input type="date" name="fromDate" class="form-control" value="@fromDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["ToDate"]</label>
                    <input type="date" name="toDate" class="form-control" value="@toDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["GroupBy"]</label>
                    <select name="groupBy" class="form-select">
                        <option value="Customer" selected="@(groupBy == "Customer")">@Localizer["ByCustomer"]</option>
                        <option value="Product"  selected="@(groupBy == "Product")">@Localizer["ByProduct"]</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                </div>
            @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchFirst"]
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-success text-center"><i class="bi bi-check-circle me-1"></i>@Localizer["NoData"]</div>
    }
    else
    {
        var groupLabel = groupBy == "Product" ? Localizer["ProductCode"].Value : Localizer["CustomerCode"].Value;
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-semibold">@Localizer["ResultTitle"] (@Model.Count @Localizer["Items"])</span>
                <span class="badge bg-primary">@Localizer["TotalAmount"]：@Model.Sum(r => r.TotalAmount).ToString(moneyFmt)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="text-center u-width-60px">@Localizer["Rank"]</th>
                                <th>@groupLabel</th>
                                <th class="text-end">@Localizer["TotalAmount"]</th>
                                <th class="text-center">@Localizer["OrderCount"]</th>
                                <th class="text-center">@Localizer["LineCount"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var paged = ReportPaging.Page(Model, ViewData, Context); }
                            @foreach (var row in paged)
                            {
                                <tr>
                                    <td class="text-center fw-bold">@row.Rank</td>
                                    <td class="fw-semibold">@row.GroupKey</td>
                                    <td class="text-end">@row.TotalAmount.ToString(moneyFmt)</td>
                                    <td class="text-center">@row.OrderCount</td>
                                    <td class="text-center">@row.LineCount</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @await Html.PartialAsync("_Pagination", paged)
        </div>
    }
</div>
