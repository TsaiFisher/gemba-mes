@model SmartFactory.MES.Modules.ORD.Models.InternalOrder
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> L
@inject SmartFactory.MES.Modules._Shared.Printing.PrintNameService PrintNameSvc
@{
    var names = await PrintNameSvc.ForAsync(Model);
    Layout = "~/Views/Shared/_PrintLayoutZ.cshtml";
    var userNames = ViewBag.UserNames as Dictionary<string, string> ?? new Dictionary<string, string>();
    string UserDisplay(string? id) => id != null && userNames.TryGetValue(id, out var n) ? n : (id ?? "");
    var docTitle = Model.TypeCode == "NR" ? Localizer["DocTitle_NR"].Value : Localizer["DocTitle_NI"].Value;
    ViewData["Title"] = docTitle;
}

<div class="print-header">
    <div class="print-qr">@Html.Raw(ViewBag.QrSvg)</div>
    <div class="print-title-block">
        <div class="print-title">SmartFactory MES</div>
        <div class="print-subtitle">@docTitle</div>
        <div class="print-doc-number">@Localizer["DocNo"]：@Model.InternalOrderId ／ @Localizer["DocDate"]：@Model.OrderDate.ToString("yyyy-MM-dd")</div>
    </div>
</div>

<div class="print-section">
    <div class="print-section-title">@L["Print_BasicInfo"]</div>
    <div class="print-field-grid">
        <div class="print-field-label">@Localizer["TypeCode"]</div>
        <div class="print-field-value">@names.TxTypeWith(Model.TypeCode)</div>
        <div class="print-field-label">@Localizer["Department"]</div>
        <div class="print-field-value">@((string?)ViewBag.DepartmentName ?? Model.DepartmentCode)</div>
        <div class="print-field-label">@Localizer["Status"]</div>
        <div class="print-field-value">@SmartFactory.MES.Modules._Shared.DocEnumDisplay.Text(L, Model.Status)</div>
        <div class="print-field-label">@Localizer["CreatedBy"]</div>
        <div class="print-field-value">@UserDisplay(Model.CreatedBy)</div>
        @if (!string.IsNullOrEmpty(Model.Remarks))
        {
            <div class="print-field-label">@Localizer["Remarks"]</div>
            <div class="print-field-value">@Model.Remarks</div>
        }
    </div>
</div>

<div class="print-section">
    <div class="print-section-title">@L["Print_Details"]</div>
    <table class="print-table">
        <thead>
            <tr>
                <th>@Localizer["ColNo"]</th>
                <th>@Localizer["ProductCode"]</th>
                <th>@L["Print_ProductName"]</th>
                <th>@Localizer["DeliveryDate"]</th>
                <th class="text-end">@Localizer["OrderQty"]</th>
                <th>@Localizer["Uom"]</th>
                <th>@Localizer["WhCode"]</th>
                <th>@Localizer["LocationCode"]</th>
                <th>@Localizer["LotNo"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
            {
                <tr>
                    <td>@l.LineNo</td>
                    <td>@l.ProductCode</td>
                    <td>@names.Product(l.ProductCode)</td>
                    <td>@(l.DeliveryDate?.ToString("yyyy-MM-dd") ?? "")</td>
                    <td class="text-end">@l.OrderQty</td>
                    <td>@names.UomWith(l.UomCode)</td>
                    <td>@names.WarehouseWith(l.WhCode)</td>
                    <td>@names.LocationWith(l.LocationCode)</td>
                    <td>@l.LotNo</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_PrintBase")
