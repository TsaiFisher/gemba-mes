@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Models
@using SmartFactory.MES.Modules.BAS.Services
@using SmartFactory.MES.Modules.INV.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Modules.INV.ViewModels.OutsourceMaterialDocFormVm
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL

@{
    bool isNew      = string.IsNullOrEmpty(Model?.OutsourceMaterialDocId);
    bool isReadOnly = ViewBag.IsReadOnly == true;
    var products    = ViewBag.ProductOptions   as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var uoms        = ViewBag.UomOptions       as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var suppliers   = ViewBag.SupplierOptions  as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var uomDecimals = ViewBag.UomDecimals as IReadOnlyDictionary<string, int>;
    int baseDp = ViewBag.BaseCurrencyDp as int? ?? 2;
    string moneyStep = baseDp <= 0 ? "1" : "0." + new string('0', baseDp - 1) + "1";
    var transactionTypesJson = System.Text.Json.JsonSerializer.Serialize(ViewBag.TransactionTypes ?? new object[0]);
    var opoOptions      = ViewBag.OpoOptions      as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var dispatchOptions = ViewBag.DispatchOptions as IList<string>        ?? new List<string>();
}

<form id="outsourceForm" asp-action="Save" asp-controller="OutsourceMaterial" method="post"
      data-action-submit="submitPanel">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="OutsourceMaterialDocId" />
    <input type="hidden" asp-for="CreatedBy" />
    <input type="hidden" asp-for="ApprovalStatus" />

    <fieldset @(isReadOnly ? "disabled=\"disabled\"" : "")>
    <div class="p-3">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 @(ViewContext.ModelState.ErrorCount > 0 ? "" : "d-none")"></div>
        <div class="row g-3 mb-3">
            @if (!isNew)
            {
                <div class="col-12 col-md-4">
                    <label class="form-label fw-semibold">@Localizer["OutsourceMaterialDocId"]</label>
                    <div class="form-control-plaintext fw-bold text-primary">@Model!.OutsourceMaterialDocId</div>
                </div>
            }
            <div class="col-12 col-md-2">
                <label asp-for="TypeCode" class="form-label fw-semibold">@Localizer["TypeCode"]</label>
                <span asp-validation-for="TypeCode" class="text-danger small"></span>
                <select asp-for="TypeCode" id="TypeCode" class="form-select" data-action-change="onTypeCodeChange">
                    <option value="OO" selected="@(Model?.TypeCode == "OO")">OO — @Localizer["TypeOO"]</option>
                    <option value="OR" selected="@(Model?.TypeCode == "OR")">OR — @Localizer["TypeOR"]</option>
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="IssueDate" class="form-label fw-semibold">@Localizer["IssueDate"]</label>
                <input asp-for="IssueDate" type="date" class="form-control" />
                <span asp-validation-for="IssueDate" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="SupplierCode" class="form-label fw-semibold">@Localizer["SupplierCode"]</label>
                <select asp-for="SupplierCode" id="SupplierCodeSelect" class="form-select select2-enable" data-action-change="onEntityCodeChange">
                    <option value="">-- @Localizer["SelectSupplier"] --</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.CompanyCode" selected="@(Model?.SupplierCode == (string)s.CompanyCode)">@s.CompanyCode — @s.CompanyName</option>
                    }
                </select>
                <span asp-validation-for="SupplierCode" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="WorkOrderCode" class="form-label fw-semibold">@Localizer["WorkOrderCode"]</label>
                <span asp-validation-for="WorkOrderCode" class="text-danger small"></span>
                <input asp-for="WorkOrderCode" class="form-control" maxlength="30" placeholder="@Localizer["WorkOrderCodePlaceholder"]" />
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="OutsourcePurchaseOrderId" class="form-label fw-semibold">@Localizer["OutsourcePurchaseOrderId"]</label>
                <select asp-for="OutsourcePurchaseOrderId" class="form-select select2-enable"
                        data-placeholder="@Localizer["OptionalSelect"]" data-allow-clear="true">
                    <option value=""></option>
                    @foreach (var o in opoOptions)
                    {
                        <option value="@o.OutsourcePurchaseOrderId" selected="@(Model?.OutsourcePurchaseOrderId == (string)o.OutsourcePurchaseOrderId)">@o.OutsourcePurchaseOrderId — @o.SupplierCode</option>
                    }
                </select>
                <span asp-validation-for="OutsourcePurchaseOrderId" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-3">
                <label asp-for="DispatchId" class="form-label fw-semibold">@Localizer["DispatchId"]</label>
                <select asp-for="DispatchId" class="form-select select2-enable"
                        data-placeholder="@Localizer["OptionalSelect"]" data-allow-clear="true">
                    <option value=""></option>
                    @foreach (var d in dispatchOptions)
                    {
                        <option value="@d" selected="@(Model?.DispatchId == d)">@d</option>
                    }
                </select>
                <span asp-validation-for="DispatchId" class="text-danger small"></span>
            </div>
            <div class="col-12 col-md-6">
                <label asp-for="Remarks" class="form-label fw-semibold">@Localizer["Remarks"]</label>
                <span asp-validation-for="Remarks" class="text-danger small"></span>
                <input asp-for="Remarks" class="form-control" maxlength="500" />
            </div>
        </div>

        <hr />

        <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0"><i class="bi bi-list-ul me-1"></i>@Localizer["LinesTitle"]</h6>
            @if (!isReadOnly)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="addLine">
                    <i class="bi bi-plus-lg"></i> @Localizer["AddLine"]
                </button>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-bordered" id="linesTable">
                <thead class="table-light">
                    <tr>
                        <th class="u-width-40px">#</th>
                        <th class="u-min-width-240px">@Localizer["ProductCode"]</th>
                        <th class="source-col d-none u-col-code">@Localizer["SourceDoc"]</th>
                        <th class="text-end u-col-num">@Localizer["Qty"]</th>
                        <th class="u-col-tiny">@Localizer["UomCode"]</th>
                        <th class="text-end d-none u-col-num">@Localizer["UnitPrice"]</th>
                        <th class="text-end u-col-num">@Localizer["QtyPutAway"]</th>
                        <th class="u-col-soft">@Localizer["Remarks"]</th>
                        @if (!isReadOnly) { <th class="u-width-40px"></th> }
                    </tr>
                </thead>
                <tbody id="linesTbody">
                    @for (int i = 0; i < (Model?.Lines.Count ?? 0); i++)
                    {
                        var line = Model!.Lines[i];
                        <tr>
                            <td class="text-center text-muted small">@(i+1)</td>
                            <td>
                                <input type="hidden" name="Lines[@i].LineNo" value="@line.LineNo" />
                                <select name="Lines[@i].ProductCode" class="form-select form-select-sm select2-enable product-select" required data-action-change="onProductChange">
                                    <option value="">-- @Localizer["SelectProduct"] --</option>
                                    @foreach (var p in products)
                                    {
                                        <option value="@p.ProductCode" selected="@(line.ProductCode == (string)p.ProductCode)">@p.ProductCode — @p.ProductName</option>
                                    }
                                </select>
                            </td>
                            <td class="source-col d-none">
                                <div class="input-group input-group-sm u-width-150px">
                                    <input name="Lines[@i].SourceDocId" value="@line.SourceDocId" class="form-control form-control-sm line-source-id" readonly />
                                    <input type="hidden" name="Lines[@i].SourceLineNo" value="@line.SourceLineNo" class="line-source-line" />
                                    <button type="button" class="btn btn-outline-secondary btn-lookup-source" data-action="lookupSource" title="@Localizer["LookupSource"]" aria-label="@Localizer["LookupSource"]"><i class="bi bi-search"></i></button>
                                </div>
                            </td>
                            <td><input name="Lines[@i].Qty" value="@line.Qty" type="number" step="any" min="@UomStepHelper.GetMinPositive(uomDecimals, line.UomCode)" class="form-control form-control-sm text-end line-qty u-width-90px" /></td>
                            <td>
                                <select name="Lines[@i].UomCode" class="form-select form-select-sm line-uom u-width-80px" data-action-change="onUomChange">
                                    @foreach (var u in uoms) { <option value="@u.UomCode" selected="@(line.UomCode == (string)u.UomCode)">@u.UomCode</option> }
                                </select>
                            </td>
                            <td class="d-none"><input name="Lines[@i].UnitPrice" value="@line.UnitPrice" type="number" step="@moneyStep" class="form-control form-control-sm text-end u-width-100px" /></td>
                            <td class="text-end text-muted small">@line.QtyPutAway</td>
                            <td><input name="Lines[@i].Remarks" value="@line.Remarks" class="form-control form-control-sm" /></td>
                            @if (!isReadOnly)
                            {
                                <td class="text-center">
                                    @if (line.QtyPutAway == 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="removeLine" title="@Localizer["RemoveLine"]" aria-label="@Localizer["RemoveLine"]"><i class="bi bi-x-lg"></i></button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    </fieldset>

    @if (!isNew)
    {
        @await Component.InvokeAsync("ContainerUnitsLeft", new { docNo = Model!.OutsourceMaterialDocId })
    }

    <div class="position-sticky bottom-0 bg-white border-top px-3 py-2 d-flex justify-content-between align-items-center gap-2">
        <div class="d-flex gap-2 align-items-center">
            @if (!isNew)
            {
                <span class="badge @ApprovalBadge(Model!.ApprovalStatus)">@SL["ApprovalLabelPrefix"]@DocStatusLabels.Label(Model!.ApprovalStatus)</span>
                <span class="badge @StatusBadge(Model!.Status)">@SL["DocLabelPrefix"]@DocStatusLabels.Label(Model!.Status)</span>
            }
        </div>
        <div class="d-flex gap-2">
            @if (!string.IsNullOrEmpty(Model?.OutsourceMaterialDocId) && (bool?)ViewBag.CanPrint == true)
            {
                <a asp-action="Print" asp-route-id="@Model!.OutsourceMaterialDocId" target="_blank"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-printer"></i>
                </a>
            }
            @if (isReadOnly)
            {
                @if (Model?.Status == DocStatus.Posted)
                {
                    <button type="button" class="btn btn-outline-danger" data-action="voidDoc" data-id="@Model!.OutsourceMaterialDocId">
                        <i class="bi bi-x-octagon me-1"></i>@Localizer["Void"]
                    </button>
                    <button type="button" class="btn btn-danger" data-action="voidAndReopenDoc" data-id="@Model!.OutsourceMaterialDocId">
                        <i class="bi bi-arrow-clockwise me-1"></i>@Localizer["VoidAndReopen"]
                    </button>
                }
                @if (!isNew && Model!.Status == DocStatus.Confirmed && (bool?)ViewBag.CanUpdate == true)
                {
                    <button type="button" class="btn btn-outline-warning" data-action="docAction" data-doc-action="CancelConfirm" data-id="@Model!.OutsourceMaterialDocId" data-msg="@Localizer["ConfirmCancelConfirm"]">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>@Localizer["CancelConfirm"]
                    </button>
                }
                <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">@Localizer["Close"]</button>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">@Localizer["Cancel"]</button>
                @if (!isNew && (Model!.ApprovalStatus == DocumentApprovalStatus.Draft || Model.ApprovalStatus == DocumentApprovalStatus.Rejected))
                {
                    <button type="button" class="btn btn-outline-primary" data-action="docAction" data-doc-action="Submit" data-id="@Model!.OutsourceMaterialDocId" data-msg="@Localizer["ConfirmSubmit"]">
                        <i class="bi bi-send me-1"></i>@Localizer["Submit"]
                    </button>
                }
                @if (!isNew && Model!.ApprovalStatus == DocumentApprovalStatus.PendingApproval)
                {
                    <button type="button" class="btn btn-outline-warning" data-action="docAction" data-doc-action="Withdraw" data-id="@Model!.OutsourceMaterialDocId" data-msg="@Localizer["ConfirmWithdraw"]">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>@Localizer["Withdraw"]
                    </button>
                }
                @if (!isNew && Model!.Status == DocStatus.Draft && Model.ApprovalStatus == DocumentApprovalStatus.Approved)
                {
                    <button type="button" class="btn btn-outline-success" data-action="docAction" data-doc-action="Confirm" data-id="@Model!.OutsourceMaterialDocId" data-msg="@Localizer["ConfirmConfirm"]">
                        <i class="bi bi-check2-circle me-1"></i>@Localizer["Confirm"]
                    </button>
                }
                @if (!isNew && Model!.Status == DocStatus.Confirmed)
                {
                    <button type="button" class="btn btn-outline-warning" data-action="docAction" data-doc-action="CancelConfirm" data-id="@Model!.OutsourceMaterialDocId" data-msg="@Localizer["ConfirmCancelConfirm"]">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>@Localizer["CancelConfirm"]
                    </button>
                }
                @if (Model?.ApprovalStatus != DocumentApprovalStatus.PendingApproval
                     && Model?.ApprovalStatus != DocumentApprovalStatus.Approved
                     && (isNew || Model?.Status == DocStatus.Draft))
                {
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-floppy me-1"></i>@Localizer["Save"]
                    </button>
                }
            }
        </div>
    </div>
</form>

<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    window.uomDecimals = Object.assign(window.uomDecimals || {}, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(uomDecimals ?? new Dictionary<string,int>())));
    function onUomChange(e, sel) {
        var qty = sel.closest('tr').querySelector('.line-qty');
        window.applyUomStep(qty, sel.value);
    }
    var lineIdx = @(Model?.Lines.Count ?? 0);
    var prevEntityCode = '';
    var _entityCodeSuppressed = false;
    setTimeout(() => { prevEntityCode = document.getElementById('SupplierCodeSelect')?.value ?? ''; }, 0);
    var uomOptions = `@foreach(var u in uoms){
@:<option value="@u.UomCode">@u.UomCode</option>
}`;
    var productOptions = `<option value="">-- @Localizer["SelectProduct"] --</option>@foreach(var p in products){
@:<option value="@p.ProductCode">@p.ProductCode — @p.ProductName</option>
}`;
    var transactionTypes = @Html.Raw(transactionTypesJson);

    async function onProductChange(e, inp) {
        const code = inp.value;
        if (!code) return;
        const tr = inp.closest('tr');
        try {
            const resp = await fetch(`/api/warehouse/product-detail?productCode=${encodeURIComponent(code)}`);
            if (resp.ok) {
                const data = await resp.json();
                const priceInp = tr.querySelector('[name*="UnitPrice"]');
                if (priceInp) priceInp.value = data.standardCost || 0;
                const uomSel = tr.querySelector('.line-uom');
                if (uomSel && data.stockUom) {
                    uomSel.value = data.stockUom;
                    window.applyUomStep(tr.querySelector('.line-qty'), data.stockUom);
                }
            }
            const tc = document.getElementById('TypeCode')?.value;
            if (tc === "OO") await updateStockSuggestions(tr, code);
        } catch (e) { console.error(e); }
    }

    async function updateStockSuggestions(tr, productCode) {
        try {
            const resp = await fetch(`/api/warehouse/stock/${encodeURIComponent(productCode)}`);
            if (resp.ok) {
                const stockData = await resp.json();
                tr.dataset.stock = JSON.stringify(stockData);
            }
        } catch (e) { console.error(e); }
    }


    async function lookupSource(e, btn) {
        const typeCode = document.querySelector('[name="TypeCode"]').value;
        const type = transactionTypes.find(t => t.TypeCode === typeCode);
        if (!type?.SourceTypeCode) return;
        const entityCode = document.querySelector('[name="SupplierCode"]').value;
        if (!entityCode) { alert(@(Json.Serialize(SL["SelectSupplierFirst"].Value))); return; }
        const lines = await window.lookupSourceLines(type.SourceTypeCode, entityCode);
        if (!lines.length) return;
        window.showSourcePicker(lines, sel => window.fillSourceLine(btn.closest('tr'), sel));
    }

    function onTypeCodeChange(e, el) {
        const tc = el.value;
        const btns = document.querySelectorAll('.btn-lookup-stock');
        const isOut = (tc === "OO");
        btns.forEach(btn => {
            if (isOut) btn.classList.remove('d-none');
            else btn.classList.add('d-none');
        });
        if (isOut) {
            document.querySelectorAll('#linesTbody tr').forEach(tr => {
                const productCode = tr.querySelector('[name*="ProductCode"]').value;
                if (productCode) updateStockSuggestions(tr, productCode);
            });
        }
        const type = transactionTypes.find(t => t.TypeCode === tc);
        const hasSource = !!(type?.SourceTypeCode);
        document.querySelectorAll('.source-col').forEach(el => {
            if (hasSource) el.classList.remove('d-none');
            else el.classList.add('d-none');
        });
        if (!hasSource) {
            document.querySelectorAll('.line-source-id').forEach(el => el.value = '');
            document.querySelectorAll('.line-source-line').forEach(el => el.value = '');
        }
    }

    function onEntityCodeChange(e, el) {
        const newVal = el.value;
        if (_entityCodeSuppressed) return;
        if (newVal === prevEntityCode) return;
        const tc = document.querySelector('[name="TypeCode"]').value;
        const hasSource = !!(transactionTypes.find(t => t.TypeCode === tc)?.SourceTypeCode);
        const hasRows = document.querySelectorAll('#linesTbody tr').length > 0;
        if (hasSource && hasRows) {
            if (!confirm('@Localizer["EntityCodeChangeWillClearLines"]')) {
                _entityCodeSuppressed = true;
                document.getElementById('SupplierCodeSelect').value = prevEntityCode;
                _entityCodeSuppressed = false;
                return;
            }
            document.getElementById('linesTbody').innerHTML = '';
            lineIdx = 0;
        }
        prevEntityCode = newVal;
    }

    function addLine() {
        const i = lineIdx++;
        const srcHidden = document.querySelector('thead .source-col')?.classList.contains('d-none');
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td class="text-center text-muted small">${i+1}</td>
            <td><input type="hidden" name="Lines[${i}].LineNo" value="0" /><select name="Lines[${i}].ProductCode" class="form-select form-select-sm select2-enable product-select" required data-action-change="onProductChange">${productOptions}</select></td>
            <td class="source-col${srcHidden ? ' d-none' : ''}"><div class="input-group input-group-sm u-width-150px"><input name="Lines[${i}].SourceDocId" class="form-control form-control-sm line-source-id" readonly /><input type="hidden" name="Lines[${i}].SourceLineNo" class="line-source-line" /><button type="button" class="btn btn-outline-secondary btn-lookup-source" data-action="lookupSource" title="@Localizer["LookupSource"]" aria-label="@Localizer["LookupSource"]"><i class="bi bi-search"></i></button></div></td>
            <td><input name="Lines[${i}].Qty" type="number" value="1" class="form-control form-control-sm text-end line-qty u-width-90px" /></td>
            <td><select name="Lines[${i}].UomCode" class="form-select form-select-sm line-uom u-width-80px" data-action-change="onUomChange">${uomOptions}</select></td>
            <td class="d-none"><input name="Lines[${i}].UnitPrice" type="number" step="@moneyStep" class="form-control form-control-sm text-end u-width-100px" /></td>
            <td class="text-end text-muted small">0</td>
            <td><input name="Lines[${i}].Remarks" class="form-control form-control-sm" /></td>
            <td class="text-center"><button type="button" class="btn btn-sm btn-link text-danger p-0" data-action="removeLine" title="@Localizer["RemoveLine"]" aria-label="@Localizer["RemoveLine"]"><i class="bi bi-x-lg"></i></button></td>`;
        document.getElementById('linesTbody').appendChild(tr);
        window.armValidation(document.getElementById('outsourceForm')); // 動態列重註冊 unobtrusive 驗證（R6c）
        const uomSel = tr.querySelector('.line-uom');
        const qtyInp = tr.querySelector('.line-qty');
        if (uomSel && qtyInp) window.applyUomStep(qtyInp, uomSel.value);
        initSelect2(tr);
    }

    function removeLine(e, btn) {
        btn.closest('tr').remove();
        const tcEl = document.getElementById('TypeCode');
        if (tcEl?.value) setTimeout(() => onTypeCodeChange(null, tcEl), 100);
    }

    function docAction(e, el) {
        const action = el.dataset.docAction, id = el.dataset.id, msg = el.dataset.msg;
        if (msg && !confirm(msg)) return;
        const token = document.querySelector('#outsourceForm input[name="__RequestVerificationToken"]')?.value ?? '';
        fetch(`/OutsourceMaterial/${action}/${id}`, {
            method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ __RequestVerificationToken: token })
        }).then(r => r.json()).then(d => { if (d.success) { window.toastSuccess && window.toastSuccess(); refreshList && refreshList(); } else alert(d.message); });
    }

    function voidDoc(e, el) {
        const id = el.dataset.id;
        const reason = prompt('@Localizer["VoidReason"]');
        if (reason === null) return;
        const token = document.querySelector('#outsourceForm input[name="__RequestVerificationToken"]')?.value ?? '';
        fetch(`/OutsourceMaterial/Void/${id}`, {
            method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ reason, __RequestVerificationToken: token })
        }).then(r => r.json()).then(d => { if (d.success) { window.toastSuccess && window.toastSuccess(); refreshList && refreshList(); } else alert(d.message); });
    }

    function voidAndReopenDoc(e, el) {
        const id = el.dataset.id;
        const reason = prompt('@Localizer["VoidReason"]');
        if (reason === null) return;
        const token = document.querySelector('#outsourceForm input[name="__RequestVerificationToken"]')?.value ?? '';
        fetch(`/OutsourceMaterial/VoidAndReopen/${id}`, {
            method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams({ reason, __RequestVerificationToken: token })
        }).then(async r => {
            if (r.ok) { const html = await r.text(); const body = document.getElementById('sidePanelBody'); if (body) { body.innerHTML = html; if (window.execScripts) execScripts(body); } }
            else { const d = await r.json(); alert(d.message || @(Json.Serialize(SL["VoidFailed"].Value))); }
        });
    }

    // 庫存單位為品號帶出之唯讀欄位：鎖定不可手改（select 仍 enabled，值隨表單送出）
    (function lockUomReadonly() {
        var scope = document.getElementById('sidePanelBody');
        if (!scope) return;
        var lock = function () {
            scope.querySelectorAll('select.line-uom').forEach(function (s) {
                s.classList.add('bg-light');
                s.style.pointerEvents = 'none';
                s.tabIndex = -1;
                s.setAttribute('aria-readonly', 'true');
            });
        };
        lock();
        new MutationObserver(lock).observe(scope, { childList: true, subtree: true });
    })();

    // select2 初始化——本 Partial 經 crud-panel.js 局部注入，site.js 的
    // DOMContentLoaded 全域初始化不會重跑，故需自行呼叫；dropdownParent 指向表單本身，
    // 確保下拉選單在側欄(offcanvas)內不被裁切。addLine() 新增列時也呼叫本函式。
    function initSelect2(scope) {
        if (!window.jQuery || !$.fn.select2) return;
        var $scope = scope ? $(scope) : $('#outsourceForm');
        $scope.find('.select2-enable').not('.select2-hidden-accessible').each(function () {
            $(this).select2({
                theme: 'bootstrap-5', width: '100%', dropdownParent: $('#outsourceForm'),
                placeholder: $(this).data('placeholder'), allowClear: Boolean($(this).data('allow-clear'))
            });
        });
    }
    initSelect2();
</script>

@functions {
    string StatusBadge(DocStatus s) => s switch { DocStatus.Draft => "bg-secondary", DocStatus.Confirmed => "bg-info text-dark", DocStatus.Posted => "bg-success", DocStatus.Void => "bg-danger", _ => "bg-secondary" };
    string ApprovalBadge(DocumentApprovalStatus s) => s switch { DocumentApprovalStatus.Approved => "bg-success", DocumentApprovalStatus.PendingApproval => "bg-warning text-dark", DocumentApprovalStatus.Rejected => "bg-danger", _ => "bg-secondary" };
}
