@using SmartFactory.MES.Modules.BAS.Services
@inject SmartFactory.MES.Modules.BAS.Services.IDisplayPrecision Precision
@using SmartFactory.MES.Services
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model List<SmartFactory.MES.Modules.INV.ViewModels.SlowMovingInventoryRowVm>

@{
    var moneyFmt         = await Precision.BaseMoneyFormatAsync();
    ViewData["Title"] = Localizer["PageTitle"].Value;
    bool   hasSearched   = ViewBag.Searched as bool? ?? false;
    bool   canPrint      = ViewBag.CanPrint == true;
    int    idleDays      = ViewBag.IdleDays as int? ?? 90;
    string searchProduct  = ViewBag.SearchProduct as string ?? "";
    var    productOptions = ViewBag.ProductOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    bool   tooMany        = ViewBag.TooMany == true;
    int    scanLimit      = ViewBag.ScanLimit as int? ?? 0;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-clock-history me-2 text-secondary"></i>@Localizer["PageTitle"]</h1>
        @if (canPrint && hasSearched && Model != null && Model.Any())
        {
            <a asp-action="Export"
               asp-route-idleDays="@idleDays" asp-route-searchProduct="@searchProduct"
               class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
            </a>
        }
    </div>

    @* 常用查詢入口（§7.9-6）。放在查詢卡片之外——partial 內有按鈕與輸入框，
       塞進下面那張卡的 <form> 內會變成巢狀表單。 *@
    @await Html.PartialAsync("_SavedQueries", "SlowMovingInventory")

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["IdleDaysThreshold"]</label>
                    <div class="input-group">
                        <input type="number" name="idleDays" class="form-control" value="@idleDays" min="1" max="3650" />
                        <span class="input-group-text">@Localizer["Days"]</span>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">@Localizer["Product"]</label>
                    <select name="searchProduct" class="form-select form-select-sm select2-enable w-100"
                            data-placeholder="@Localizer["Product"]" data-allow-clear="true">
                        <option value=""></option>
                        @foreach (var p in productOptions)
                        {
                            <option value="@p.ProductCode" selected="@(searchProduct == (string)p.ProductCode)">@p.ProductCode — @p.ProductName</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                </div>
            @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchFirst"]
        </div>
    }
    else if (tooMany)
    {
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <span>@Localizer["TooManyRows", scanLimit]</span>
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-success text-center"><i class="bi bi-check-circle me-1"></i>@Localizer["NoData"]</div>
    }
    else
    {
        var totalValue = Model.Sum(r => r.InventoryValue);
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 bg-secondary text-white shadow-sm">
                    <div class="card-body text-center">
                        <div class="fs-6 mb-1">@Localizer["SlowCount"]</div>
                        <div class="fs-4 fw-bold">@Model.Count</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-danger text-white shadow-sm">
                    <div class="card-body text-center">
                        <div class="fs-6 mb-1">@Localizer["TotalValue"]</div>
                        <div class="fs-4 fw-bold">@totalValue.ToString(moneyFmt)</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Localizer["ProductCode"]</th>
                                <th>@Localizer["ProductName"]</th>
                                <th>@Localizer["LocationCode"]</th>
                                <th>@Localizer["LotNo"]</th>
                                <th class="text-end">@Localizer["QtyOnHand"]</th>
                                <th class="text-end">@Localizer["UnitCost"]</th>
                                <th class="text-end">@Localizer["InventoryValue"]</th>
                                <th>@Localizer["LastMovementDate"]</th>
                                <th class="text-center">@Localizer["IdleDays"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var paged = ReportPaging.Page(Model, ViewData, Context); }
                            @foreach (var row in paged)
                            {
                                var daysBadge = row.IdleDays >= 365 ? "bg-danger"
                                              : row.IdleDays >= 180 ? "bg-warning text-dark"
                                              : "bg-secondary";
                                var daysText = row.IdleDays == 9999 ? "N/A" : row.IdleDays.ToString();
                                <tr>
                                    <td class="fw-semibold">@row.ProductCode</td>
                                    <td>@row.ProductName</td>
                                    <td>@row.LocationCode</td>
                                    <td>@(string.IsNullOrEmpty(row.LotNo) ? "—" : row.LotNo)</td>
                                    <td class="text-end">@row.QtyOnHand.ToString("N2")</td>
                                    <td class="text-end">@row.UnitCost.ToString(moneyFmt)</td>
                                    <td class="text-end fw-semibold">@row.InventoryValue.ToString(moneyFmt)</td>
                                    <td>@(row.LastMovementDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td class="text-center"><span class="badge @daysBadge">@daysText @Localizer["Days"]</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @await Html.PartialAsync("_Pagination", paged)
        </div>
    }
</div>
