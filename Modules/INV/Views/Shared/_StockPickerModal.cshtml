@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer L

@*
    庫存挑選視窗（2026-09-21）。

    為什麼有這個：四張 INV 單據的明細行都有一顆放大鏡、標題寫「選擇庫存」，
    但它們實際上只是去 /api/warehouse/stock 把可用量塞進儲位下拉再 focus——
    沒有任何挑選視窗。名稱與圖示都在承諾一件沒做的事，而跨廠調撥那支連
    「塞進下拉」都沒做（fetch 完把結果整包丟掉）。

    ⚠️ 這個 modal 會被放在 offcanvas 側面板**裡面**。Bootstrap 的 modal 在
    offcanvas 內開啟會灰屏凍結，所以 stock-picker.js 開啟前一律把節點搬到
    document.body——與 PurchaseOrder 的 PR 匯入 modal 同一套做法（data-moved-modal）。
*@

<div class="modal fade" id="stockPickerModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header py-2">
        <h6 class="modal-title"><i class="bi bi-box-seam me-1"></i>@L["Title"]</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
      </div>
      <div class="modal-body">
        <div class="small text-muted mb-2" id="stockPickerProduct"></div>
        @* 廠級保留（訂單／工單，不落儲位）：下表「可用」只扣儲位鎖量，看不到這種保留（驗收 X-8） *@
        <div class="alert alert-warning py-1 px-2 small mb-2 d-none" id="stockPickerReserved"></div>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>@L["Warehouse"]</th>
                <th>@L["Location"]</th>
                <th>@L["LotNo"]</th>
                <th class="text-end">@L["QtyOnHand"]</th>
                <th class="u-width-80px"></th>
              </tr>
            </thead>
            <tbody id="stockPickerTbody"></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer py-2">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">@L["Close"]</button>
      </div>
    </div>
  </div>
</div>

@* 訊息全部以 data-* 傳給 js：stock-picker.js 內不得出現中文字面（Cx7）。 *@
<span id="stockPickerMsgs" class="d-none"
      data-loading="@L["Loading"]"
      data-empty="@L["NoStock"]"
      data-failed="@L["LoadFailed"]"
      data-select="@L["Select"]"
      data-product="@L["ProductLabel"]"
      data-reserved="@L.GetString("PlantReservedFmt").Value"
      data-src-salesorder="@L["SrcSalesOrder"]"
      data-src-workordermaterial="@L["SrcWorkOrder"]"
      data-src-materialstagingorder="@L["SrcStaging"]"
      data-src-dispatch="@L["SrcDispatch"]"
      data-src-mrprunline="@L["SrcMrp"]"></span>

<script src="~/js/stock-picker.js" asp-append-version="true"></script>
