@using SmartFactory.MES.Services
@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.BAS.Services
@using SmartFactory.MES.Modules.INV.ViewModels
@inject IViewLocalizer Localizer
@inject IUomService UomService
@model StockLedgerVm

@{
    ViewData["Title"] = Localizer["PageTitle"];
    bool hasSearched = ViewBag.Searched == true;
    var productOptions = ViewBag.ProductOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var locationOptions = ViewBag.LocationOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var productCode = ViewBag.ProductCode as string ?? "";
    var dateFromStr = ViewBag.DateFrom is DateOnly df ? df.ToString("yyyy-MM-dd") : "";
    var dateToStr   = ViewBag.DateTo   is DateOnly dt ? dt.ToString("yyyy-MM-dd") : "";
    var locationCode = ViewBag.LocationCode as string ?? "";
    var lotNo = ViewBag.LotNo as string ?? "";
    bool canPrint = ViewBag.CanPrint as bool? ?? false;

    var uomDecimals = await UomService.GetAllDecimalPlacesAsync();
    string QtyFmt(string? uom)
    {
        var dp = (!string.IsNullOrEmpty(uom) && uomDecimals.TryGetValue(uom, out var v)) ? v : 4;
        return dp <= 0 ? "N0" : $"N{dp}";
    }
    string fmt = QtyFmt(Model?.StockUomCode);
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-journal-text"></i> @Localizer["PageTitle"]</h1>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />

                <div class="col-md-3">
                    <label class="form-label small fw-semibold">@Localizer["ProductCode"] <span class="text-danger">*</span></label>
                    <select name="productCode" class="form-select form-select-sm select2-enable w-100" required
                            data-placeholder="@Localizer["ProductCode"]" data-allow-clear="true">
                        <option value=""></option>
                        @foreach (var p in productOptions)
                        {
                            <option value="@p.ProductCode" selected="@(productCode == (string)p.ProductCode)">@p.ProductCode — @p.ProductName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["DateFrom"]</label>
                    <input type="date" name="dateFrom" class="form-control form-control-sm" value="@dateFromStr" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["DateTo"]</label>
                    <input type="date" name="dateTo" class="form-control form-control-sm" value="@dateToStr" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["LocationCode"]</label>
                    <select name="locationCode" class="form-select form-select-sm">
                        <option value="">@Localizer["AllLocations"]</option>
                        @foreach (var l in locationOptions)
                        {
                            <option value="@l.LocationCode" selected="@(locationCode == (string)l.LocationCode)">@l.WhCode / @l.LocationCode — @l.LocationName</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["LotNo"]</label>
                    <input type="text" name="lotNo" class="form-control form-control-sm" value="@lotNo" />
                </div>

                <div class="col-12 d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-search me-1"></i>@Localizer["Search"]
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Reset"]</a>

                    @if (canPrint && hasSearched && Model != null)
                    {
                        <div class="ms-auto d-flex gap-2">
                            <a asp-action="Print" target="_blank"
                               asp-route-productCode="@productCode" asp-route-dateFrom="@dateFromStr"
                               asp-route-dateTo="@dateToStr" asp-route-locationCode="@locationCode"
                               asp-route-lotNo="@lotNo" class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-printer"></i> @Localizer["Print"]
                            </a>
                            <div class="btn-group">
                                <a asp-action="Export"
                                   asp-route-productCode="@productCode" asp-route-dateFrom="@dateFromStr"
                                   asp-route-dateTo="@dateToStr" asp-route-locationCode="@locationCode"
                                   asp-route-lotNo="@lotNo" asp-route-format="xlsx" class="btn btn-outline-success btn-sm">
                                    <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
                                </a>
                                <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle dropdown-toggle-split"
                                        data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-productCode="@productCode" asp-route-dateFrom="@dateFromStr"
                                           asp-route-dateTo="@dateToStr" asp-route-locationCode="@locationCode"
                                           asp-route-lotNo="@lotNo" asp-route-format="csv">CSV</a></li>
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-productCode="@productCode" asp-route-dateFrom="@dateFromStr"
                                           asp-route-dateTo="@dateToStr" asp-route-locationCode="@locationCode"
                                           asp-route-lotNo="@lotNo" asp-route-format="json">JSON</a></li>
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched || Model == null)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else
    {
        @* 明細列自帶 Balance（伺服端算好的逐列餘額），所以切頁不會讓餘額欄算錯；
           期初／期末與截斷警告仍是對完整結果集算的。 *@
        var paged = ReportPaging.Page(Model.Rows, ViewData, Context);
        @if (Model.Truncated)
        {
            <div class="alert alert-warning d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <span>@Localizer["LedgerTruncated", Model.RowCap]</span>
            </div>
        }
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex flex-wrap gap-3 align-items-center">
                <span class="fw-semibold fs-5">@Model.ProductCode</span>
                <span class="text-muted">@Model.ProductName</span>
                <span class="badge bg-light text-dark border">@Localizer["StockUom"]: @Model.StockUomCode</span>
                @if (Model.DateFrom != null || Model.DateTo != null)
                {
                    <span class="text-muted small ms-auto">
                        @(Model.DateFrom?.ToString("yyyy-MM-dd") ?? "…") ~ @(Model.DateTo?.ToString("yyyy-MM-dd") ?? "…")
                    </span>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="u-width-110px">@Localizer["Date"]</th>
                            <th>@Localizer["Summary"]</th>
                            <th class="text-end">@Localizer["InQty"]</th>
                            <th class="text-end">@Localizer["OutQty"]</th>
                            <th class="text-end">@Localizer["Balance"]</th>
                            <th>@Localizer["Handler"]</th>
                            <th>@Localizer["Remark"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="table-secondary">
                            <td class="small">@(Model.DateFrom?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td class="fw-semibold">@Localizer["OpeningBalance"]</td>
                            <td class="text-end text-muted">-</td>
                            <td class="text-end text-muted">-</td>
                            <td class="text-end fw-semibold">@Model.OpeningBalance.ToString(fmt)</td>
                            <td></td>
                            <td></td>
                        </tr>
                        @if (Model.Rows.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox d-block mb-1"></i>@Localizer["NoData"]
                            </td></tr>
                        }
                        else
                        {
                            foreach (var r in paged)
                            {
                                <tr>
                                    <td class="small">@r.MovementDate.ToString("yyyy-MM-dd")</td>
                                    <td><span class="badge bg-light text-dark border">@r.TypeCode</span> @r.Summary</td>
                                    <td class="text-end">@(r.InQty == 0 ? "-" : r.InQty.ToString(fmt))</td>
                                    <td class="text-end">@(r.OutQty == 0 ? "-" : r.OutQty.ToString(fmt))</td>
                                    <td class="text-end fw-medium">@r.Balance.ToString(fmt)</td>
                                    <td class="small">@r.Handler</td>
                                    <td class="small text-muted">
                                        @r.DocNo
                                        @if (!string.IsNullOrEmpty(r.SourceDocNo)) { <span>← @r.SourceDocNo</span> }
                                        @if (!string.IsNullOrEmpty(r.Remark)) { <span class="d-block">@r.Remark</span> }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-semibold">
                        <tr>
                            <td></td>
                            <td>@Localizer["ClosingBalance"]</td>
                            <td class="text-end">@Model.TotalIn.ToString(fmt)</td>
                            <td class="text-end">@Model.TotalOut.ToString(fmt)</td>
                            <td class="text-end">@Model.ClosingBalance.ToString(fmt)</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        @await Html.PartialAsync("_Pagination", paged)
    }
</div>
