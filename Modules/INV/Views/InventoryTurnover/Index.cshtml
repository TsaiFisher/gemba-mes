@using SmartFactory.MES.Modules.BAS.Services
@inject SmartFactory.MES.Modules.BAS.Services.IDisplayPrecision Precision
@using SmartFactory.MES.Services
@model List<SmartFactory.MES.Modules.INV.ViewModels.InventoryTurnoverRowVm>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    var moneyFmt         = await Precision.BaseMoneyFormatAsync();
    ViewData["Title"] = L["PageTitle"].Value;
    bool searched   = ViewBag.Searched == true;
    bool canPrint   = ViewBag.CanPrint == true;
    var rows        = Model ?? new();
    var categories  = ViewBag.Categories as List<string> ?? new();
}

<div class="container-fluid py-3">
    <h4 class="mb-3">@L["PageTitle"]</h4>

    <form method="get" asp-action="Index" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">@L["FromDate"]</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" required />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["ToDate"]</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" required />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["CategoryCode"]</label>
                <select name="categoryCode" class="form-select">
                    <option value="">@L["AllCategories"]</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c" selected="@(ViewBag.CategoryCode?.ToString() == c)">@c</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" name="searched" value="true" class="btn btn-primary w-100 px-4">
                    <i class="bi bi-search"></i> @L["Search"]
                </button>
            </div>
        </div>
    @await Html.PartialAsync("_PageSizeSelect")
    </form>

    @* 日期欄位已標 required，這一段是後端的第二道：直接改網址或關掉 JS 時仍要講清楚 *@
    @if (ViewBag.DateRangeRequired == true)
    {
        <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@L["DateRangeRequired"]</div>
    }

    @if (!searched)
    {
        <div class="alert alert-info">@L["SearchFirst"]</div>
    }
    else if (!rows.Any())
    {
        <div class="alert alert-warning">@L["NoData"]</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <strong>@L["ResultTitle"]</strong>
                <span class="text-muted ms-1">@rows.Count @L["Items"]</span>
            </div>
            @if (canPrint)
            {
                <a asp-action="Export"
                   asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate"
                   asp-route-categoryCode="@ViewBag.CategoryCode"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> @L["ExportExcel"]
                </a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>@L["CategoryCode"]</th>
                        <th>@L["ProductCode"]</th>
                        <th>@L["ProductName"]</th>
                        <th class="text-end">@L["OutboundCost"]</th>
                        <th class="text-end">@L["InventoryValue"]</th>
                        <th class="text-end">@L["TurnoverRate"]</th>
                        <th class="text-end">@L["DSI"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var paged = ReportPaging.Page(rows, ViewData, Context); }
                    @foreach (var r in paged)
                    {
                        <tr>
                            <td>@r.CategoryCode</td>
                            <td>@r.ProductCode</td>
                            <td>@r.ProductName</td>
                            <td class="text-end">@r.OutboundCost.ToString(moneyFmt)</td>
                            <td class="text-end">@r.InventoryValue.ToString(moneyFmt)</td>
                            <td class="text-end @(r.TurnoverRate < 1 ? "text-danger" : r.TurnoverRate >= 4 ? "text-success" : "")">
                                @r.TurnoverRate.ToString("N2")
                            </td>
                            <td class="text-end text-muted">@(r.DaysSalesInventory?.ToString("N0") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", paged)
        <div class="text-muted small mt-1">@L["TurnoverNote"]</div>
    }
</div>
