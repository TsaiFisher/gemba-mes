@using SmartFactory.MES.Services
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Modules.RPT.Models.MarginAnalysisReport

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    bool   hasSearched = ViewBag.Searched as bool? ?? false;
    bool   canPrint    = ViewBag.CanPrint == true;
    string fromDate    = ViewBag.FromDate as string ?? DateTime.Today.AddMonths(-1).ToString("yyyy-MM-dd");
    string toDate      = ViewBag.ToDate   as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    string dimension   = ViewBag.Dimension as string ?? "Product";
    int baseDp = ViewBag.BaseCurrencyDp as int? ?? 2;
    string moneyFmt = baseDp <= 0 ? "N0" : $"N{baseDp}";

    var rows    = Model?.Rows ?? new();
    bool hasData = rows.Count > 0;

    string DimHeader(string d) => d switch
    {
        "Customer" => Localizer["ByCustomer"].Value,
        "Month"    => Localizer["ByMonth"].Value,
        _          => Localizer["ByProduct"].Value,
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-cash-stack me-2 text-success"></i>@Localizer["PageTitle"]</h1>
        @if (canPrint && hasSearched && hasData)
        {
            <a asp-action="Export" asp-route-fromDate="@fromDate" asp-route-toDate="@toDate" asp-route-dimension="@dimension"
               class="btn btn-outline-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
            </a>
        }
    </div>

    @* 常用查詢入口（§7.9-6）。放在查詢卡片之外——partial 內有按鈕與輸入框，
       塞進下面那張卡的 <form> 內會變成巢狀表單。 *@
    @await Html.PartialAsync("_SavedQueries", "MarginAnalysis")

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">@Localizer["Dimension"]</label>
                    <select name="dimension" class="form-select form-select-sm">
                        <option value="Product"  selected="@(dimension == "Product")">@Localizer["ByProduct"]</option>
                        <option value="Customer" selected="@(dimension == "Customer")">@Localizer["ByCustomer"]</option>
                        <option value="Month"    selected="@(dimension == "Month")">@Localizer["ByMonth"]</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">@Localizer["DateFrom"]</label>
                    <input type="date" name="fromDate" value="@fromDate" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">@Localizer["DateTo"]</label>
                    <input type="date" name="toDate" value="@toDate" class="form-control form-control-sm" required />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                </div>
            @await Html.PartialAsync("_PageSizeSelect")
            </form>

            @* 日期欄位已標 required，這一段是後端的第二道：直接改網址或關掉 JS 時仍要講清楚 *@
            @if (ViewBag.DateRangeRequired == true)
            {
                <div class="alert alert-warning py-2"><i class="bi bi-exclamation-triangle me-1"></i>@Localizer["DateRangeRequired"]</div>
            }
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchFirst"]
        </div>
    }
    else if (!hasData)
    {
        <div class="alert alert-warning text-center">@Localizer["NoData"]</div>
    }
    else
    {
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 bg-primary text-white shadow-sm"><div class="card-body text-center">
                <div class="fs-6 mb-1">@Localizer["TotalRevenue"]</div>
                <div class="fs-5 fw-bold">@Model!.TotalRevenue.ToString(moneyFmt)</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-secondary text-white shadow-sm"><div class="card-body text-center">
                <div class="fs-6 mb-1">@Localizer["TotalCost"]</div>
                <div class="fs-5 fw-bold">@Model.TotalCost.ToString(moneyFmt)</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-success text-white shadow-sm"><div class="card-body text-center">
                <div class="fs-6 mb-1">@Localizer["TotalGrossProfit"]</div>
                <div class="fs-5 fw-bold">@Model.TotalGrossProfit.ToString(moneyFmt)</div>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 bg-info text-white shadow-sm"><div class="card-body text-center">
                <div class="fs-6 mb-1">@Localizer["TotalMarginRate"]</div>
                <div class="fs-5 fw-bold">@Model.TotalMarginRate.ToString("N2")%</div>
            </div></div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@DimHeader(dimension)</th>
                        <th class="text-end">@Localizer["Revenue"]</th>
                        <th class="text-end">@Localizer["Cost"]</th>
                        <th class="text-end">@Localizer["GrossProfit"]</th>
                        <th class="text-end u-width-22pct">@Localizer["GrossMarginRate"]</th>
                        <th class="text-center">@Localizer["ShipCount"]</th>
                    </tr>
                </thead>
                <tbody>
                @{ var paged = ReportPaging.Page(rows, ViewData, Context); }
                @foreach (var r in paged)
                {
                    var negative = r.GrossProfit < 0;
                    <tr>
                        <td>
                            <span class="fw-semibold">@r.DimensionKey</span>
                            @if (r.DimensionName != r.DimensionKey) { <div class="small text-muted">@r.DimensionName</div> }
                        </td>
                        <td class="text-end">@r.Revenue.ToString(moneyFmt)</td>
                        <td class="text-end">@r.Cost.ToString(moneyFmt)</td>
                        <td class="text-end @(negative ? "text-danger fw-bold" : "")">@r.GrossProfit.ToString(moneyFmt)</td>
                        <td class="text-end">
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1 u-height-8px">
                                    <div class="progress-bar @(negative ? "bg-danger" : r.GrossMarginRate >= 30 ? "bg-success" : "bg-warning")"
                                         role="progressbar" data-pct-width="@(Math.Min(100, Math.Max(0, (double)r.GrossMarginRate)).ToString("0.##"))"></div>
                                </div>
                                <span class="u-min-width-4rem">@r.GrossMarginRate.ToString("N2")%</span>
                            </div>
                        </td>
                        <td class="text-center">@r.ShipCount</td>
                    </tr>
                }
                </tbody>
                <tfoot class="table-secondary">
                    <tr>
                        <td class="fw-bold">@Localizer["Total"]</td>
                        <td class="text-end fw-bold">@Model.TotalRevenue.ToString(moneyFmt)</td>
                        <td class="text-end fw-bold">@Model.TotalCost.ToString(moneyFmt)</td>
                        <td class="text-end fw-bold">@Model.TotalGrossProfit.ToString(moneyFmt)</td>
                        <td class="text-end fw-bold">@Model.TotalMarginRate.ToString("N2")%</td>
                        <td class="text-center fw-bold">@rows.Sum(r => r.ShipCount)</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination", paged)
    }
</div>
