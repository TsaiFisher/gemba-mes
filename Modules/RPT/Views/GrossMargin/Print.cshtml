@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Modules.RPT.Models.GrossMarginReport
@{
    Layout = "~/Views/Shared/_PrintLayoutZ.cshtml";
    ViewData["Title"] = Localizer["PageTitle"].Value;
    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate   = ViewBag.ToDate   as string ?? "";
    int baseDp = ViewBag.BaseCurrencyDp as int? ?? 2;
    string moneyFmt = baseDp <= 0 ? "N0" : $"N{baseDp}";
}

<div class="print-header">
    <div class="print-qr">@Html.Raw(ViewBag.QrSvg)</div>
    <div>
        <div class="print-title">SmartFactory MES</div>
        <div class="print-subtitle">@Localizer["PageTitle"]</div>
        <div class="print-doc-number">@fromDate ～ @toDate</div>
    </div>
</div>

<div class="print-section">
    <div class="print-section-title">@Localizer["Summary"]</div>
    <div class="print-field-grid">
        <div class="print-field-label">@Localizer["TotalRevenue"]</div>
        <div class="print-field-value fw-bold">@Model.TotalRevenue.ToString(moneyFmt)</div>
        <div class="print-field-label">@Localizer["TotalCost"]</div>
        <div class="print-field-value">@Model.TotalCost.ToString(moneyFmt)</div>
        <div class="print-field-label">@Localizer["TotalGrossProfit"]</div>
        <div class="print-field-value fw-bold">@Model.TotalGrossProfit.ToString(moneyFmt)</div>
        <div class="print-field-label">@Localizer["GrossMarginRate"]</div>
        <div class="print-field-value fw-bold">@Model.TotalMarginRate.ToString("N1")%</div>
    </div>
</div>

<div class="print-section">
    <div class="print-section-title">@Localizer["DetailTitle"]</div>
    <table class="print-table">
        <thead>
            <tr>
                <th>@Localizer["ProductCode"]</th>
                <th class="text-end">@Localizer["Revenue"]</th>
                <th class="text-end">@Localizer["Cost"]</th>
                <th class="text-end">@Localizer["GrossProfit"]</th>
                <th class="text-end">@Localizer["GrossMarginRate"]</th>
                <th class="text-center">@Localizer["ShipCount"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td>@row.ProductCode</td>
                    <td class="text-end">@row.Revenue.ToString(moneyFmt)</td>
                    <td class="text-end">@row.Cost.ToString(moneyFmt)</td>
                    <td class="text-end">@row.GrossProfit.ToString(moneyFmt)</td>
                    <td class="text-end">@row.GrossMarginRate.ToString("N1")%</td>
                    <td class="text-center">@row.ShipCount</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_PrintBase")
