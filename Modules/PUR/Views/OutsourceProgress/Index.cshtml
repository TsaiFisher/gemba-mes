@using SmartFactory.MES.Services
@model List<SmartFactory.MES.Modules.PUR.ViewModels.OutsourceProgressRowVm>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    bool searched       = ViewBag.Searched == true;
    bool canPrint       = ViewBag.CanPrint == true;
    bool overdueOnly    = ViewBag.OverdueOnly == true;
    int  minOverdueDays = ViewBag.MinOverdueDays as int? ?? 0;
    var rows            = Model ?? new();
    int overdueCount    = rows.Count(r => r.IsOverdue);
    string curSupplier  = ViewBag.SearchSupplier as string ?? "";
    string curProduct   = ViewBag.SearchProduct  as string ?? "";
    var supplierOptions = ViewBag.SupplierOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var productOptions  = ViewBag.ProductOptions  as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="container-fluid py-3">
    <h4 class="mb-3">@L["PageTitle"]</h4>

    <form method="get" asp-action="Index" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">@L["FromDate"]</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["ToDate"]</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Supplier"]</label>
                <select name="searchSupplier" class="form-select form-select-sm select2-enable w-100"
                        data-placeholder="@L["AllSuppliers"]" data-allow-clear="true">
                    <option value=""></option>
                    @foreach (var s in supplierOptions)
                    {
                        <option value="@s.CompanyCode" selected="@(curSupplier == (string)s.CompanyCode)">@s.CompanyCode — @s.CompanyName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["Product"]</label>
                <select name="searchProduct" class="form-select form-select-sm select2-enable w-100"
                        data-placeholder="@L["AllProducts"]" data-allow-clear="true">
                    <option value=""></option>
                    @foreach (var p in productOptions)
                    {
                        <option value="@p.ProductCode" selected="@(curProduct == (string)p.ProductCode)">@p.ProductCode — @p.ProductName</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <label class="form-label">@L["MinOverdueDays"]</label>
                <input type="number" name="minOverdueDays" class="form-control" min="0" step="1" value="@minOverdueDays" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" name="overdueOnly" value="true"
                           id="chkOverdue" checked="@overdueOnly" />
                    <label class="form-check-label" for="chkOverdue">@L["OverdueOnly"]</label>
                </div>
            </div>
            <div class="col-md-1">
                <button type="submit" name="searched" value="true" class="btn btn-primary w-100 px-4">
                    <i class="bi bi-search"></i> @L["Search"]
                </button>
            </div>
        </div>
    @await Html.PartialAsync("_PageSizeSelect")
    </form>

    @if (!searched)
    {
        <div class="alert alert-info">@L["SearchFirst"]</div>
    }
    else if (!rows.Any())
    {
        <div class="alert alert-warning">@L["NoData"]</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <strong>@L["ResultTitle"]</strong>
                <span class="text-muted ms-1">@rows.Count @L["Items"]</span>
                @if (overdueCount > 0)
                {
                    <span class="badge bg-danger ms-2">@L["OverdueCount"]：@overdueCount</span>
                }
            </div>
            @if (canPrint)
            {
                <a asp-action="Export"
                   asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate"
                   asp-route-searchSupplier="@ViewBag.SearchSupplier" asp-route-searchProduct="@ViewBag.SearchProduct"
                   asp-route-overdueOnly="@overdueOnly" asp-route-minOverdueDays="@minOverdueDays"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> @L["ExportExcel"]
                </a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>@L["OutsourcePurchaseOrderId"]</th>
                        <th>@L["SupplierCode"]</th>
                        <th>@L["OrderDate"]</th>
                        <th>@L["ExpectedDeliveryDate"]</th>
                        <th>@L["ProductCode"]</th>
                        <th class="text-end">@L["OrderedQty"]</th>
                        <th class="text-end">@L["ReceivedQty"]</th>
                        <th class="text-end">@L["PendingQty"]</th>
                        <th class="text-end">@L["ProgressPct"]</th>
                        <th class="text-center">@L["OverdueDays"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var paged = ReportPaging.Page(rows, ViewData, Context); }
                    @foreach (var r in paged)
                    {
                        <tr class="@(r.IsOverdue ? "table-danger" : "")">
                            <td>@r.OutsourcePurchaseOrderId</td>
                            <td>@r.SupplierCode</td>
                            <td>@r.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td>@(r.ExpectedDeliveryDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                            <td>@r.ProductCode</td>
                            <td class="text-end">@r.OrderedQty.ToString("N0")</td>
                            <td class="text-end text-success">@r.ReceivedQty.ToString("N0")</td>
                            <td class="text-end @(r.PendingQty > 0 ? "text-warning" : "")">@r.PendingQty.ToString("N0")</td>
                            <td class="text-end">
                                <div class="progress u-min-width-60px u-height-20px">
                                    <div class="progress-bar @(r.ProgressPct >= 100 ? "bg-success" : r.IsOverdue ? "bg-danger" : "bg-primary")"
                                         data-pct-width="@(Math.Min(r.ProgressPct,100))">
                                        @r.ProgressPct%
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (r.IsOverdue)
                                {
                                    var badgeClass = r.OverdueDays >= 30 ? "bg-danger"
                                                   : r.OverdueDays >= 14 ? "bg-warning text-dark"
                                                   : "bg-secondary";
                                    <span class="badge @badgeClass">@r.OverdueDays @L["Days"]</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", paged)
    }
</div>
