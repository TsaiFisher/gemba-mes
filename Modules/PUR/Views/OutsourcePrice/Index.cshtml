@using SmartFactory.MES.Modules.BAS.Services
@using System.Text.Json
@model SmartFactory.MES.Modules.PUR.ViewModels.OutsourcePriceVm
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    bool searched = ViewBag.Searched == true;
    bool canPrint = ViewBag.CanPrint == true;
    var vm        = Model ?? new();
    var rows      = vm.Rows;
    var monthRows = vm.MonthRows;
    string curSupplier = ViewBag.SearchSupplier as string ?? "";
    string curProduct  = ViewBag.SearchProduct  as string ?? "";
    var supplierOptions = ViewBag.SupplierOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var productOptions  = ViewBag.ProductOptions  as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var currencyDecimals = ViewBag.CurrencyDecimals as IReadOnlyDictionary<string, int>;
    int notComparable = rows.Count(r => !r.IsComparable);
}

<div class="container-fluid py-3">
    <h4 class="mb-3">@L["PageTitle"]</h4>

    <div class="alert alert-secondary py-2 small">
        <i class="bi bi-info-circle me-1"></i>@L["MethodHint"]
    </div>

    @await Html.PartialAsync("_SavedQueries", "OutsourcePrice")

    <form method="get" asp-action="Index" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">@L["FromDate"]</label>
                <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@L["ToDate"]</label>
                <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Supplier"]</label>
                <select name="searchSupplier" class="form-select form-select-sm select2-enable w-100"
                        data-placeholder="@L["AllSuppliers"]" data-allow-clear="true">
                    <option value=""></option>
                    @foreach (var s in supplierOptions)
                    {
                        <option value="@s.CompanyCode" selected="@(curSupplier == (string)s.CompanyCode)">@s.CompanyCode — @s.CompanyName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Product"]</label>
                <select name="searchProduct" class="form-select form-select-sm select2-enable w-100"
                        data-placeholder="@L["AllProducts"]" data-allow-clear="true">
                    <option value=""></option>
                    @foreach (var p in productOptions)
                    {
                        <option value="@p.ProductCode" selected="@(curProduct == (string)p.ProductCode)">@p.ProductCode — @p.ProductName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" name="searched" value="true" class="btn btn-primary w-100 px-4">
                    <i class="bi bi-search"></i> @L["Search"]
                </button>
            </div>
        </div>
    </form>

    @if (!searched)
    {
        <div class="alert alert-info">@L["SearchFirst"]</div>
    }
    else if (!rows.Any())
    {
        <div class="alert alert-warning">@L["NoData"]</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <strong>@L["ResultTitle"]</strong>
                <span class="text-muted ms-1">@rows.Count @L["Lines"]</span>
                @if (notComparable > 0)
                {
                    <span class="badge bg-warning text-dark ms-2" title="@L["NotComparableHint"]">
                        <i class="bi bi-exclamation-triangle me-1"></i>@notComparable @L["NotComparable"]
                    </span>
                }
            </div>
            @if (canPrint)
            {
                <div class="d-flex gap-2">
                    <a asp-action="Export" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate"
                       asp-route-searchSupplier="@curSupplier" asp-route-searchProduct="@curProduct"
                       asp-route-view="month" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-file-earmark-excel"></i> @L["ExportMonthly"]
                    </a>
                    <a asp-action="Export" asp-route-fromDate="@ViewBag.FromDate" asp-route-toDate="@ViewBag.ToDate"
                       asp-route-searchSupplier="@curSupplier" asp-route-searchProduct="@curProduct"
                       asp-route-view="detail" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-file-earmark-excel"></i> @L["ExportExcel"]
                    </a>
                </div>
            }
        </div>

        @if (monthRows.Any())
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header py-2 fw-semibold">@L["MonthlyTrend"]</div>
                <div class="card-body"><canvas id="ospPriceChart" height="90"></canvas></div>
            </div>
        }

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header py-2 fw-semibold">@L["MonthlyTable"]</div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@L["YearMonth"]</th>
                                    <th class="text-end">@L["ReceiptLines"]</th>
                                    <th class="text-end">@L["AvgUnitPrice"]</th>
                                    <th class="text-end">@L["MinUnitPrice"]</th>
                                    <th class="text-end">@L["MaxUnitPrice"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in monthRows)
                                {
                                    <tr>
                                        <td>@m.YearMonth</td>
                                        <td class="text-end">@m.ReceiptLines</td>
                                        <td class="text-end">@m.AvgUnitPriceLocal.ToString("N4")</td>
                                        <td class="text-end text-muted">@m.MinUnitPriceLocal.ToString("N4")</td>
                                        <td class="text-end text-muted">@m.MaxUnitPriceLocal.ToString("N4")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card shadow-sm h-100">
                    <div class="card-header py-2 fw-semibold">@L["DetailTable"]</div>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>@L["Product"]</th>
                                    <th>@L["Supplier"]</th>
                                    <th>@L["ReceiptDate"]</th>
                                    <th>@L["ReceiptId"]</th>
                                    <th class="text-end">@L["ActualUnitPrice"]</th>
                                    <th class="text-end">@L["QuotedUnitPrice"]</th>
                                    <th class="text-end">@L["PriceDiff"]</th>
                                    <th class="text-end">@L["PriceDiffPct"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in rows)
                                {
                                    var cdp = CurrencyStepHelper.GetDp(currencyDecimals, r.CurrencyCode);
                                    <tr>
                                        <td>@r.ProductCode</td>
                                        <td title="@r.SupplierName">@r.SupplierCode</td>
                                        <td>@r.ReceiptDate.ToString("yyyy-MM-dd")</td>
                                        <td>@r.OutsourceReceiptId</td>
                                        <td class="text-end">@r.ActualUnitPrice.ToString("N" + cdp) <span class="text-muted small">@r.CurrencyCode</span></td>
                                        <td class="text-end">
                                            @if (r.QuotedUnitPrice is { } q)
                                            {
                                                <span title="@r.QuotationId">@q.ToString("N" + cdp)</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">@L["NoQuotation"]</span>
                                            }
                                        </td>
                                        @* 不可比的兩種成因（查無報價／幣別不同）都顯示成「—」而不是 0：
                                           顯示 0 會讓「沒報價」看起來像「剛好照報價收」。 *@
                                        <td class="text-end @(r.PriceDiff > 0 ? "text-danger" : r.PriceDiff < 0 ? "text-success" : "")">
                                            @(r.PriceDiff?.ToString("N" + cdp) ?? "—")
                                        </td>
                                        <td class="text-end @(r.PriceDiffPct > 0 ? "text-danger" : r.PriceDiffPct < 0 ? "text-success" : "")">
                                            @(r.PriceDiffPct is { } p ? p.ToString("N1") + "%" : "—")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
@if (searched && monthRows.Any())
{
<script src="~/lib/chart.js/chart.umd.min.js" nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)"></script>
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
(function () {
    const labels = @Html.Raw(JsonSerializer.Serialize(monthRows.Select(m => m.YearMonth)));
    const values = @Html.Raw(JsonSerializer.Serialize(monthRows.Select(m => m.AvgUnitPriceLocal)));
    // 單一序列折線（加權平均單價月趨勢）：單一色相、免圖例，數值以 tooltip 呈現。
    // y 軸刻意不從 0 起（beginAtZero: false）——加工費的變動幅度相對單價本身很小，
    // 從 0 起會把整條線壓成一條直線，看不出趨勢。
    new Chart(document.getElementById('ospPriceChart'), {
        type: 'line',
        data: { labels, datasets: [{
            label: '@L["AvgUnitPrice"]',
            data: values,
            borderColor: 'rgba(13,110,253,0.9)',
            backgroundColor: 'rgba(13,110,253,0.15)',
            fill: true, tension: 0.3, pointRadius: 4,
        }]},
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: {
                y: { beginAtZero: false, grid: { color: 'rgba(0,0,0,0.06)' } },
                x: { grid: { display: false } }
            }
        }
    });
})();
</script>
}
}
