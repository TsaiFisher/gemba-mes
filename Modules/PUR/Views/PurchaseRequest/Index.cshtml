@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Models
@using SmartFactory.MES.Modules.PUR.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Modules.PUR.Models.PurchaseRequest>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL

<link rel="stylesheet" href="~/css/panel-table.css" />

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var canUpdate = ViewBag.CanUpdate as bool? ?? false;
    var canDelete = ViewBag.CanDelete as bool? ?? false;
    var canPrint  = ViewBag.CanPrint  as bool? ?? false;
    bool hasSearched = ViewBag.Searched == true;
    var userNames = ViewBag.UserNames as Dictionary<string, string> ?? new Dictionary<string, string>();

    Func<string, string> sortIcon = col => {
        var cur = ViewBag.CurrentSort as string ?? "";
        if (cur == col + "_asc") return "bi-sort-up";
        if (cur == col + "_desc") return "bi-sort-down";
        return "bi-arrow-down-up opacity-25";
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-file-earmark-text me-2"></i>@Localizer["PageTitle"]</h1>
        @if (canCreate)
        {
            <button type="button" class="btn btn-primary"
                    data-url="@Url.Action("Create", "PurchaseRequest")"
                    data-label="@Localizer["AddEntry"]"
                    data-action="openPanel">
                <i class="bi bi-plus-lg"></i> @Localizer["AddEntry"]
            </button>
        }
    </div>

    <!-- 查詢列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-12 col-md-4">
                    <label class="form-label small">@Localizer["SearchLabel"]</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="@Localizer["SearchPlaceholder"]" value="@ViewBag.SearchTerm" />
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small">@Localizer["DateFrom"]</label>
                    <input type="date" name="dateFrom" class="form-control" value="@(ViewBag.DateFrom?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small">@Localizer["DateTo"]</label>
                    <input type="date" name="dateTo" class="form-control" value="@(ViewBag.DateTo?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">@SL["NoMatchingRecords"]</div>
    }
    else
    {
        <!-- 清單 -->
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-searched="true"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-dateFrom="@ViewBag.DateFrom"
                                   asp-route-dateTo="@ViewBag.DateTo"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-sortOrder="@ViewBag.IdSort"
                                   class="text-decoration-none text-dark">
                                    @Localizer["PurchaseRequestId"] <i class="bi @sortIcon("id")"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-searched="true"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-dateFrom="@ViewBag.DateFrom"
                                   asp-route-dateTo="@ViewBag.DateTo"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-sortOrder="@ViewBag.DateSort"
                                   class="text-decoration-none text-dark">
                                    @Localizer["RequestDate"] <i class="bi @sortIcon("date")"></i>
                                </a>
                            </th>
                            <th>@Localizer["RequestedBy"]</th>
                            <th>@Localizer["LineCount"]</th>
                            <th>@Localizer["Remarks"]</th>
                            <th>@Localizer["ApprovalStatus"]</th>
                            <th>@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pr in Model)
                        {
                            <tr>
                                <td><code>@pr.PurchaseRequestId</code></td>
                                <td>@pr.RequestDate.ToString("yyyy-MM-dd")</td>
                                <td>@(userNames.TryGetValue(pr.RequestedBy, out var uname) ? uname : pr.RequestedBy)</td>
                                <td>@pr.Lines.Count</td>
                                <td class="text-muted small">@pr.Remarks</td>
                                <td><span class="badge @ApprovalBadge(pr.ApprovalStatus)">@DocStatusLabels.Label(pr.ApprovalStatus)</span></td>
                                <td>
                                    @if (canPrint)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary me-1"
                                           href="@Url.Action("Print","PurchaseRequest", new { id = pr.PurchaseRequestId })"
                                           target="_blank"><i class="bi bi-printer"></i> @Localizer["Print"]</a>
                                    }
                                    @if (canUpdate)
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                data-url="@Url.Action("Edit","PurchaseRequest", new { id = pr.PurchaseRequestId })"
                                                data-label="@Localizer["EditTitle", pr.PurchaseRequestId]"
                                                data-action="openPanel">
                                            <i class="bi bi-pencil"></i> @Localizer["Edit"]
                                        </button>
                                    }
                                    @if (canDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                data-action="deleteItem" data-url="@Url.Action("Delete", "PurchaseRequest")" data-id="@pr.PurchaseRequestId">
                                            <i class="bi bi-trash"></i> @Localizer["Delete"]
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 分頁 -->
        @await Html.PartialAsync("_Pagination", Model)
    }
</div>

<!-- Side Panel offcanvas -->
<div class="offcanvas offcanvas-end u-panel-wide" tabindex="-1" id="sidePanel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="sidePanelLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body" id="sidePanelBody"></div>
</div>

<!-- Success Toast -->
<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@Localizer["SaveSuccess"]</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_CrudPanelScripts")
}

@functions {
    string ApprovalBadge(DocumentApprovalStatus s) => s switch {
        DocumentApprovalStatus.Approved => "bg-success",
        DocumentApprovalStatus.PendingApproval => "bg-warning text-dark",
        DocumentApprovalStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}
