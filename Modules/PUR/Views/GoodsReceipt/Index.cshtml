@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Models
@using SmartFactory.MES.Modules.PUR.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Modules.PUR.Models.GoodsReceipt>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL

<link rel="stylesheet" href="~/css/panel-table.css" />

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var canUpdate = ViewBag.CanUpdate as bool? ?? false;
    var canDelete = ViewBag.CanDelete as bool? ?? false;
    var canPrint  = ViewBag.CanPrint  as bool? ?? false;
    bool hasSearched = ViewBag.Searched == true;

    Func<string, string> sortIcon = col => {
        var cur = ViewBag.CurrentSort as string ?? "";
        if (cur == col + "_asc") return "bi-sort-up";
        if (cur == col + "_desc") return "bi-sort-down";
        return "bi-arrow-down-up opacity-25";
    };

    var supplierOptions = ViewBag.SupplierOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    int baseDp = ViewBag.BaseCurrencyDp as int? ?? 2;
    string moneyFmt = baseDp <= 0 ? "N0" : $"N{baseDp}";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-box-arrow-in-down me-2"></i>@Localizer["PageTitle"]</h1>
        @if (canCreate)
        {
            <button type="button" class="btn btn-primary"
                    data-url="@Url.Action("Create", "GoodsReceipt")"
                    data-label="@Localizer["AddEntry"]"
                    data-action="openPanel">
                <i class="bi bi-plus-lg"></i> @Localizer["AddEntry"]
            </button>
        }
    </div>

    <!-- 查詢列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-12 col-md-3">
                    <label class="form-label small">@Localizer["SearchLabel"]</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="@Localizer["SearchPlaceholder"]" value="@ViewBag.SearchTerm" />
                    </div>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small">@Localizer["SupplierCode"]</label>
                    <select name="supplierCode" class="form-select">
                        <option value="">-- @Localizer["AllSuppliers"] --</option>
                        @foreach (var s in supplierOptions)
                        {
                            <option value="@s.CompanyCode" selected="@(ViewBag.SupplierCode == (string)s.CompanyCode)">
                                @s.CompanyCode - @s.CompanyName
                            </option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small">@Localizer["DateFrom"]</label>
                    <input type="date" name="dateFrom" class="form-control" value="@(ViewBag.DateFrom?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small">@Localizer["DateTo"]</label>
                    <input type="date" name="dateTo" class="form-control" value="@(ViewBag.DateTo?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">@SL["NoMatchingRecords"]</div>
    }
    else
    {
        <!-- 清單 -->
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-searched="true"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-supplierCode="@ViewBag.SupplierCode"
                                   asp-route-dateFrom="@ViewBag.DateFrom"
                                   asp-route-dateTo="@ViewBag.DateTo"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-sortOrder="@ViewBag.IdSort"
                                   class="text-decoration-none text-dark">
                                    @Localizer["GoodsReceiptId"] <i class="bi @sortIcon("id")"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-searched="true"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-supplierCode="@ViewBag.SupplierCode"
                                   asp-route-dateFrom="@ViewBag.DateFrom"
                                   asp-route-dateTo="@ViewBag.DateTo"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-sortOrder="@ViewBag.DateSort"
                                   class="text-decoration-none text-dark">
                                    @Localizer["ReceiptDate"] <i class="bi @sortIcon("date")"></i>
                                </a>
                            </th>
                            <th>@Localizer["SupplierCode"]</th>
                            <th>@Localizer["TotalAmount"]</th>
                            <th>@Localizer["LineCount"]</th>
                            <th>@Localizer["Remarks"]</th>
                            <th>@Localizer["Status"]</th>
                            <th>@Localizer["ApprovalStatus"]</th>
                            <th>@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gr in Model)
                        {
                            <tr>
                                <td><code>@gr.GoodsReceiptId</code></td>
                                <td>@gr.ReceiptDate.ToString("yyyy-MM-dd")</td>
                                <td>@gr.SupplierCode</td>
                                <td class="text-end">@gr.TotalAmount.ToString(moneyFmt)</td>
                                <td>@gr.Lines.Count</td>
                                <td class="text-muted small">@gr.Remarks</td>
                                <td><span class="badge @StatusBadge(gr.Status)">@DocStatusLabels.Label(gr.Status)</span></td>
                                <td><span class="badge @ApprovalBadge(gr.ApprovalStatus)">@DocStatusLabels.Label(gr.ApprovalStatus)</span></td>
                                <td>
                                    @if (canPrint)
                                    {
                                        <a class="btn btn-sm btn-outline-secondary me-1"
                                           href="@Url.Action("Print","GoodsReceipt", new { id = gr.GoodsReceiptId })"
                                           target="_blank"><i class="bi bi-printer"></i> @Localizer["Print"]</a>
                                    }
                                    @if (canUpdate)
                                    {
                                        <button class="btn btn-sm btn-outline-primary me-1"
                                                data-url="@Url.Action("Edit","GoodsReceipt", new { id = gr.GoodsReceiptId })"
                                                data-label="@Localizer["EditTitle", gr.GoodsReceiptId]"
                                                data-action="openPanel">
                                            <i class="bi bi-pencil"></i> @Localizer["Edit"]
                                        </button>
                                    }
                                    @if (canDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                data-action="deleteItem" data-url="@Url.Action("Delete", "GoodsReceipt")" data-id="@gr.GoodsReceiptId">
                                            <i class="bi bi-trash"></i> @Localizer["Delete"]
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 分頁 -->
        @await Html.PartialAsync("_Pagination", Model)
    }
</div>

<!-- Side Panel offcanvas -->
<div class="offcanvas offcanvas-end u-panel-wide" tabindex="-1" id="sidePanel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="sidePanelLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body" id="sidePanelBody"></div>
</div>

<!-- Success Toast -->
<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@Localizer["SaveSuccess"]</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_CrudPanelScripts")
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    function confirmDoc(e, el) {
        const id = el.dataset.id, controller = el.dataset.controller;
        if (!confirm('@Localizer["ConfirmDocPrompt"]')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        fetch(`/${controller}/Confirm/${encodeURIComponent(id)}`, {
            method: 'POST', headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' }
        }).then(async r => {
            const d = await r.json().catch(() => ({ success: false, message: @(Json.Serialize(SL["ServerNoResponse"].Value)) }));
            if (d.success) { hidePanel(); toastSuccess(); setTimeout(() => location.reload(), 800); }
            else alert(d.message || '@Localizer["ConfirmFailed"]');
        }).catch(() => alert('@Localizer["ConfirmFailed"]'));
    }
    function cancelConfirmDoc(e, el) {
        const id = el.dataset.id, controller = el.dataset.controller;
        if (!confirm('@Localizer["UnconfirmPrompt"]')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        fetch(`/${controller}/CancelConfirm/${encodeURIComponent(id)}`, {
            method: 'POST', headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' }
        }).then(async r => {
            const d = await r.json().catch(() => ({ success: false, message: @(Json.Serialize(SL["ServerNoResponse"].Value)) }));
            if (d.success) { hidePanel(); toastSuccess(); setTimeout(() => location.reload(), 800); }
            else alert(d.message || '@Localizer["UnconfirmFailed"]');
        }).catch(() => alert('@Localizer["UnconfirmFailed"]'));
    }
    function voidDoc(e, el) {
        const id = el.dataset.id, controller = el.dataset.controller;
        const reason = prompt(@(Json.Serialize(SL["VoidReasonPrompt"].Value)), '');
        if (reason === null) return;
        if (!confirm('@Localizer["VoidPrompt"]')) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        const form = new FormData();
        if (reason) form.append('reason', reason);
        fetch(`/${controller}/Void/${encodeURIComponent(id)}`, {
            method: 'POST', body: form,
            headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' }
        }).then(async r => {
            const d = await r.json().catch(() => ({ success: false, message: @(Json.Serialize(SL["ServerNoResponse"].Value)) }));
            if (d.success) { hidePanel(); toastSuccess(); setTimeout(() => location.reload(), 800); }
            else alert(d.message || '@Localizer["VoidFailed"]');
        }).catch(() => alert('@Localizer["VoidFailed"]'));
    }

</script>
}

@functions {
    string StatusBadge(DocStatus s) => s switch {
        DocStatus.Draft => "bg-secondary",
        DocStatus.Confirmed => "bg-info text-dark",
        DocStatus.Posted => "bg-success",
        DocStatus.Void => "bg-danger",
        _ => "bg-secondary"
    };
    string ApprovalBadge(DocumentApprovalStatus s) => s switch {
        DocumentApprovalStatus.Approved => "bg-success",
        DocumentApprovalStatus.PendingApproval => "bg-warning text-dark",
        DocumentApprovalStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}
