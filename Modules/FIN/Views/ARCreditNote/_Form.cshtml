@using SmartFactory.MES.Modules.BAS.Services
@inject SmartFactory.MES.Modules.BAS.Services.IDisplayPrecision Precision
@model SmartFactory.MES.Modules.FIN.Models.ARCreditNote
@using SmartFactory.MES.Modules.FIN.Models
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> L

@{
    var moneyFmt         = await Precision.BaseMoneyFormatAsync();
    bool canUpdate = ViewBag.CanUpdate == true;
}

<div class="p-3">
<fieldset disabled="disabled">
<div class="row g-2 mb-3">
    <div class="col-6">
        <label class="form-label small fw-semibold">@L["ARCreditNoteId"]</label>
        <input type="text" class="form-control form-control-sm" value="@Model.ARCreditNoteId" readonly />
    </div>
    <div class="col-6">
        <label class="form-label small fw-semibold">@L["CustomerCode"]</label>
        <input type="text" class="form-control form-control-sm" value="@Model.CustomerCode" readonly />
    </div>
    <div class="col-4">
        <label class="form-label small fw-semibold">@L["NoteDate"]</label>
        <input type="text" class="form-control form-control-sm" value="@Model.NoteDate.ToString("yyyy-MM-dd")" readonly />
    </div>
    <div class="col-4">
        <label class="form-label small fw-semibold">@L["Status"]</label>
        <input type="text" class="form-control form-control-sm" value="@FinEnumDisplay.Text(L, Model.Status)" readonly />
    </div>
    <div class="col-4">
        <label class="form-label small fw-semibold">@L["SourceDocId"]</label>
        <input type="text" class="form-control form-control-sm" value="@Model.SourceDocId" readonly />
    </div>
    <div class="col-4">
        <label class="form-label small fw-semibold">@L["TotalAmount"]</label>
        <input type="text" class="form-control form-control-sm text-end" value="@Model.TotalAmount.ToString(moneyFmt)" readonly />
    </div>
    <div class="col-4">
        <label class="form-label small fw-semibold">@L["TaxAmount"]</label>
        <input type="text" class="form-control form-control-sm text-end" value="@Model.TaxAmount.ToString(moneyFmt)" readonly />
    </div>
    <div class="col-4">
        <label class="form-label small fw-semibold">@L["AmountLocal"]</label>
        <input type="text" class="form-control form-control-sm text-end" value="@Model.AmountLocal.ToString(moneyFmt)" readonly />
    </div>
    <div class="col-12">
        <label class="form-label small fw-semibold">@L["Remarks"]</label>
        <input type="text" class="form-control form-control-sm" value="@Model.Remarks" readonly />
    </div>
</div>
</fieldset>

@if (Model.Lines.Any())
{
    <h6 class="fw-semibold mt-3 mb-2">@L["Detail"]</h6>
    <div class="table-responsive">
    <table class="table table-sm table-bordered mb-0">
        <thead class="table-light">
            <tr>
                <th>@L["LineNo"]</th>
                <th class="u-col-code">@L["ARInvoiceId"]</th>
                <th class="u-col-code">@L["ProductCode"]</th>
                <th class="text-end u-col-num">@L["Qty"]</th>
                <th class="text-end u-col-num">@L["UnitPrice"]</th>
                <th class="text-end u-col-num">@L["LineAmount"]</th>
                <th class="text-end u-col-num">@L["TaxAmount"]</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
        {
            <tr>
                <td>@l.LineNo</td>
                <td><code>@l.ARInvoiceId</code> <span class="text-muted small">#@l.InvoiceLineNo</span></td>
                <td>@l.ProductCode</td>
                <td class="text-end">@l.Qty.ToString("N4")</td>
                <td class="text-end">@l.UnitPrice.ToString(moneyFmt)</td>
                <td class="text-end">@l.LineAmount.ToString(moneyFmt)</td>
                <td class="text-end">@l.TaxAmount.ToString(moneyFmt)</td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

<div class="mt-3 d-flex gap-2">
    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="offcanvas">@L["Close"]</button>
    @if (canUpdate && Model.Status == CreditNoteStatus.Draft)
    {
        <button type="button" class="btn btn-primary btn-sm" data-action="confirmNote" data-id="@Model.ARCreditNoteId">
            <i class="bi bi-check2-circle me-1"></i>@L["Confirm"]
        </button>
    }
    @if (canUpdate && Model.Status != CreditNoteStatus.Void)
    {
        <button type="button" class="btn btn-outline-danger btn-sm" data-action="voidNote" data-id="@Model.ARCreditNoteId">
            <i class="bi bi-x-circle me-1"></i>@L["Void"]
        </button>
    }
</div>
</div><!-- /p-3 -->
