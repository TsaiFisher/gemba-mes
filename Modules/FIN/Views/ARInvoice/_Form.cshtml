@using SmartFactory.MES.Modules.BAS.Services
@inject SmartFactory.MES.Modules.BAS.Services.IDisplayPrecision Precision
@model SmartFactory.MES.Modules.FIN.Models.ARInvoice
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> L
@{
    var moneyFmt         = await Precision.BaseMoneyFormatAsync();
    bool isReadOnly = ViewBag.IsReadOnly == true;
}
<div class="p-3">
<fieldset @(isReadOnly ? Html.Raw("disabled=\"disabled\"") : Html.Raw(""))>
<div class="row g-2 mb-3">
    <div class="col-6"><label class="form-label small fw-semibold">@L["ARInvoiceId"]</label>
        <input class="form-control form-control-sm" value="@Model.ARInvoiceId" readonly /></div>
    <div class="col-6"><label class="form-label small fw-semibold">@L["CustomerCode"]</label>
        <input class="form-control form-control-sm" value="@Model.CustomerCode" readonly /></div>
    <div class="col-4"><label class="form-label small fw-semibold">@L["InvoiceDate"]</label>
        <input class="form-control form-control-sm" value="@Model.InvoiceDate.ToString("yyyy-MM-dd")" readonly /></div>
    <div class="col-4"><label class="form-label small fw-semibold">@L["DueDate"]</label>
        <input class="form-control form-control-sm" value="@Model.DueDate.ToString("yyyy-MM-dd")" readonly /></div>
    <div class="col-4"><label class="form-label small fw-semibold">@L["Status"]</label>
        <input class="form-control form-control-sm" value="@FinEnumDisplay.Text(L, Model.Status)" readonly /></div>
    <div class="col-4"><label class="form-label small fw-semibold">@L["TotalAmount"]</label>
        <input class="form-control form-control-sm text-end" value="@Model.TotalAmount.ToString(moneyFmt)" readonly /></div>
    <div class="col-4"><label class="form-label small fw-semibold">@L["ReceivedAmount"]</label>
        <input class="form-control form-control-sm text-end" value="@Model.ReceivedAmount.ToString(moneyFmt)" readonly /></div>
    <div class="col-4"><label class="form-label small fw-semibold">@L["AmountLocal"]</label>
        <input class="form-control form-control-sm text-end" value="@Model.AmountLocal.ToString(moneyFmt)" readonly /></div>
</div>
</fieldset>
@if (Model.Lines.Any())
{
    <h6 class="fw-semibold mt-3 mb-2">@L["Detail"]</h6>
    <table class="table table-sm table-bordered mb-0">
        <thead class="table-light"><tr>
            <th>@L["LineNo"]</th><th class="u-col-code">@L["ProductCode"]</th>
            <th class="text-end u-col-num">@L["Qty"]</th><th class="text-end u-col-num">@L["UnitPrice"]</th>
            <th class="text-end u-col-num">@L["LineAmount"]</th><th class="text-end u-col-num">@L["TaxAmount"]</th>
        </tr></thead>
        <tbody>
        @foreach (var l in Model.Lines.OrderBy(x => x.LineNo))
        {
            <tr>
                <td>@l.LineNo</td><td>@l.ProductCode</td>
                <td class="text-end">@l.Qty.ToString("N4")</td>
                <td class="text-end">@l.UnitPrice.ToString(moneyFmt)</td>
                <td class="text-end">@l.LineAmount.ToString(moneyFmt)</td>
                <td class="text-end">@l.TaxAmount.ToString(moneyFmt)</td>
            </tr>
        }
        </tbody>
    </table>
}
@if (isReadOnly)
{
    <div class="mt-3">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="offcanvas">@L["Close"]</button>
    </div>
}
</div><!-- /p-3 -->
