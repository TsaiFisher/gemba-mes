@using SmartFactory.MES.Modules.BAS.Services
@inject SmartFactory.MES.Modules.BAS.Services.IDisplayPrecision Precision
@model SmartFactory.MES.Modules.FIN.Models.ARReceipt
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> L
@{
    var moneyFmt         = await Precision.BaseMoneyFormatAsync();
    bool isReadOnly = ViewBag.IsReadOnly == true;
}

<div class="p-3">
<fieldset @(isReadOnly ? Html.Raw("disabled=\"disabled\"") : Html.Raw(""))>
<div class="row g-2">
    <div class="col-6"><label class="form-label small fw-semibold">@L["ARReceiptId"]</label>
        <input class="form-control form-control-sm" value="@Model.ARReceiptId" readonly /></div>
    <div class="col-6"><label class="form-label small fw-semibold">@L["CustomerCode"]</label>
        <input class="form-control form-control-sm" value="@Model.CustomerCode" readonly /></div>
    <div class="col-4"><label class="form-label small fw-semibold">@L["ReceiptDate_Fin"]</label>
        <input class="form-control form-control-sm" value="@Model.ReceiptDate.ToString("yyyy-MM-dd")" readonly /></div>
    <div class="col-4"><label class="form-label small fw-semibold">@L["PaymentMethod"]</label>
        <input class="form-control form-control-sm" value="@FinEnumDisplay.Text(L, Model.Method)" readonly /></div>
    <div class="col-4"><label class="form-label small fw-semibold">@L["Status"]</label>
        <input class="form-control form-control-sm" value="@FinEnumDisplay.Text(L, Model.Status)" readonly /></div>
    <div class="col-6"><label class="form-label small fw-semibold">@L["AmountLocal"]</label>
        <input class="form-control form-control-sm text-end" value="@Model.AmountLocal.ToString(moneyFmt)" readonly /></div>
</div>
</fieldset>

@if (Model.Allocations.Any())
{
    <h6 class="fw-semibold mt-3 mb-2">@L["AllocationDetail"]</h6>
    <table class="table table-sm table-bordered mb-0">
        <thead class="table-light"><tr><th>@L["InvoiceNo"]</th><th class="text-end">@L["AllocAmt"]</th></tr></thead>
        <tbody>
        @foreach (var a in Model.Allocations)
        { <tr><td>@a.ARInvoiceId</td><td class="text-end">@a.AllocatedAmount.ToString(moneyFmt)</td></tr> }
        </tbody>
    </table>
}
@if (isReadOnly)
{ <div class="mt-3"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="offcanvas">@L["Close"]</button></div> }
</div><!-- /p-3 -->
