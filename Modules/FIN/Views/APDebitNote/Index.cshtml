@using SmartFactory.MES.Modules.BAS.Services
@inject SmartFactory.MES.Modules.BAS.Services.IDisplayPrecision Precision
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Modules.FIN.Models.APDebitNote>

<link rel="stylesheet" href="~/css/panel-table.css" />
@using SmartFactory.MES.Modules.FIN.Models
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> L

@{
    var moneyFmt         = await Precision.BaseMoneyFormatAsync();
    ViewData["Title"] = L["APDebitNote"];
    bool canUpdate      = ViewBag.CanUpdate == true;
    bool hasSearched    = ViewBag.Searched as bool? ?? false;
    int  curPageSize    = ViewBag.CurrentPageSize as int? ?? 20;
    string curSupplier  = ViewBag.SearchSupplier as string ?? "";
    var supplierOptions = ViewBag.SupplierOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var supplierNames   = ViewBag.SupplierNames as IReadOnlyDictionary<string, string>;

    string SortIcon(string f) {
        var s = (string?)ViewBag.SortOrder ?? "";
        return s == f + "_asc" ? "bi-sort-up" : s == f + "_desc" ? "bi-sort-down" : "bi-arrow-down-up opacity-25";
    }
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-arrow-return-left me-2"></i>@L["APDebitNote"]</h1>
    </div>

    @* 這張單沒有「新增」：每一個數字都來自退貨單，由退貨過帳當下自動產生草稿。
       手鍵會折出與退貨量對不上的金額，而那正是關帳稽核在比的東西。 *@
    <div class="alert alert-light border small text-muted">
        <i class="bi bi-info-circle me-1"></i>@L["CreditNoteAutoGeneratedHint"]
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />
                <div class="col-12 col-md-3">
                    <label class="form-label small">@L["SupplierCode"]</label>
                    <select name="searchSupplier" class="form-select form-select-sm select2-enable w-100"
                            data-placeholder="@L["All"]" data-allow-clear="true">
                        <option value=""></option>
                        @foreach (var c in supplierOptions)
                        {
                            <option value="@c.CompanyCode" selected="@(curSupplier == (string)c.CompanyCode)">@c.CompanyCode — @c.CompanyName</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label small">@L["Status"]</label>
                    <select name="searchStatus" class="form-select">
                        <option value="">@L["All"]</option>
                        @foreach (CreditNoteStatus s in Enum.GetValues<CreditNoteStatus>())
                        { <option value="@s" selected="@(ViewBag.SearchStatus?.ToString() == s.ToString())">@FinEnumDisplay.Text(L, s)</option> }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@L["Search"]</button>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@L["SearchFirst"]
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">@L["NoData"]</div>
    }
    else
    {
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@L["APDebitNoteId"]</th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewBag.SupplierSort" asp-route-searched="true"
                               asp-route-searchSupplier="@ViewBag.SearchSupplier" asp-route-searchStatus="@ViewBag.SearchStatus"
                               asp-route-pageSize="@curPageSize" class="text-decoration-none text-dark">
                                @L["SupplierCode"] <i class="bi @SortIcon("supplier")"></i>
                            </a>
                        </th>
                        <th>
                            <a asp-action="Index" asp-route-sortOrder="@ViewBag.DateSort" asp-route-searched="true"
                               asp-route-searchSupplier="@ViewBag.SearchSupplier" asp-route-searchStatus="@ViewBag.SearchStatus"
                               asp-route-pageSize="@curPageSize" class="text-decoration-none text-dark">
                                @L["NoteDate"] <i class="bi @SortIcon("date")"></i>
                            </a>
                        </th>
                        <th class="text-end">
                            <a asp-action="Index" asp-route-sortOrder="@ViewBag.AmountSort" asp-route-searched="true"
                               asp-route-searchSupplier="@ViewBag.SearchSupplier" asp-route-searchStatus="@ViewBag.SearchStatus"
                               asp-route-pageSize="@curPageSize" class="text-decoration-none text-dark">
                                @L["TotalAmount"] <i class="bi @SortIcon("amount")"></i>
                            </a>
                        </th>
                        <th>@L["Status"]</th>
                        <th>@L["SourceDocId"]</th>
                        <th>@L["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var n in Model)
                {
                    var badgeCls = n.Status switch {
                        CreditNoteStatus.Posted => "bg-success",
                        CreditNoteStatus.Void   => "bg-secondary",
                        _                       => "bg-warning text-dark"
                    };
                    <tr>
                        <td><code>@n.APDebitNoteId</code></td>
                        <td>
                            @n.SupplierCode
                            @if (supplierNames != null && supplierNames.TryGetValue(n.SupplierCode, out var cn))
                            { <span class="text-muted small">— @cn</span> }
                        </td>
                        <td>@n.NoteDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@n.TotalAmount.ToString(moneyFmt)</td>
                        <td><span class="badge @badgeCls">@FinEnumDisplay.Text(L, n.Status)</span></td>
                        <td class="text-muted small">@n.SourceDocId</td>
                        <td>
                            @await Html.PartialAsync("_PrintButton", Url.Action("Print", new { id = n.APDebitNoteId }))
                            <button class="btn btn-sm btn-outline-secondary me-1"
                                    data-url="/APDebitNote/Details/@n.APDebitNoteId" data-label="@n.APDebitNoteId"
                                    data-action="openPanel"><i class="bi bi-eye"></i> @L["View"]</button>
                            @if (canUpdate && n.Status == CreditNoteStatus.Draft)
                            {
                                <button class="btn btn-sm btn-outline-primary me-1" data-action="confirmNote" data-id="@n.APDebitNoteId"><i class="bi bi-check2-circle"></i> @L["Confirm"]</button>
                            }
                            @if (canUpdate && n.Status != CreditNoteStatus.Void)
                            {
                                <button class="btn btn-sm btn-outline-danger" data-action="voidNote" data-id="@n.APDebitNoteId"><i class="bi bi-x-circle"></i> @L["Void"]</button>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_Pagination", Model)
    }

</div>

@Html.AntiForgeryToken()

<div class="offcanvas offcanvas-end shadow-lg u-panel-wide" tabindex="-1" id="sidePanel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="sidePanelLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0" id="sidePanelBody"></div>
</div>

<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@L["SaveSuccess"]</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_CrudPanelScripts")
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    function postNoteAction(url, confirmKey, failKey) {
        if (!confirm(window.i18n.t(confirmKey))) return;
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        fetch(url, { method: 'POST', headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' } })
            .then(async r => {
                const d = await r.json().catch(() => ({ success: false, message: window.i18n.t(failKey) }));
                if (d.success) { window.toastSuccess && window.toastSuccess(); setTimeout(() => location.reload(), 800); }
                else alert(d.message || window.i18n.t(failKey));
            }).catch(() => alert(window.i18n.t(failKey)));
    }
    function confirmNote(e, el) {
        postNoteAction(`/APDebitNote/Confirm/${el.dataset.id}`, 'ConfirmPostCreditNote', 'PostFailed');
    }
    function voidNote(e, el) {
        postNoteAction(`/APDebitNote/Void/${el.dataset.id}`, 'ConfirmVoidCreditNote', 'VoidFailed');
    }
</script>
}
