@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Models
@using SmartFactory.MES.Modules.BAS.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Modules.BAS.Models.WorkCenter>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var canUpdate = ViewBag.CanUpdate as bool? ?? false;
    var canDelete = ViewBag.CanDelete as bool? ?? false;
    bool hasSearched = ViewBag.Searched == true;
    var deptNames       = ViewBag.DeptNames       as Dictionary<string, string> ?? new Dictionary<string, string>();
    var shiftGroupNames = ViewBag.ShiftGroupNames as Dictionary<string, string> ?? new Dictionary<string, string>();

    Func<string, string> sortIcon = col => {
        var cur = ViewBag.CurrentSort as string ?? "";
        if (cur == col + "_asc") return "bi-sort-up";
        if (cur == col + "_desc") return "bi-sort-down";
        return "bi-arrow-down-up opacity-25";
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-building-gear"></i> @Localizer["PageTitle"]</h1>
        @if (canCreate)
        {
            <button type="button" class="btn btn-primary"
                    data-url="@Url.Action("Create", "WorkCenter")"
                    data-label="@Localizer["AddEntry"]"
                    data-action="openPanel">
                <i class="bi bi-plus-lg"></i> @Localizer["AddEntry"]
            </button>
        }
    </div>

    <!-- 查詢列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-12 col-md-auto flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="@Localizer["SearchPlaceholder"]" value="@ViewBag.SearchTerm" />
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                        {
                            <a asp-action="Index" asp-route-searched="true"
                               asp-route-pageSize="@ViewBag.CurrentPageSize"
                               class="btn btn-outline-secondary bg-white text-muted">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                        @if (ViewBag.CanPrint as bool? ?? false)
                        {
                            <button type="button" class="btn btn-outline-info ms-2" data-action="printPage">
                                <i class="bi bi-printer"></i> @Localizer["Print"]
                            </button>
                            <div class="btn-group ms-1">
                                <a asp-action="Export" asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-format="xlsx" class="btn btn-outline-success">
                                    <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
                                </a>
                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split"
                                        data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-format="csv">
                                        <i class="bi bi-filetype-csv me-2"></i>@Localizer["ExportCsv"]</a></li>
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-format="json">
                                        <i class="bi bi-filetype-json me-2"></i>@Localizer["ExportJson"]</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.CodeSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["WorkCenterCode"] <i class="bi @sortIcon("code")"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["WorkCenterName"] <i class="bi @sortIcon("name")"></i>
                                </a>
                            </th>
                            <th>@Localizer["DepartmentId"]</th>
                            <th>@Localizer["ShiftGroupCode"]</th>
                            <th>@Localizer["IsProductionLine"]</th>
                            <th>@Localizer["AdditionalRate"]</th>
                            <th>@Localizer["StandardLaborCost"]</th>
                            <th>@Localizer["MachineHourlyRate"]</th>
                            <th>@Localizer["IsActive"]</th>
                            <th class="text-end pe-4">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr><td colspan="10" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>@Localizer["NoData"]
                            </td></tr>
                        }
                        else
                        {
                            foreach (var t in Model)
                            {
                                <tr>
                                    <td class="fw-medium">@t.WorkCenterCode</td>
                                    <td>@t.WorkCenterName</td>
                                    <td class="text-muted small">@(t.DepartmentId != null && deptNames.TryGetValue(t.DepartmentId, out var _dn) ? _dn : t.DepartmentId)</td>
                                    <td class="text-muted small">@(t.ShiftGroupCode != null && shiftGroupNames.TryGetValue(t.ShiftGroupCode, out var _sn) ? $"{t.ShiftGroupCode} — {_sn}" : t.ShiftGroupCode)</td>
                                    <td>
                                        @if (t.IsProductionLine)
                                        {
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle text-secondary"></i>
                                        }
                                    </td>
                                    <td>@t.AdditionalRate</td>
                                    <td>@t.StandardLaborCost</td>
                                    <td>@t.MachineHourlyRate</td>
                                    <td>
                                        @if (t.IsActive)
                                        {
                                            <span class="badge bg-success">@Localizer["Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        data-url="@Url.Action("Edit", "WorkCenter", new { workCenterCode = t.WorkCenterCode })"
                                                        data-label="@($"{Localizer["Edit"].Value}：{t.WorkCenterName}")"
                                                        data-action="openPanel"><i class="bi bi-pencil"></i> @Localizer["Edit"]</button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-url="@Url.Action("Delete", "WorkCenter", new { workCenterCode = t.WorkCenterCode })"
                                                        data-id="@t.WorkCenterName"
                                                        data-action="deleteItem"><i class="bi bi-trash"></i> @Localizer["Delete"]</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @await Html.PartialAsync("_Pagination", Model)
    }
</div>

<!-- Side Panel -->
<div class="offcanvas offcanvas-end shadow-lg u-width-min-520px-95vw" id="crudPanel" tabindex="-1"
     aria-labelledby="crudPanelLabel">
    <div class="offcanvas-header border-bottom bg-primary text-white py-3">
        <h5 class="offcanvas-title mb-0" id="crudPanelTitle"></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body" id="crudPanelBody"></div>
</div>

<!-- Success Toast -->
<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i><span id="successToastMsg"></span></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- Anti-Forgery for AJAX delete -->
<form class="u-display-none" id="__AjaxAntiForgery">@Html.AntiForgeryToken()</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/module-validation.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_JsLocalization")
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    function openPanel(e, el) {
        const url = el.dataset.url, title = el.dataset.label;
        document.getElementById('crudPanelTitle').textContent = title;
        const body = document.getElementById('crudPanelBody');
        body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted small">' + @(Json.Serialize(SL["Loading"].Value)) + '</p></div>';
        new bootstrap.Offcanvas(document.getElementById('crudPanel')).show();
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(html => { body.innerHTML = DOMPurify.sanitize(html); bindPanelForms(); })
            .catch(() => { body.innerHTML = '<div class="alert alert-danger m-3">' + @(Json.Serialize(SL["LoadFailed"].Value)) + '</div>'; });
    }

    function bindPanelForms() {
        document.querySelectorAll('#crudPanelBody form[data-ajax="true"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                submitPanel(this);
            });
        });
        document.querySelectorAll('#crudPanelBody [data-dismiss-panel]').forEach(btn => {
            btn.addEventListener('click', () =>
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel'))?.hide());
        });
        bindMachineTable();
        bindStagingWarehouse();
    }

    // 預設備料倉 ↔ 備料儲位連動（ProjectZ 倉庫/儲位欄位規則）：
    // 選倉庫 → 儲位清單過濾；選儲位而倉庫空 → 回填倉庫；清空倉庫 → 一併清空儲位
    // （重建 innerHTML 後舊選項仍在清單中，瀏覽器不會自動重設，必須明確設成 ""）。
    function bindStagingWarehouse() {
        const panel   = document.getElementById('crudPanelBody');
        const section = panel.querySelector('#wcStagingSection');
        const whSel   = panel.querySelector('#wcStagingWh');
        const locSel  = panel.querySelector('#wcStagingLoc');
        if (!section || !whSel || !locSel) return;

        let allLocations = [];
        try { allLocations = JSON.parse(section.dataset.locations || '[]'); } catch { allLocations = []; }

        function buildLocOpts(whCode) {
            const list = whCode ? allLocations.filter(l => l.whCode === whCode) : allLocations;
            return '<option value=""></option>' + list.map(l => {
                const name = l.locationName ? ' — ' + l.locationName : '';
                return `<option value="${l.locationCode}">${l.locationCode}${name}</option>`;
            }).join('');
        }

        whSel.addEventListener('change', function () {
            const prev = locSel.value;
            locSel.innerHTML = buildLocOpts(this.value);
            locSel.value = (this.value && prev &&
                allLocations.find(l => l.locationCode === prev && l.whCode === this.value)) ? prev : "";
        });

        locSel.addEventListener('change', function () {
            if (!this.value || whSel.value) return;
            const loc = allLocations.find(l => l.locationCode === this.value);
            if (!loc) return;
            whSel.value = loc.whCode;
            this.innerHTML = buildLocOpts(loc.whCode);
            this.value = loc.locationCode;
        });
    }

    function bindMachineTable() {
        const panel = document.getElementById('crudPanelBody');
        const chk = panel.querySelector('#wcIsProductionLine');
        const sec = panel.querySelector('#machinesSection');
        const tbody = panel.querySelector('#machineRows');
        const btnAdd = panel.querySelector('#btnAddMachine');
        if (!sec || !tbody) return;

        const statusOptions = [
            { value: 'Available',      label: sec.dataset.labelAvailable      || 'Available' },
            { value: 'Standby',        label: sec.dataset.labelStandby        || 'Standby' },
            { value: 'ExternalRepair', label: sec.dataset.labelExternalrepair || 'External Repair' },
            { value: 'BreakDown',      label: sec.dataset.labelBreakdown      || 'Breakdown' },
            { value: 'Modification',   label: sec.dataset.labelModification   || 'Modification' },
            { value: 'Loaned',         label: sec.dataset.labelLoaned         || 'Loaned' },
            { value: 'Retired',        label: sec.dataset.labelRetired        || 'Retired' },
            { value: 'Maintenance',    label: sec.dataset.labelMaintenance    || 'Maintenance' }
        ];

        // 生產線工作中心的第二頁籤改掛「生產線別」（每筆＝一條線，排程視為平行資源），
        // 不再停用頁籤——只依勾選狀態切換顯示文字。
        function toggleMachineLabels(isProductionLine) {
            const set = (id, label) => {
                const el = panel.querySelector('#' + id);
                if (el && label) el.textContent = label;
            };
            set('wcMachineTabLabel',      isProductionLine ? sec.dataset.labelLinesSection : sec.dataset.labelMachinesSection);
            set('machinesSectionLabel',   isProductionLine ? sec.dataset.labelLinesSection : sec.dataset.labelMachinesSection);
            set('btnAddMachineLabel',     isProductionLine ? sec.dataset.labelAddLine      : sec.dataset.labelAddMachine);
            set('machineCodeHeaderLabel', isProductionLine ? sec.dataset.labelLineCode     : sec.dataset.labelMachineCode);
            set('machineNameHeaderLabel', isProductionLine ? sec.dataset.labelLineName     : sec.dataset.labelMachineName);
        }

        function reindex() {
            tbody.querySelectorAll('tr').forEach((tr, i) => {
                tr.querySelectorAll('[name]').forEach(el => {
                    el.name = el.name.replace(/machines\[\d+\]/, `machines[${i}]`);
                });
            });
        }

        function addRow() {
            const idx = tbody.querySelectorAll('tr').length;
            const tr = document.createElement('tr');
            const sel = document.createElement('select');
            sel.className = 'form-select form-select-sm';
            sel.name = `machines[${idx}].MachineStatus`;
            statusOptions.forEach(o => sel.appendChild(new Option(o.label, o.value, false, o.value === 'Normal')));

            tr.innerHTML = `
                <td><input type="text" class="form-control form-control-sm u-text-transform-uppercase" name="machines[${idx}].MachineCode" required /></td>
                <td><input type="text" class="form-control form-control-sm" name="machines[${idx}].MachineName" required /></td>
                <td></td>
                <td><input type="text" class="form-control form-control-sm" name="machines[${idx}].Remarks" /></td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-machine"><i class="bi bi-trash"></i> @Localizer["Delete"]</button></td>`;
            tr.cells[2].appendChild(sel);
            tbody.appendChild(tr);
            window.parseModuleValidation && window.parseModuleValidation(); // 動態機台列重註冊驗證（R6c；BAS legacy 面板走 module-validation.js）
        }

        if (chk) {
            chk.addEventListener('change', () => { toggleMachineLabels(chk.checked); });
        }
        if (btnAdd) btnAdd.addEventListener('click', addRow);
        tbody.addEventListener('click', e => {
            const btn = e.target.closest('.btn-remove-machine');
            if (btn) { btn.closest('tr').remove(); reindex(); }
        });
    }

    function submitPanel(form) {
        const submitter = form.querySelector('[type="submit"]');
        const orig = submitter.innerHTML;
        submitter.disabled = true;
        submitter.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
        const fd = new FormData(form);
        if (submitter.name) fd.set(submitter.name, submitter.value);
        // Ensure machine rows are included (DOMPurify may affect FormData collection)
        const machineRows = form.querySelectorAll('#machineRows tr');
        machineRows.forEach((tr, i) => {
            tr.querySelectorAll('input, select').forEach(el => {
                if (el.name) {
                    const key = el.name.replace(/machines\[\d+\]/, `machines[${i}]`);
                    fd.set(key, el.value);
                }
            });
        });
        fetch(form.action, {
            method: 'POST',
            body: fd,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => {
            const ct = r.headers.get('Content-Type') || '';
            return ct.includes('application/json')
                ? r.json().then(d => ({ isJson: true, data: d }))
                : r.text().then(h => ({ isJson: false, html: h }));
        })
        .then(result => {
            if (result.isJson && result.data.success) {
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel')).hide();
                document.getElementById('successToastMsg').textContent = result.data.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else if (result.isJson && !result.data.success) {
                submitter.disabled = false; submitter.innerHTML = orig;
                alert(result.data.message);
            } else {
                document.getElementById('crudPanelBody').innerHTML = DOMPurify.sanitize(result.html);
                bindPanelForms();
            }
        })
        .catch(() => { submitter.disabled = false; submitter.innerHTML = orig; alert(window.i18n.t('SaveFailed')); });
    }

    function deleteItem(e, el) {
        const url = el.dataset.url, name = el.dataset.id;
        if (!confirm(window.i18n.t('ConfirmDelete').replace('{0}', name))) return;
        const token = document.querySelector('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').value;
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                document.getElementById('successToastMsg').textContent = result.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else {
                alert(result.message || window.i18n.t('DeleteFailed'));
            }
        })
        .catch(() => alert(window.i18n.t('DeleteFailed')));
    }
</script>
}
