@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@* 既有庫存裝箱／換箱（container-tracking.md §9.4 第 4 期）。互動 JS 在 Index 的 @section Scripts（BAS 面板慣例） *@
<form id="sideForm" method="post" action="@Url.Action("Pack")" data-action-submit="submitPanel">
    @Html.AntiForgeryToken()
    <input type="hidden" name="locationCode" id="packLocation" />
    <input type="hidden" name="lotNo" id="packLot" />
    <div class="p-1">
        <div class="mb-3">
            <label class="form-label fw-semibold" for="packUnit">@Localizer["UnitId"] <span class="text-danger">*</span></label>
            <input id="packUnit" name="containerUnitId" class="form-control font-monospace" value="@ViewBag.UnitId" required autocomplete="off"
                   placeholder="@Localizer["UnitIdPlaceholder"]" />
            <span class="text-danger small field-validation-valid" data-valmsg-for="containerUnitId" data-valmsg-replace="true"></span>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="packSourceBox">@Localizer["SourceBox"]</label>
            <input id="packSourceBox" class="form-control font-monospace" autocomplete="off"
                   placeholder="@Localizer["SourceBoxPlaceholder"]" data-action-change="packSourceBoxChanged" />
            <div class="form-text">@Localizer["SourceBoxHint"]</div>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="packProduct">@Localizer["ProductCode"] <span class="text-danger">*</span></label>
            <input id="packProduct" name="productCode" class="form-control" required autocomplete="off"
                   data-action-change="packProductChanged" />
            <span class="text-danger small field-validation-valid" data-valmsg-for="productCode" data-valmsg-replace="true"></span>
        </div>
        <div class="mb-3">
            <div class="form-label fw-semibold">@Localizer["SourceStock"] <span class="text-danger">*</span></div>
            <table class="table table-sm small mb-1">
                <thead class="table-light"><tr><th></th><th>@Localizer["LocationCode"]</th><th>@Localizer["LotNo"]</th><th class="text-end">@Localizer["Available"]</th></tr></thead>
                <tbody id="packStock"><tr><td colspan="4" class="text-muted">@Localizer["EnterProductFirst"]</td></tr></tbody>
            </table>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold" for="packQty">@Localizer["Qty"] <span class="text-danger">*</span></label>
            <input id="packQty" name="qty" type="number" step="any" min="0" class="form-control" required />
            <span class="text-danger small field-validation-valid" data-valmsg-for="qty" data-valmsg-replace="true"></span>
        </div>
        <div class="alert alert-info py-1 small">@Localizer["PackHint"]</div>
    </div>
    <div class="position-sticky bottom-0 bg-white border-top py-2 d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="offcanvas">@Localizer["Cancel"]</button>
        <button type="submit" class="btn btn-primary"><i class="bi bi-box-seam me-1"></i>@Localizer["Pack"]</button>
    </div>
</form>
