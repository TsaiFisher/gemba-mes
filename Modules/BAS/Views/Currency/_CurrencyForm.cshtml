@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.BAS.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Modules.BAS.Models.Currency

@{
    bool isEdit = ViewBag.IsEdit == true;
    string action = isEdit ? "Edit" : "Create";
}

<form method="post" asp-action="@action" asp-controller="Currency" asp-route-code="@(isEdit ? Model.CurrencyCode : null)"
      data-ajax="true" class="p-1">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["CurrencyCode"] <span class="text-danger">*</span></label>
        @if (isEdit)
        {
            <input type="text" class="form-control bg-light" value="@Model.CurrencyCode" readonly />
            <input type="hidden" asp-for="CurrencyCode" />
            <div class="form-text text-muted">@Localizer["CurrencyCodeReadonlyHint"]</div>
        }
        else
        {
            <input asp-for="CurrencyCode" class="form-control u-text-transform-uppercase" />
        }
        <span asp-validation-for="CurrencyCode" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["CurrencyName"] <span class="text-danger">*</span></label>
        <input asp-for="CurrencyName" class="form-control" />
        <span asp-validation-for="CurrencyName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["ShortName"]</label>
        <input asp-for="ShortName" class="form-control" />
        <span asp-validation-for="ShortName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["Symbol"]</label>
        <input asp-for="Symbol" class="form-control" />
        <span asp-validation-for="Symbol" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["DecimalPlaces"]</label>
        <input asp-for="DecimalPlaces" type="number" min="0" max="4" class="form-control" />
        <span asp-validation-for="DecimalPlaces" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <div class="form-check">
            <input type="checkbox" asp-for="IsActive" class="form-check-input" id="currencyIsActive" />
            <label class="form-check-label fw-semibold" for="currencyIsActive">@Localizer["IsActive"]</label>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary" data-dismiss-panel="true">
            @Localizer["Cancel"]
        </button>
    </div>
</form>
