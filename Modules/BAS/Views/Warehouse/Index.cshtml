@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Services
@using SmartFactory.MES.Modules.BAS.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Modules.BAS.Models.Warehouse>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var canUpdate = ViewBag.CanUpdate as bool? ?? false;
    var canDelete = ViewBag.CanDelete as bool? ?? false;
    bool hasSearched = ViewBag.Searched == true;

    Func<string, string> sortIcon = col => {
        var cur = ViewBag.CurrentSort as string ?? "";
        if (cur == col + "_asc") return "bi-sort-up";
        if (cur == col + "_desc") return "bi-sort-down";
        return "bi-arrow-down-up opacity-25";
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-building"></i> @Localizer["PageTitle"]</h1>
        @if (canCreate)
        {
            <button type="button" class="btn btn-primary"
                    data-url="@Url.Action("Create", "Warehouse")"
                    data-label="@Localizer["AddEntry"]"
                    data-action="openPanel">
                <i class="bi bi-plus-lg"></i> @Localizer["AddEntry"]
            </button>
        }
    </div>

    <!-- 查詢列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-12 col-md-auto flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="@Localizer["SearchPlaceholder"]" value="@ViewBag.SearchTerm" />
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                        {
                            <a asp-action="Index" asp-route-searched="true"
                               asp-route-pageSize="@ViewBag.CurrentPageSize"
                               class="btn btn-outline-secondary bg-white text-muted">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                        @if (ViewBag.CanPrint as bool? ?? false)
                        {
                            <button type="button" class="btn btn-outline-info ms-2" data-action="printPage">
                                <i class="bi bi-printer"></i> @Localizer["Print"]
                            </button>
                            <div class="btn-group ms-1">
                                <a asp-action="Export" asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-format="xlsx" class="btn btn-outline-success">
                                    <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
                                </a>
                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split"
                                        data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-format="csv">
                                        <i class="bi bi-filetype-csv me-2"></i>@Localizer["ExportCsv"]</a></li>
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm" asp-route-format="json">
                                        <i class="bi bi-filetype-json me-2"></i>@Localizer["ExportJson"]</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.CodeSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["WhCode"] <i class="bi @sortIcon("code")"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["WhName"] <i class="bi @sortIcon("name")"></i>
                                </a>
                            </th>
                            <th>@Localizer["WarehouseType"]</th>
                            <th>@Localizer["IsMrpWarehouse"]</th>
                            <th>@Localizer["Remarks"]</th>
                            <th>@Localizer["IsActive"]</th>
                            <th class="text-end pe-4">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>@Localizer["NoData"]
                            </td></tr>
                        }
                        else
                        {
                            foreach (var w in Model)
                            {
                                <tr>
                                    <td class="fw-medium">@w.WhCode</td>
                                    <td>@w.WhName</td>
                                    <td>
                                        @{
                                            var whTypeName = w.WarehouseType switch {
                                                SmartFactory.MES.Modules.BAS.Models.WarehouseType.Raw        => Localizer["WH_Raw"].Value,
                                                SmartFactory.MES.Modules.BAS.Models.WarehouseType.Wip        => Localizer["WH_Wip"].Value,
                                                SmartFactory.MES.Modules.BAS.Models.WarehouseType.Finished   => Localizer["WH_Finished"].Value,
                                                SmartFactory.MES.Modules.BAS.Models.WarehouseType.Quarantine => Localizer["WH_Quarantine"].Value,
                                                SmartFactory.MES.Modules.BAS.Models.WarehouseType.Outsource  => Localizer["WH_Outsource"].Value,
                                                SmartFactory.MES.Modules.BAS.Models.WarehouseType.Scrap      => Localizer["WH_Scrap"].Value,
                                                SmartFactory.MES.Modules.BAS.Models.WarehouseType.Staging    => Localizer["WH_Staging"].Value,
                                                SmartFactory.MES.Modules.BAS.Models.WarehouseType.CustomerSupplied => Localizer["WH_CustomerSupplied"].Value,
                                                _ => w.WarehouseType.ToString()
                                            };
                                        }
                                        <span class="badge bg-secondary">@whTypeName</span>
                                    </td>
                                    <td>
                                        @if (w.IsMrpWarehouse)
                                        {
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-dash-circle text-muted"></i>
                                        }
                                    </td>
                                    <td class="text-muted small">@w.Remarks</td>
                                    <td>
                                        @if (w.IsActive)
                                        {
                                            <span class="badge bg-success">@Localizer["Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        data-url="@Url.Action("Edit", "Warehouse", new { code = w.WhCode })"
                                                        data-label="@($"{Localizer["Edit"].Value}：{w.WhName}")"
                                                        data-code="@w.WhCode"
                                                        data-action="openDetailPanel"><i class="bi bi-pencil"></i> @Localizer["Edit"]</button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-url="@Url.Action("Delete", "Warehouse", new { code = w.WhCode })"
                                                        data-label="@w.WhName"
                                                        data-action="deleteItem"><i class="bi bi-trash"></i> @Localizer["Delete"]</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @await Html.PartialAsync("_Pagination", Model)
    }
</div>

<!-- Side Panel (Master-Detail with Tabs) -->
<div class="offcanvas offcanvas-end shadow-lg u-width-min-90vw-1200px" id="crudPanel" tabindex="-1"
     aria-labelledby="crudPanelLabel">
    <div class="offcanvas-header border-bottom bg-primary text-white py-3">
        <h5 class="offcanvas-title mb-0" id="crudPanelTitle"></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0">
        <ul class="nav nav-tabs px-3 pt-2" id="panelTabs">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabMaster">@Localizer["TabMaster"]</button>
            </li>
            <li class="nav-item u-display-none" id="tabDetailNavItem">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabDetail" data-action="loadLocations">@Localizer["Locations"]</button>
            </li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active p-3" id="tabMaster">
                <div id="crudPanelBody"></div>
            </div>
            <div class="tab-pane fade p-3" id="tabDetail">
                <div id="locationSection"></div>
            </div>
        </div>
    </div>
</div>

<!-- Success Toast -->
<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i><span id="successToastMsg"></span></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<form class="u-display-none" id="__AjaxAntiForgery">@Html.AntiForgeryToken()</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/module-validation.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_JsLocalization")
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    var _currentWhCode = null;

    function getToken() {
        return document.querySelector('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').value;
    }

    function showToast(msg) {
        document.getElementById('successToastMsg').textContent = msg;
        new bootstrap.Toast(document.getElementById('successToast')).show();
    }

    function openPanel(e, el) {
        const url = el.dataset.url, title = el.dataset.label;
        _currentWhCode = null;
        document.getElementById('tabDetailNavItem').classList.add('u-display-none');
        document.getElementById('crudPanelTitle').textContent = title;
        const body = document.getElementById('crudPanelBody');
        body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted small">' + @(Json.Serialize(SL["Loading"].Value)) + '</p></div>';
        new bootstrap.Tab(document.querySelector('[data-bs-target="#tabMaster"]')).show();
        new bootstrap.Offcanvas(document.getElementById('crudPanel')).show();
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(html => { body.innerHTML = DOMPurify.sanitize(html); bindPanelForms(); })
            .catch(() => { body.innerHTML = '<div class="alert alert-danger m-3">' + @(Json.Serialize(SL["LoadFailed"].Value)) + '</div>'; });
    }

    function openDetailPanel(e, el) {
        const url = el.dataset.url, title = el.dataset.label, whCode = el.dataset.code;
        _currentWhCode = whCode;
        document.getElementById('tabDetailNavItem').classList.remove('u-display-none');
        document.getElementById('crudPanelTitle').textContent = title;
        const body = document.getElementById('crudPanelBody');
        body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted small">' + @(Json.Serialize(SL["Loading"].Value)) + '</p></div>';
        new bootstrap.Tab(document.querySelector('[data-bs-target="#tabMaster"]')).show();
        new bootstrap.Offcanvas(document.getElementById('crudPanel')).show();
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(html => { body.innerHTML = DOMPurify.sanitize(html); bindPanelForms(); })
            .catch(() => { body.innerHTML = '<div class="alert alert-danger m-3">' + @(Json.Serialize(SL["LoadFailed"].Value)) + '</div>'; });
    }

    function bindPanelForms() {
        document.querySelectorAll('#crudPanelBody form[data-ajax="true"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                submitPanel(this);
            });
        });
        document.querySelectorAll('#crudPanelBody [data-dismiss-panel]').forEach(btn => {
            btn.addEventListener('click', () =>
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel'))?.hide());
        });
    }

    function submitPanel(form) {
        const submitter = form.querySelector('[type="submit"]');
        const orig = submitter.innerHTML;
        submitter.disabled = true;
        submitter.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
        const fd = new FormData(form);
        if (submitter.name) fd.set(submitter.name, submitter.value);
        fetch(form.action, {
            method: 'POST',
            body: fd,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => {
            const ct = r.headers.get('Content-Type') || '';
            return ct.includes('application/json')
                ? r.json().then(d => ({ isJson: true, data: d }))
                : r.text().then(h => ({ isJson: false, html: h }));
        })
        .then(result => {
            if (result.isJson && result.data.success) {
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel')).hide();
                showToast(result.data.message);
                setTimeout(() => location.reload(), 1200);
            } else if (result.isJson && !result.data.success) {
                submitter.disabled = false; submitter.innerHTML = orig;
                alert(result.data.message);
            } else {
                document.getElementById('crudPanelBody').innerHTML = DOMPurify.sanitize(result.html);
                bindPanelForms();
            }
        })
        .catch(() => { submitter.disabled = false; submitter.innerHTML = orig; alert(window.i18n.t('SaveFailed')); });
    }

    function deleteItem(e, el) {
        const url = el.dataset.url, name = el.dataset.label;
        if (!confirm(window.i18n.t('ConfirmDelete').replace('{0}', name))) return;
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '__RequestVerificationToken=' + encodeURIComponent(getToken())
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                showToast(result.message);
                setTimeout(() => location.reload(), 1200);
            } else {
                alert(result.message || window.i18n.t('DeleteFailed'));
            }
        })
        .catch(() => alert(window.i18n.t('DeleteFailed')));
    }

    // ---- Location Detail Tab ----
    function loadLocations() {
        if (!_currentWhCode) return;
        const sec = document.getElementById('locationSection');
        sec.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
        fetch('@Url.Action("GetLocations", "Warehouse")?whCode=' + encodeURIComponent(_currentWhCode),
              { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => r.json())
            .then(list => renderLocations(list))
            .catch(() => { sec.innerHTML = '<div class="alert alert-danger">' + @(Json.Serialize(SL["LoadFailed"].Value)) + '</div>'; });
    }

    function renderLocations(list) {
        let html = `
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0 fw-bold">@Localizer["Locations"]</h6>
            <button class="btn btn-sm btn-primary" data-action="showLocationForm">
                <i class="bi bi-plus-lg"></i> @Localizer["AddLocation"]
            </button>
        </div>
        <div id="locFormArea"></div>
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["LocationCode"]</th>
                    <th>@Localizer["LocationName"]</th>
                    <th>@Localizer["LocationType"]</th>
                    <th>@Localizer["IsActive"]</th>
                    <th class="text-end">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>`;
        if (!list || list.length === 0) {
            html += `<tr><td colspan="5" class="text-center text-muted py-3">@Localizer["NoData"]</td></tr>`;
        } else {
            list.forEach(l => {
                html += `<tr>
                    <td class="fw-medium">${escHtml(l.locationCode)}</td>
                    <td>${escHtml(l.locationName)}</td>
                    <td>${escHtml(l.locationType || '')}</td>
                    <td>${l.isActive ? '<span class="badge bg-success">@Localizer["Active"]</span>' : '<span class="badge bg-secondary">@Localizer["Inactive"]</span>'}</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-secondary me-1" data-action="showLocationForm" data-row="${escHtml(JSON.stringify(l))}"><i class="bi bi-pencil"></i> @Localizer["Edit"]</button>
                        <button class="btn btn-sm btn-outline-danger" data-action="deleteLocation" data-wh-code="${escHtml(l.whCode)}" data-location-code="${escHtml(l.locationCode)}"><i class="bi bi-trash"></i> @Localizer["Delete"]</button>
                    </td>
                </tr>`;
            });
        }
        html += `</tbody></table>`;
        document.getElementById('locationSection').innerHTML = html;
    }

    function showLocationForm(e, el) {
        const data = el.dataset.row ? JSON.parse(el.dataset.row) : null;
        const isEdit = data !== null;
        const html = `
        <div class="card card-body mb-3 border-primary">
            <div class="row g-2 align-items-end">
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["LocationCode"] <span class="text-danger">*</span></label>
                    <input type="text" id="locCode" class="form-control form-control-sm" value="${escHtml(isEdit ? data.locationCode : '')}" ${isEdit ? 'readonly' : ''} />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">@Localizer["LocationName"] <span class="text-danger">*</span></label>
                    <input type="text" id="locName" class="form-control form-control-sm" value="${escHtml(isEdit ? data.locationName : '')}" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["LocationType"]</label>
                    <input type="text" id="locType" class="form-control form-control-sm" value="${escHtml(isEdit && data.locationType ? data.locationType : '')}" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">@Localizer["Remarks"]</label>
                    <input type="text" id="locRemarks" class="form-control form-control-sm" value="${escHtml(isEdit && data.remarks ? data.remarks : '')}" />
                </div>
                <div class="col-md-1">
                    <div class="form-check mt-3">
                        <input type="checkbox" id="locIsActive" class="form-check-input" ${(!isEdit || data.isActive) ? 'checked' : ''} />
                        <label class="form-check-label small" for="locIsActive">@Localizer["IsActive"]</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button class="btn btn-sm btn-primary" data-action="saveLocation"><i class="bi bi-check-lg"></i> @Localizer["Save"]</button>
                    <button class="btn btn-sm btn-outline-secondary" data-action="clearTarget" data-target="locFormArea">@Localizer["Cancel"]</button>
                </div>
            </div>
        </div>`;
        document.getElementById('locFormArea').innerHTML = html;
    }

    function saveLocation() {
        const locationCode = document.getElementById('locCode').value.trim();
        const locationName = document.getElementById('locName').value.trim();
        const locationType = document.getElementById('locType').value.trim();
        const remarks      = document.getElementById('locRemarks').value.trim();
        const isActive     = document.getElementById('locIsActive').checked;
        if (!locationCode || !locationName) { alert(window.i18n.t('FieldsRequiredFmt').replace('{0}', '@Localizer["LocationCode"]').replace('{1}', '@Localizer["LocationName"]')); return; }
        const body = new URLSearchParams({
            __RequestVerificationToken: getToken(),
            whCode: _currentWhCode,
            locationCode,
            locationName,
            locationType,
            remarks,
            isActive
        });
        fetch('@Url.Action("SaveLocation", "Warehouse")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) { showToast(result.message); loadLocations(); }
            else { alert(result.message); }
        })
        .catch(() => alert(window.i18n.t('SaveFailed')));
    }

    function deleteLocation(e, el) {
        const whCode = el.dataset.whCode, locationCode = el.dataset.locationCode;
        if (!confirm(window.i18n.t('ConfirmDeleteLocation'))) return;
        const body = new URLSearchParams({
            __RequestVerificationToken: getToken(),
            whCode,
            locationCode
        });
        fetch('@Url.Action("DeleteLocation", "Warehouse")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) { showToast(result.message); loadLocations(); }
            else { alert(result.message); }
        })
        .catch(() => alert(window.i18n.t('DeleteFailed')));
    }

    function escHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
</script>
}
