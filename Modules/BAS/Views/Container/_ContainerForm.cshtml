@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.BAS.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Modules.BAS.Models.Container

@{
    bool isEdit = ViewBag.IsEdit == true;
    string action = isEdit ? "Edit" : "Create";
}

<form method="post" asp-action="@action" asp-controller="Container" asp-route-containerCode="@(isEdit ? Model.ContainerCode : null)"
      data-ajax="true" class="p-1">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["ContainerCode"] <span class="text-danger">*</span></label>
        @if (isEdit)
        {
            <input type="text" class="form-control bg-light" value="@Model.ContainerCode" readonly />
            <input type="hidden" asp-for="ContainerCode" />
            <div class="form-text text-muted">@Localizer["ContainerCodeReadonlyHint"]</div>
        }
        else
        {
            <input asp-for="ContainerCode" class="form-control u-text-transform-uppercase" placeholder="@Localizer["ContainerCodePlaceholder"]"
                   />
        }
        <span asp-validation-for="ContainerCode" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["ContainerName"] <span class="text-danger">*</span></label>
        <input asp-for="ContainerName" class="form-control" />
        <span asp-validation-for="ContainerName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["Spec"]</label>
        <input asp-for="Spec" class="form-control" />
        <span asp-validation-for="Spec" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["MaxCapacity"]</label>
        <input asp-for="MaxCapacity" type="number" step="any" class="form-control" />
        <span asp-validation-for="MaxCapacity" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <div class="form-check">
            <input type="checkbox" asp-for="IsActive" class="form-check-input" id="containerIsActive" />
            <label class="form-check-label fw-semibold" for="containerIsActive">@Localizer["IsActive"]</label>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary" data-dismiss-panel="true">
            @Localizer["Cancel"]
        </button>
    </div>
</form>
