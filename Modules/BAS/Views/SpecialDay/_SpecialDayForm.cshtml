@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.BAS.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Modules.BAS.Models.SpecialDay

@{
    bool isEdit = ViewBag.IsEdit == true;
    string dateStr = Model.Date == DateOnly.MinValue ? "" : Model.Date.ToString("yyyy-MM-dd");
}

<form method="post"
      asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="SpecialDay"
      asp-route-date="@(isEdit ? dateStr : null)"
      data-ajax="true" class="p-1">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["Date"] <span class="text-danger">*</span></label>
        @if (isEdit)
        {
            <input type="text" class="form-control bg-light" value="@dateStr" readonly />
            <input type="hidden" name="Date" value="@dateStr" />
        }
        else
        {
            <input type="date" name="Date" class="form-control"
                   value="@dateStr" required />
        }
        <span asp-validation-for="Date" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["DayType"] <span class="text-danger">*</span></label>
        <select name="DayType" class="form-select" required>
            <option value="">@Localizer["SelectDayType"]</option>
            <option value="Holiday" selected="@(Model.DayType == "Holiday")">@Localizer["Holiday"]</option>
            <option value="Overtime" selected="@(Model.DayType == "Overtime")">@Localizer["Overtime"]</option>
            <option value="Compensation" selected="@(Model.DayType == "Compensation")">@Localizer["Compensation"]</option>
        </select>
        <span asp-validation-for="DayType" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold">@Localizer["Description"]</label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label class="form-label fw-semibold">@Localizer["CompensatoryDayOfWeek"]</label>
        <select name="CompensatoryDayOfWeek" class="form-select">
            <option value="">—</option>
            @{
                var dowLabels = new[] { "", Localizer["Mon"].Value, Localizer["Tue"].Value, Localizer["Wed"].Value,
                    Localizer["Thu"].Value, Localizer["Fri"].Value, Localizer["Sat"].Value, Localizer["Sun"].Value };
            }
            @for (int i = 1; i <= 7; i++)
            {
                <option value="@i" selected="@(Model.CompensatoryDayOfWeek == i)">@dowLabels[i]</option>
            }
        </select>
        <div class="form-text text-muted">@Localizer["CompensatoryHint"]</div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-1"></i>@Localizer["Save"]
        </button>
        <button type="button" class="btn btn-outline-secondary" data-dismiss-panel="true">
            @Localizer["Cancel"]
        </button>
    </div>
</form>
