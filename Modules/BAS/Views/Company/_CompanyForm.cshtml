@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.BAS.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Modules.BAS.Models.Company
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL

@{
    bool isEdit = ViewBag.IsEdit == true;
    bool isReadOnly = ViewBag.IsReadOnly == true;
    var currencyOptions = (ViewBag.CurrencyOptions as System.Collections.IEnumerable) ?? Enumerable.Empty<object>();
    var taxOptions      = (ViewBag.TaxOptions      as System.Collections.IEnumerable) ?? Enumerable.Empty<object>();
    var paymentTypes    = (ViewBag.PaymentTypeOptions as System.Collections.IEnumerable) ?? Enumerable.Empty<object>();
}

<!-- Tab Navigation -->
<ul class="nav nav-tabs px-3 pt-2" id="companyTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="basicTab" data-bs-toggle="tab" data-bs-target="#basicPane"
                type="button" role="tab">
            <i class="bi bi-building me-1"></i>@Localizer["BasicInfo"]
        </button>
    </li>
    @if (isEdit)
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="contactTab" data-bs-toggle="tab" data-bs-target="#contactPane"
                    type="button" role="tab"
                    data-company-code="@Model.CompanyCode">
                <i class="bi bi-people me-1"></i>@Localizer["Contacts"]
            </button>
        </li>
    }
</ul>

<div class="tab-content p-3">
    <!-- Tab 1: Basic Info -->
    <div class="tab-pane fade show active" id="basicPane" role="tabpanel">
        <form method="post"
              asp-action="@(isEdit ? "Edit" : "Create")" asp-controller="Company"
              asp-route-code="@(isEdit ? Model.CompanyCode : null)"
              data-ajax="true">
            @Html.AntiForgeryToken()
<fieldset @(isReadOnly ? Html.Raw("disabled=\"disabled\"") : Html.Raw(""))>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@Localizer["CompanyCode"] <span class="text-danger">*</span></label>
                    @if (isEdit)
                    {
                        <input type="text" class="form-control bg-light" value="@Model.CompanyCode" readonly />
                        <input type="hidden" asp-for="CompanyCode" />
                    }
                    else
                    {
                        <input asp-for="CompanyCode" class="form-control u-text-transform-uppercase" placeholder="@Localizer["CompanyCodePlaceholder"]" />
                    }
                    <span asp-validation-for="CompanyCode" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">@Localizer["CompanyName"] <span class="text-danger">*</span></label>
                    <input asp-for="CompanyName" class="form-control" />
                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@Localizer["ShortName"]</label>
                    <input asp-for="ShortName" class="form-control" />
                    <span asp-validation-for="ShortName" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">@Localizer["CompanyType"]</label>
                    <div class="d-flex gap-4 mt-1">
                        <div class="form-check">
                            <input type="checkbox" asp-for="IsCustomer" class="form-check-input" id="chkCustomer" />
                            <label class="form-check-label" for="chkCustomer">@Localizer["IsCustomer"]</label>
                        </div>
                        <div class="form-check">
                            <input type="checkbox" asp-for="IsSupplier" class="form-check-input" id="chkSupplier" />
                            <label class="form-check-label" for="chkSupplier">@Localizer["IsSupplier"]</label>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@Localizer["CurrencyCode"]</label>
                    <select asp-for="CurrencyCode" class="form-select">
                        <option value="">—</option>
                        @foreach (dynamic c in currencyOptions)
                        {
                            <option value="@c.CurrencyCode" selected="@(Model.CurrencyCode == (string)c.CurrencyCode)">
                                @c.CurrencyCode — @c.CurrencyName
                            </option>
                        }
                    </select>
                    <span asp-validation-for="CurrencyCode" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@Localizer["TaxCode"]</label>
                    <select asp-for="TaxCode" class="form-select" id="TaxCodeSelect" data-fill-tax="true">
                        <option value="" data-rate="">—</option>
                        @foreach (dynamic t in taxOptions)
                        {
                            <option value="@t.TaxCode" data-rate="@t.TaxRate"
                                    selected="@(Model.TaxCode == (string)t.TaxCode)">
                                @t.TaxCode — @t.TaxName
                            </option>
                        }
                    </select>
                    <span asp-validation-for="TaxCode" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@Localizer["TaxRate"]</label>
                    <input asp-for="TaxRate" type="number" step="0.0001" class="form-control bg-light" id="TaxRateInput" readonly />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@Localizer["PaymentTermDays"]</label>
                    <input asp-for="PaymentTermDays" type="number" min="1" max="31" class="form-control" placeholder="@Localizer["PaymentTermDaysPlaceholder"]" />
                    <span asp-validation-for="PaymentTermDays" class="text-danger small"></span>
                    <div class="form-text text-muted">@Localizer["PaymentTermHint"]</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@Localizer["PaymentCreditDays"]</label>
                    <input asp-for="PaymentCreditDays" type="number" min="0" max="365" class="form-control" placeholder="30" />
                    <span asp-validation-for="PaymentCreditDays" class="text-danger small"></span>
                    <div class="form-text text-muted">@Localizer["PaymentCreditDaysHint"]</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@Localizer["AbcGrade"]</label>
                    <select asp-for="AbcGrade" class="form-select">
                        <option value="">—</option>
                        <option value="A">A</option>
                        <option value="B">B</option>
                        <option value="C">C</option>
                    </select>
                    <span asp-validation-for="AbcGrade" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">@Localizer["Address"]</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">@Localizer["InvoiceNo"]</label>
                    <input asp-for="InvoiceNo" class="form-control" placeholder="@Localizer["InvoiceNoPlaceholder"]" />
                    <span asp-validation-for="InvoiceNo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">@Localizer["PaymentType"]</label>
                    <select asp-for="PaymentType" class="form-select">
                        <option value="">—</option>
                        @foreach (dynamic pt in paymentTypes)
                        {
                            <option value="@pt.Code" selected="@(Model.PaymentType == (string)pt.Code)">
                                @pt.Code — @pt.DisplayName
                            </option>
                        }
                    </select>
                    <span asp-validation-for="PaymentType" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">@Localizer["Remarks"]</label>
                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Remarks" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input type="checkbox" asp-for="IsActive" class="form-check-input" id="compIsActive" />
                        <label class="form-check-label fw-semibold" for="compIsActive">@Localizer["IsActive"]</label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>@Localizer["Save"]
                </button>
                <button type="button" class="btn btn-outline-secondary" data-dismiss-panel="true">
                    @Localizer["Cancel"]
                </button>
            </div>
</fieldset>
@if (isReadOnly)
{
    <div class="px-3 pb-3 pt-2 border-top text-end">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">
            <i class="bi bi-x-lg me-1"></i>@SL["Close"]
        </button>
    </div>
}
        </form>
    </div>

    <!-- Tab 2: Contacts (Edit only) -->
    @if (isEdit)
    {
        <div class="tab-pane fade" id="contactPane" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-semibold">@Localizer["ContactList"]</span>
                <button type="button" class="btn btn-sm btn-outline-primary" data-action="add-contact" data-company-code="@Model.CompanyCode">
                    <i class="bi bi-plus-lg"></i> @Localizer["AddContact"]
                </button>
            </div>

            <!-- Contact Form (hidden by default) -->
            <div id="contactFormArea" class="card border-primary mb-3 u-display-none">
                <div class="card-body p-3">
                    <form id="contactForm" data-ajax="true">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CompanyCode" value="@Model.CompanyCode" />
                        <input type="hidden" name="Id" id="contactId" value="0" />
                        <div class="row g-2">
                            <div class="col-md-4">
                                <input type="text" name="Role" class="form-control form-control-sm"
                                       placeholder="@Localizer["Role"]" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="ContactName" class="form-control form-control-sm"
                                       placeholder="@Localizer["ContactName"]" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="Phone" class="form-control form-control-sm"
                                       placeholder="@Localizer["Phone"]" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="Fax" class="form-control form-control-sm"
                                       placeholder="@Localizer["Fax"]" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="Mobile" class="form-control form-control-sm"
                                       placeholder="@Localizer["Mobile"]" />
                            </div>
                            <div class="col-md-4">
                                <input type="text" name="Address" class="form-control form-control-sm"
                                       placeholder="@Localizer["ContactAddress"]" />
                            </div>
                            <div class="col-12 d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-primary" data-action="save-contact">
                                    @Localizer["Save"]
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="cancel-contact-form">
                                    @Localizer["Cancel"]
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Contact Table -->
            <div id="contactTable">
                <div class="text-center text-muted py-3">
                    <span class="spinner-border spinner-border-sm"></span>
                </div>
            </div>
        </div>
    }
</div>
