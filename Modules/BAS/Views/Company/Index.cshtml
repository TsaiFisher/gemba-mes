@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Services
@using SmartFactory.MES.Models
@using SmartFactory.MES.Modules.BAS.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Modules.BAS.Models.Company>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var canUpdate = ViewBag.CanUpdate as bool? ?? false;
    var canDelete = ViewBag.CanDelete as bool? ?? false;
    bool hasSearched = ViewBag.Searched == true;
    string? currentType = ViewBag.CompanyType as string;
    var currencyNames = ViewBag.CurrencyNames as Dictionary<string, string> ?? new Dictionary<string, string>();

    Func<string, string> sortIcon = col => {
        var cur = ViewBag.CurrentSort as string ?? "";
        if (cur == col + "_asc") return "bi-sort-up";
        if (cur == col + "_desc") return "bi-sort-down";
        return "bi-arrow-down-up opacity-25";
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-building me-2"></i>@Localizer["PageTitle"]</h1>
        @if (canCreate)
        {
            <button type="button" class="btn btn-primary"
                    data-url="@Url.Action("Create", "Company")"
                    data-label="@Localizer["AddEntry"]"
                    data-action="openPanel">
                <i class="bi bi-plus-lg"></i> @Localizer["AddEntry"]
            </button>
        }
    </div>

    <!-- 查詢列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-12 col-md-auto flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="@Localizer["SearchPlaceholder"]" value="@ViewBag.SearchTerm" />
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                        {
                            <a asp-action="Index" asp-route-searched="true"
                               asp-route-companyType="@currentType"
                               asp-route-pageSize="@ViewBag.CurrentPageSize"
                               class="btn btn-outline-secondary bg-white text-muted">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                        @if (ViewBag.CanPrint as bool? ?? false)
                        {
                            <button type="button" class="btn btn-outline-info ms-2" data-action="printPage">
                                <i class="bi bi-printer"></i> @Localizer["Print"]
                            </button>
                            <div class="btn-group ms-1">
                                <a asp-action="Export"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-companyType="@currentType"
                                   asp-route-format="xlsx" class="btn btn-outline-success">
                                    <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
                                </a>
                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split"
                                        data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm"
                                           asp-route-companyType="@currentType"
                                           asp-route-format="csv">
                                        <i class="bi bi-filetype-csv me-2"></i>@Localizer["ExportCsv"]</a></li>
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm"
                                           asp-route-companyType="@currentType"
                                           asp-route-format="json">
                                        <i class="bi bi-filetype-json me-2"></i>@Localizer["ExportJson"]</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-auto">
                    <select name="companyType" class="form-select" data-action-change="submitOwnForm">
                        <option value="">@Localizer["AllTypes"]</option>
                        <option value="customer" selected="@(currentType == "customer")">@Localizer["IsCustomer"]</option>
                        <option value="supplier" selected="@(currentType == "supplier")">@Localizer["IsSupplier"]</option>
                    </select>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.CodeSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-companyType="@currentType"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["CompanyCode"] <i class="bi @sortIcon("code")"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-companyType="@currentType"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["CompanyName"] <i class="bi @sortIcon("name")"></i>
                                </a>
                            </th>
                            <th>@Localizer["ShortName"]</th>
                            <th>@Localizer["CompanyType"]</th>
                            <th>@Localizer["CurrencyCode"]</th>
                            <th>@Localizer["IsActive"]</th>
                            <th>@Localizer["ApprovalStatus"]</th>
                            <th class="text-end pe-4">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr><td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>@Localizer["NoData"]
                            </td></tr>
                        }
                        else
                        {
                            foreach (var c in Model)
                            {
                                <tr>
                                    <td class="fw-medium">@c.CompanyCode</td>
                                    <td>@c.CompanyName</td>
                                    <td class="text-muted">@c.ShortName</td>
                                    <td>
                                        @if (c.IsCustomer)
                                        {
                                            <span class="badge bg-info text-dark me-1">@Localizer["IsCustomer"]</span>
                                        }
                                        @if (c.IsSupplier)
                                        {
                                            <span class="badge bg-warning text-dark">@Localizer["IsSupplier"]</span>
                                        }
                                    </td>
                                    <td class="text-muted">@(c.CurrencyCode != null && currencyNames.TryGetValue(c.CurrencyCode, out var _cn) ? $"{c.CurrencyCode} — {_cn}" : c.CurrencyCode)</td>
                                    <td>
                                        @if (c.IsActive)
                                        {
                                            <span class="badge bg-success">@Localizer["Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (c.ApprovalStatus)
                                        {
                                            case DocumentApprovalStatus.Approved:
                                                <span class="badge bg-success">@Localizer["Approved"]</span>
                                                break;
                                            case DocumentApprovalStatus.PendingApproval:
                                                <span class="badge bg-warning text-dark">@Localizer["PendingApproval"]</span>
                                                break;
                                            case DocumentApprovalStatus.Rejected:
                                                <span class="badge bg-danger">@Localizer["Rejected"]</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@Localizer["Draft"]</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            @if (canUpdate && c.ApprovalStatus != DocumentApprovalStatus.PendingApproval)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        data-url="@Url.Action("Edit", "Company", new { code = c.CompanyCode })"
                                                        data-label="@($"{Localizer["Edit"].Value}：{c.CompanyName}")"
                                                        data-action="openPanel"><i class="bi bi-pencil"></i> @Localizer["Edit"]</button>
                                            }
                                            @if (c.ApprovalStatus == DocumentApprovalStatus.PendingApproval && !string.IsNullOrEmpty(c.ApprovalRequestId))
                                            {
                                                <a href="@Url.Action("History", "Approval", new { id = c.ApprovalRequestId })"
                                                   class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-hourglass-split"></i> @Localizer["ViewApproval"]
                                                </a>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-url="@Url.Action("Delete", "Company", new { code = c.CompanyCode })"
                                                        data-label="@c.CompanyName"
                                                        data-action="deleteItem"><i class="bi bi-trash"></i> @Localizer["Delete"]</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @await Html.PartialAsync("_Pagination", Model)
    }
</div>

<!-- Side Panel (90vw for Company with tabs) -->
<div class="offcanvas offcanvas-end shadow-lg u-width-min-90vw-1200px" id="crudPanel" tabindex="-1"
     aria-labelledby="crudPanelLabel">
    <div class="offcanvas-header border-bottom bg-primary text-white py-3">
        <h5 class="offcanvas-title mb-0" id="crudPanelTitle"></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0" id="crudPanelBody"></div>
</div>

<!-- Success Toast -->
<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i><span id="successToastMsg"></span></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- Anti-Forgery for AJAX delete -->
<form class="u-display-none" id="__AjaxAntiForgery">@Html.AntiForgeryToken()</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/module-validation.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_JsLocalization")
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    function openPanel(e, el) {
        const url = el.dataset.url, title = el.dataset.label;
        document.getElementById('crudPanelTitle').textContent = title;
        const body = document.getElementById('crudPanelBody');
        body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted small">' + @(Json.Serialize(SL["Loading"].Value)) + '</p></div>';
        new bootstrap.Offcanvas(document.getElementById('crudPanel')).show();
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(html => { body.innerHTML = DOMPurify.sanitize(html); bindPanelForms(); })
            .catch(() => { body.innerHTML = '<div class="alert alert-danger m-3">' + @(Json.Serialize(SL["LoadFailed"].Value)) + '</div>'; });
    }

    function bindPanelForms() {
        document.querySelectorAll('#crudPanelBody form[data-ajax="true"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                submitPanel(this);
            });
        });
        document.querySelectorAll('#crudPanelBody [data-dismiss-panel]').forEach(btn => {
            btn.addEventListener('click', () =>
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel'))?.hide());
        });
        // TaxCode → TaxRate auto-fill
        document.querySelectorAll('#crudPanelBody [data-fill-tax]').forEach(sel => {
            sel.addEventListener('change', function() { fillTaxRate(this); });
        });
        // Contact tab: load contacts on first click
        const contactTabBtn = document.querySelector('#crudPanelBody #contactTab');
        if (contactTabBtn) {
            contactTabBtn.addEventListener('click', function() {
                loadContacts(this.dataset.companyCode);
            });
        }
        // Add Contact button
        document.querySelectorAll('#crudPanelBody [data-action="add-contact"]').forEach(btn => {
            btn.addEventListener('click', function() {
                showContactForm(0, this.dataset.companyCode);
            });
        });
        // Save Contact button
        document.querySelectorAll('#crudPanelBody [data-action="save-contact"]').forEach(btn => {
            btn.addEventListener('click', saveContact);
        });
        // Cancel Contact form button
        document.querySelectorAll('#crudPanelBody [data-action="cancel-contact-form"]').forEach(btn => {
            btn.addEventListener('click', function() {
                document.getElementById('contactFormArea').classList.add('u-display-none');
            });
        });
    }

    // ── Contact functions ────────────────────────────────────────────────────
    const _saveContactUrl   = '@Url.Action("SaveContact",   "Company")';
    const _deleteContactUrl = '@Url.Action("DeleteContact", "Company")';
    const _getContactsUrl   = '@Url.Action("GetContacts",  "Company")';

    function fillTaxRate(select) {
        const rate = select.options[select.selectedIndex]?.dataset?.rate ?? '';
        const input = document.getElementById('TaxRateInput');
        if (input) input.value = rate;
    }

    async function loadContacts(code) {
        const r = await fetch(_getContactsUrl + '?code=' + encodeURIComponent(code));
        const contacts = await r.json();
        const tbody = contacts.length === 0
            ? '<tr><td colspan="6" class="text-center text-muted py-3">' + @(Json.Serialize(SL["NoContacts"].Value)) + '</td></tr>'
            : contacts.map(c => `<tr>
                <td>${c.seqNo}</td>
                <td>${c.role||''}</td>
                <td>${c.contactName||''}</td>
                <td>${c.phone||''}</td>
                <td>${c.mobile||''}</td>
                <td class="text-end">
                  <button class="btn btn-xs btn-outline-secondary btn-sm"
                          data-action="showContactForm" data-id="${c.id}" data-code="${code}" data-row="${JSON.stringify(c).replace(/&/g,'&amp;').replace(/"/g,'&quot;')}"><i class="bi bi-pencil"></i> @Localizer["Edit"]</button>
                  <button class="btn btn-xs btn-outline-danger btn-sm"
                          data-action="deleteContact" data-id="${c.id}"><i class="bi bi-trash"></i> @Localizer["Delete"]</button>
                </td></tr>`).join('');
        document.getElementById('contactTable').innerHTML =
            `<table class="table table-sm table-hover mb-0">
              <thead class="table-light"><tr>
                <th>#</th><th>${@(Json.Serialize(SL["ContactJobTitle"].Value))}</th><th>${@(Json.Serialize(SL["ContactName"].Value))}</th><th>${@(Json.Serialize(SL["ContactPhone"].Value))}</th><th>${@(Json.Serialize(SL["ContactMobile"].Value))}</th><th></th>
              </tr></thead><tbody>${tbody}</tbody></table>`;
    }

    function showContactForm(e, el) {
        const id = el.dataset.id, code = el.dataset.code, data = el.dataset.row ? JSON.parse(el.dataset.row) : null;
        document.getElementById('contactFormArea').classList.remove('u-display-none');
        document.getElementById('contactId').value = id;
        if (data) {
            const f = document.getElementById('contactForm');
            f.querySelector('[name="Role"]').value        = data.role||'';
            f.querySelector('[name="ContactName"]').value = data.contactName||'';
            f.querySelector('[name="Phone"]').value       = data.phone||'';
            f.querySelector('[name="Fax"]').value         = data.fax||'';
            f.querySelector('[name="Mobile"]').value      = data.mobile||'';
            f.querySelector('[name="Address"]').value     = data.address||'';
        } else {
            document.getElementById('contactForm').reset();
            document.getElementById('contactId').value = 0;
            document.querySelector('#contactForm [name="CompanyCode"]').value = code;
        }
    }

    async function saveContact() {
        const f = document.getElementById('contactForm');
        const fd = new FormData(f);
        const r = await fetch(_saveContactUrl, {
            method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const result = await r.json();
        if (result.success) {
            document.getElementById('contactFormArea').classList.add('u-display-none');
            const code = document.querySelector('#contactForm [name="CompanyCode"]').value;
            loadContacts(code);
        } else {
            alert(result.message || window.i18n.t('SaveFailed'));
        }
    }

    async function deleteContact(e, el) {
        const id = el.dataset.id;
        if (!confirm(window.i18n.t('ConfirmDeleteContact'))) return;
        const token = document.querySelector('#contactForm input[name="__RequestVerificationToken"]').value;
        const r = await fetch(_deleteContactUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: 'id=' + id + '&__RequestVerificationToken=' + encodeURIComponent(token)
        });
        const result = await r.json();
        if (result.success) {
            const code = document.querySelector('#contactForm [name="CompanyCode"]').value;
            loadContacts(code);
        } else {
            alert(result.message || window.i18n.t('DeleteFailed'));
        }
    }

    function submitPanel(form) {
        const submitter = form.querySelector('[type="submit"]');
        const orig = submitter.innerHTML;
        submitter.disabled = true;
        submitter.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
        const fd = new FormData(form);
        if (submitter.name) fd.set(submitter.name, submitter.value);
        fetch(form.action, {
            method: 'POST',
            body: fd,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => {
            const ct = r.headers.get('Content-Type') || '';
            return ct.includes('application/json')
                ? r.json().then(d => ({ isJson: true, data: d }))
                : r.text().then(h => ({ isJson: false, html: h }));
        })
        .then(result => {
            if (result.isJson && result.data.success) {
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel')).hide();
                document.getElementById('successToastMsg').textContent = result.data.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else if (result.isJson && !result.data.success) {
                submitter.disabled = false; submitter.innerHTML = orig;
                alert(result.data.message);
            } else {
                document.getElementById('crudPanelBody').innerHTML = DOMPurify.sanitize(result.html);
                bindPanelForms();
            }
        })
        .catch(() => { submitter.disabled = false; submitter.innerHTML = orig; alert(window.i18n.t('SaveFailed')); });
    }

    function deleteItem(e, el) {
        const url = el.dataset.url, name = el.dataset.label;
        if (!confirm(window.i18n.t('ConfirmDelete').replace('{0}', name))) return;
        const token = document.querySelector('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').value;
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                document.getElementById('successToastMsg').textContent = result.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else {
                alert(result.message || window.i18n.t('DeleteFailed'));
            }
        })
        .catch(() => alert(window.i18n.t('DeleteFailed')));
    }
</script>
}
