@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.BAS.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Modules.BAS.Models.DocNumberConfig>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var canUpdate = ViewBag.CanUpdate as bool? ?? false;
    var canDelete = ViewBag.CanDelete as bool? ?? false;
    bool hasSearched = ViewBag.Searched == true;

    Func<string, string> sortIcon = col => {
        var cur = ViewBag.CurrentSort as string ?? "";
        if (cur == col + "_asc") return "bi-sort-up";
        if (cur == col + "_desc") return "bi-sort-down";
        return "bi-arrow-down-up opacity-25";
    };

    // 格式預覽（不佔流水碼）
    static string FormatPreview(DocNumberConfig c)
    {
        var date = DateTime.UtcNow;
        var datePart = c.DateFormat switch
        {
            DocDateFormat.YY       => date.ToString("yy"),
            DocDateFormat.YYMM     => date.ToString("yyMM"),
            DocDateFormat.YYYYMMDD => date.ToString("yyyyMMdd"),
            _                      => ""
        };
        var seqPart = "1".PadLeft(c.SeqLength, '0');
        var sep = c.Separator;
        return c.DateFormat == DocDateFormat.None
            ? $"{c.Prefix}{sep}{seqPart}"
            : $"{c.Prefix}{sep}{datePart}{sep}{seqPart}";
    }

    var plantNames = ViewBag.PlantNames as Dictionary<string, string> ?? new Dictionary<string, string>();

    var resetLabels = new Dictionary<DocSeqReset, string>
    {
        [DocSeqReset.Never]   = Localizer["Reset_Never"].Value,
        [DocSeqReset.Yearly]  = Localizer["Reset_Yearly"].Value,
        [DocSeqReset.Monthly] = Localizer["Reset_Monthly"].Value,
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-123"></i> @Localizer["PageTitle"]</h1>
        @if (canCreate)
        {
            <button type="button" class="btn btn-primary"
                    data-url="@Url.Action("Create", "DocNumberConfig")"
                    data-label="@Localizer["AddEntry"]"
                    data-action="openPanel">
                <i class="bi bi-plus-lg"></i> @Localizer["AddEntry"]
            </button>
        }
    </div>

    <!-- 查詢列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-12 col-md-auto flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="@Localizer["SearchPlaceholder"]" value="@ViewBag.SearchTerm" />
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                        {
                            <a asp-action="Index" asp-route-searched="true"
                               asp-route-pageSize="@ViewBag.CurrentPageSize"
                               class="btn btn-outline-secondary bg-white text-muted">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                    </div>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.DocTypeSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["DocType"] <i class="bi @sortIcon("doctype")"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["DocTypeName"] <i class="bi @sortIcon("name")"></i>
                                </a>
                            </th>
                            <th>@Localizer["ApplicablePlant"]</th>
                            <th>@Localizer["FormatPreview"]</th>
                            <th>@Localizer["ResetCycle"]</th>
                            <th>@Localizer["IsActive"]</th>
                            <th class="text-end pe-4">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>@Localizer["NoData"]
                            </td></tr>
                        }
                        else
                        {
                            foreach (var c in Model)
                            {
                                <tr>
                                    <td class="fw-medium font-monospace">
                                        @c.DocType
                                        @if (c.IsSystemType)
                                        {
                                            <i class="bi bi-lock-fill text-warning ms-1" title="@Localizer["SystemTypeHint"]"></i>
                                        }
                                    </td>
                                    <td>@c.DocTypeName</td>
                                    <td>
                                        @if (c.PlantIdList.Count == 0)
                                        {
                                            <span class="badge bg-light text-dark border">@Localizer["DefaultAllPlants"]</span>
                                        }
                                        else
                                        {
                                            foreach (var pid in c.PlantIdList)
                                            {
                                                <span class="badge bg-info-subtle text-info-emphasis border me-1">@pid — @(plantNames.TryGetValue(pid, out var pn) ? pn : "")</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <code class="text-primary">@FormatPreview(c)</code>
                                        <span class="text-muted small ms-2">
                                            (@c.Prefix + @c.DateFormat.ToString().ToLower() + @c.SeqLength@Localizer["Digits"].Value)
                                        </span>
                                    </td>
                                    <td class="text-muted small">
                                        @(resetLabels.TryGetValue(c.ResetCycle, out var rl) ? rl : c.ResetCycle.ToString())
                                    </td>
                                    <td>
                                        @if (c.IsActive)
                                        {
                                            <span class="badge bg-success">@Localizer["Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            @if (canUpdate)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        data-url="@Url.Action("Edit", "DocNumberConfig", new { docType = c.DocType, scopeKey = c.ScopeKey })"
                                                        data-label="@($"{Localizer["Edit"].Value}：{c.DocTypeName}")"
                                                        data-action="openPanel"><i class="bi bi-pencil"></i> @Localizer["Edit"]</button>
                                            }
                                            @if (canDelete && !c.IsSystemType)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-url="@Url.Action("Delete", "DocNumberConfig", new { docType = c.DocType, scopeKey = c.ScopeKey })"
                                                        data-id="@c.DocTypeName"
                                                        data-action="deleteItem"><i class="bi bi-trash"></i> @Localizer["Delete"]</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @await Html.PartialAsync("_Pagination", Model)
    }
</div>

<!-- Side Panel -->
<div class="offcanvas offcanvas-end shadow-lg u-width-min-600px-95vw" id="crudPanel" tabindex="-1"
     aria-labelledby="crudPanelLabel">
    <div class="offcanvas-header border-bottom bg-primary text-white py-3">
        <h5 class="offcanvas-title mb-0" id="crudPanelTitle"></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body" id="crudPanelBody"></div>
</div>

<!-- Success Toast -->
<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i><span id="successToastMsg"></span></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<form class="u-display-none" id="__AjaxAntiForgery">@Html.AntiForgeryToken()</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/module-validation.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_JsLocalization")
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    function openPanel(e, el) {
        const url = el.dataset.url, title = el.dataset.label;
        document.getElementById('crudPanelTitle').textContent = title;
        const body = document.getElementById('crudPanelBody');
        body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>';
        new bootstrap.Offcanvas(document.getElementById('crudPanel')).show();
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(html => { body.innerHTML = DOMPurify.sanitize(html); bindPanelForms(); })
            .catch(() => { body.innerHTML = '<div class="alert alert-danger m-3">' + @(Json.Serialize(SL["LoadFailed"].Value)) + '</div>'; });
    }
    function bindPanelForms() {
        document.querySelectorAll('#crudPanelBody form[data-ajax="true"]').forEach(form => {
            form.addEventListener('submit', e => { e.preventDefault(); submitPanel(form); });
        });
        document.querySelectorAll('#crudPanelBody [data-dismiss-panel]').forEach(btn => {
            btn.addEventListener('click', () =>
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel'))?.hide());
        });
        updatePreview();
        document.querySelectorAll('#crudPanelBody select, #crudPanelBody input').forEach(el =>
            el.addEventListener('change', updatePreview));
        document.querySelectorAll('#crudPanelBody input[type="text"]').forEach(el =>
            el.addEventListener('input', updatePreview));
        bindPlantCheckboxes();
    }
    // 「預設（全廠適用）」與「勾選特定廠別」互斥：兩者同時存在會使廠別解析產生歧義
    function bindPlantCheckboxes() {
        const defaultCb = document.querySelector('#crudPanelBody .plant-default-cb');
        const plantCbs  = document.querySelectorAll('#crudPanelBody .plant-specific-cb');
        if (!defaultCb) return;
        defaultCb.addEventListener('change', () => {
            if (defaultCb.checked) plantCbs.forEach(cb => cb.checked = false);
        });
        plantCbs.forEach(cb => cb.addEventListener('change', () => {
            if (cb.checked) defaultCb.checked = false;
        }));
    }
    function updatePreview() {
        const prefix = document.getElementById('fldPrefix')?.value ?? '';
        const fmt    = document.getElementById('fldDateFormat')?.value ?? '1';
        const len    = parseInt(document.getElementById('fldSeqLength')?.value ?? '5');
        const sep    = document.getElementById('fldSeparator')?.value ?? '-';
        if (!prefix) { document.getElementById('previewBox').textContent = '—'; return; }
        const now = new Date();
        const yy = String(now.getFullYear()).slice(-2);
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const dd = String(now.getDate()).padStart(2, '0');
        const datePart = { '0': '', '1': yy, '2': yy + mm, '3': String(now.getFullYear()) + mm + dd }[fmt] ?? yy;
        const seqPart = '1'.padStart(len, '0');
        const preview = fmt === '0'
            ? `${prefix}${sep}${seqPart}`
            : `${prefix}${sep}${datePart}${sep}${seqPart}`;
        document.getElementById('previewBox').textContent = preview;
    }
    function submitPanel(form) {
        const submitter = form.querySelector('[type="submit"]');
        const orig = submitter.innerHTML;
        submitter.disabled = true;
        submitter.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
        const fd = new FormData(form);
        if (submitter.name) fd.set(submitter.name, submitter.value);
        fetch(form.action, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => {
            const ct = r.headers.get('Content-Type') || '';
            return ct.includes('application/json')
                ? r.json().then(d => ({ isJson: true, data: d }))
                : r.text().then(h => ({ isJson: false, html: h }));
        })
        .then(result => {
            if (result.isJson && result.data.success) {
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel')).hide();
                document.getElementById('successToastMsg').textContent = result.data.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else if (result.isJson) {
                submitter.disabled = false; submitter.innerHTML = orig;
                alert(result.data.message);
            } else {
                document.getElementById('crudPanelBody').innerHTML = DOMPurify.sanitize(result.html);
                bindPanelForms();
            }
        })
        .catch(() => { submitter.disabled = false; submitter.innerHTML = orig; alert(window.i18n.t('SaveFailed')); });
    }
    function deleteItem(e, el) {
        const url = el.dataset.url, name = el.dataset.id;
        if (!confirm(window.i18n.t('ConfirmDelete').replace('{0}', name))) return;
        const token = document.querySelector('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').value;
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                document.getElementById('successToastMsg').textContent = result.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else { alert(result.message || window.i18n.t('DeleteFailed')); }
        })
        .catch(() => alert(window.i18n.t('DeleteFailed')));
    }
</script>
}
