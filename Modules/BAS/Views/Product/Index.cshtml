@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Services
@using SmartFactory.MES.Models
@using SmartFactory.MES.Modules.BAS.Models
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Modules.BAS.Models.Product>
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> SL

@{
    ViewData["Title"] = Localizer["PageTitle"];
    var canCreate = ViewBag.CanCreate as bool? ?? false;
    var canUpdate = ViewBag.CanUpdate as bool? ?? false;
    var canDelete = ViewBag.CanDelete as bool? ?? false;
    bool hasSearched = ViewBag.Searched == true;
    string? currentStockMode = ViewBag.StockMode as string;

    Func<string, string> sortIcon = col => {
        var cur = ViewBag.CurrentSort as string ?? "";
        if (cur == col + "_asc") return "bi-sort-up";
        if (cur == col + "_desc") return "bi-sort-down";
        return "bi-arrow-down-up opacity-25";
    };

    var stockModes     = (ViewBag.StockModes as System.Collections.IEnumerable) ?? Enumerable.Empty<object>();
    var stockModeNames = ViewBag.StockModeNames as Dictionary<string, string> ?? new Dictionary<string, string>();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-box-seam me-2"></i>@Localizer["PageTitle"]</h1>
        @if (canCreate)
        {
            <button type="button" class="btn btn-primary"
                    data-url="@Url.Action("Create", "Product")"
                    data-label="@Localizer["AddEntry"]"
                    data-action="openPanel">
                <i class="bi bi-plus-lg"></i> @Localizer["AddEntry"]
            </button>
        }
    </div>

    <!-- 查詢列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-12 col-md-auto flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="searchTerm" class="form-control"
                               placeholder="@Localizer["SearchPlaceholder"]" value="@ViewBag.SearchTerm" />
                        @if (!string.IsNullOrEmpty(ViewBag.SearchTerm as string))
                        {
                            <a asp-action="Index" asp-route-searched="true"
                               asp-route-stockMode="@currentStockMode"
                               asp-route-pageSize="@ViewBag.CurrentPageSize"
                               class="btn btn-outline-secondary bg-white text-muted">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                        @if (ViewBag.CanPrint as bool? ?? false)
                        {
                            <button type="button" class="btn btn-outline-info ms-2" data-action="printPage">
                                <i class="bi bi-printer"></i> @Localizer["Print"]
                            </button>
                            <div class="btn-group ms-1">
                                <a asp-action="Export"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-stockMode="@currentStockMode"
                                   asp-route-format="xlsx" class="btn btn-outline-success">
                                    <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
                                </a>
                                <button type="button" class="btn btn-outline-success dropdown-toggle dropdown-toggle-split"
                                        data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm"
                                           asp-route-stockMode="@currentStockMode"
                                           asp-route-format="csv">
                                        <i class="bi bi-filetype-csv me-2"></i>@Localizer["ExportCsv"]</a></li>
                                    <li><a class="dropdown-item" asp-action="Export"
                                           asp-route-searchTerm="@ViewBag.SearchTerm"
                                           asp-route-stockMode="@currentStockMode"
                                           asp-route-format="json">
                                        <i class="bi bi-filetype-json me-2"></i>@Localizer["ExportJson"]</a></li>
                                </ul>
                            </div>
                        }
                    </div>
                </div>
                <div class="col-auto">
                    <select name="stockMode" class="form-select" data-action-change="submitOwnForm">
                        <option value="">@Localizer["AllModes"]</option>
                        @foreach (var sm in stockModes.Cast<dynamic>())
                        {
                            <option value="@sm.Code" selected="@(currentStockMode == (string)sm.Code)">@sm.DisplayName</option>
                        }
                    </select>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.CodeSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-stockMode="@currentStockMode"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["ProductCode"] <i class="bi @sortIcon("code")"></i>
                                </a>
                            </th>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewBag.NameSort"
                                   asp-route-searchTerm="@ViewBag.SearchTerm"
                                   asp-route-stockMode="@currentStockMode"
                                   asp-route-pageSize="@ViewBag.CurrentPageSize"
                                   asp-route-searched="true" class="text-decoration-none text-dark">
                                    @Localizer["ProductName"] <i class="bi @sortIcon("name")"></i>
                                </a>
                            </th>
                            <th>@Localizer["Spec"]</th>
                            <th>@Localizer["StockUom"]</th>
                            <th>@Localizer["StockMode"]</th>
                            <th>@Localizer["IsActive"]</th>
                            <th>@Localizer["ApprovalStatus"]</th>
                            <th class="text-end pe-4">@Localizer["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr><td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox fs-4 d-block mb-2"></i>@Localizer["NoData"]
                            </td></tr>
                        }
                        else
                        {
                            foreach (var p in Model)
                            {
                                <tr>
                                    <td class="fw-medium">@p.ProductCode</td>
                                    <td>@p.ProductName</td>
                                    <td class="text-muted small">@p.Spec</td>
                                    <td class="text-muted">@p.StockUom</td>
                                    <td class="text-muted">@(p.StockMode != null && stockModeNames.TryGetValue(p.StockMode, out var _sm) ? _sm : p.StockMode)</td>
                                    <td>
                                        @if (p.IsActive)
                                        {
                                            <span class="badge bg-success">@Localizer["Active"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@Localizer["Inactive"]</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (p.ApprovalStatus)
                                        {
                                            case DocumentApprovalStatus.Approved:
                                                <span class="badge bg-success">@Localizer["Approved"]</span>
                                                break;
                                            case DocumentApprovalStatus.PendingApproval:
                                                <span class="badge bg-warning text-dark">@Localizer["PendingApproval"]</span>
                                                break;
                                            case DocumentApprovalStatus.Rejected:
                                                <span class="badge bg-danger">@Localizer["Rejected"]</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@Localizer["Draft"]</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            @if (canUpdate && p.ApprovalStatus != DocumentApprovalStatus.PendingApproval)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                        data-url="@Url.Action("Edit", "Product", new { code = p.ProductCode })"
                                                        data-label="@($"{Localizer["Edit"].Value}：{p.ProductName}")"
                                                        data-action="openPanel"><i class="bi bi-pencil"></i> @Localizer["Edit"]</button>
                                            }
                                            @if (p.ApprovalStatus == DocumentApprovalStatus.PendingApproval && !string.IsNullOrEmpty(p.ApprovalRequestId))
                                            {
                                                <a href="@Url.Action("History", "Approval", new { id = p.ApprovalRequestId })"
                                                   class="btn btn-sm btn-outline-warning">
                                                    <i class="bi bi-hourglass-split"></i> @Localizer["ViewApproval"]
                                                </a>
                                            }
                                            @if (canDelete)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger"
                                                        data-url="@Url.Action("Delete", "Product", new { code = p.ProductCode })"
                                                        data-id="@p.ProductName"
                                                        data-action="deleteItem"><i class="bi bi-trash"></i> @Localizer["Delete"]</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @await Html.PartialAsync("_Pagination", Model)
    }
</div>

<!-- Side Panel (90vw for Product with tabs) -->
<div class="offcanvas offcanvas-end shadow-lg u-width-min-90vw-1200px" id="crudPanel" tabindex="-1"
     aria-labelledby="crudPanelLabel">
    <div class="offcanvas-header border-bottom bg-primary text-white py-3">
        <h5 class="offcanvas-title mb-0" id="crudPanelTitle"></h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0" id="crudPanelBody"></div>
</div>

<!-- Success Toast -->
<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i><span id="successToastMsg"></span></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<!-- Anti-Forgery for AJAX delete -->
<form class="u-display-none" id="__AjaxAntiForgery">@Html.AntiForgeryToken()</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script src="~/js/module-validation.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_JsLocalization")
<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    // 面板表單（_ProductForm）的全域 handler 與小數位對照。
    // 表單 partial 經 DOMPurify.sanitize 注入會被剝除 <script>，故定義在此主文件區塊，
    // 供 _ProductForm 內以 data-action-change 引用（catPrimaryChange/catSelectChange/onStockUomChange）。
    window.uomDecimals = Object.assign(window.uomDecimals || {}, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.UomDecimals as IReadOnlyDictionary<string, int> ?? new Dictionary<string, int>())));

    function onStockUomChange(e, el) {
        const uomCode = el.value;
        document.querySelectorAll('.stock-qty-input').forEach(q => window.applyUomStep(q, uomCode, { minPositive: false }));
    }
    // 分類主選（radio）勾選時，同列的選用 checkbox 自動勾選
    function catPrimaryChange(e, el) {
        if (el.checked) { el.closest('tr').querySelector('.cat-sel').checked = true; }
    }
    // 分類選用（checkbox）取消時，同列主選 radio 一併取消
    function catSelectChange(e, el) {
        if (!el.checked) {
            var r = el.closest('tr').querySelector('input[name=CategoryCode]');
            if (r.checked) r.checked = false;
        }
    }

    function openPanel(e, el) {
        const url = el.dataset.url, title = el.dataset.label;
        document.getElementById('crudPanelTitle').textContent = title;
        const body = document.getElementById('crudPanelBody');
        body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-3 text-muted small">' + @(Json.Serialize(SL["Loading"].Value)) + '</p></div>';
        new bootstrap.Offcanvas(document.getElementById('crudPanel')).show();
        fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.text(); })
            .then(html => { body.innerHTML = DOMPurify.sanitize(html); bindPanelForms(); })
            .catch(() => { body.innerHTML = '<div class="alert alert-danger m-3">' + @(Json.Serialize(SL["LoadFailed"].Value)) + '</div>'; });
    }

    function bindPanelForms() {
        document.querySelectorAll('#crudPanelBody form[data-ajax="true"]').forEach(form => {
            form.addEventListener('submit', function(e) {
                e.preventDefault();
                submitPanel(this);
            });
        });
        document.querySelectorAll('#crudPanelBody [data-dismiss-panel]').forEach(btn => {
            btn.addEventListener('click', () =>
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel'))?.hide());
        });
        bindCategoryDefaults();
        // 預設途程代號 select2（mfg-domain.md §3.1(1)）；面板內容剛插入，於此初始化。
        if (window.jQuery && $.fn.select2) {
            var $routing = $('#crudPanelBody .product-routing');
            if ($routing.length) {
                $routing.select2({ theme: 'bootstrap-5', width: '100%', dropdownParent: $routing.closest('form') });
            }
        }
    }

    function bindCategoryDefaults() {
        const sel = document.querySelector('#crudPanelBody #selCategoryCode');
        if (!sel) return;
        sel.addEventListener('change', async function () {
            const code = this.value;
            if (!code) return;
            try {
                const res = await fetch(`/Product/GetCategoryDefaults?categoryCode=${encodeURIComponent(code)}`);
                if (!res.ok) return;
                const d = await res.json();
                const chk = document.querySelector('#crudPanelBody #chkLot');
                if (chk && d.enableLotTracking !== undefined) chk.checked = d.enableLotTracking;
                const uomSel = document.querySelector('#crudPanelBody select[name="StockUom"]');
                if (uomSel && d.defaultStockUomCode) uomSel.value = d.defaultStockUomCode;
            } catch { /* ignore */ }
        });
    }

    function submitPanel(form) {
        const submitter = form.querySelector('[type="submit"]');
        const orig = submitter.innerHTML;
        submitter.disabled = true;
        submitter.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>';
        const fd = new FormData(form);
        if (submitter.name) fd.set(submitter.name, submitter.value);
        fetch(form.action, {
            method: 'POST',
            body: fd,
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => {
            const ct = r.headers.get('Content-Type') || '';
            return ct.includes('application/json')
                ? r.json().then(d => ({ isJson: true, data: d }))
                : r.text().then(h => ({ isJson: false, html: h }));
        })
        .then(result => {
            if (result.isJson && result.data.success) {
                bootstrap.Offcanvas.getInstance(document.getElementById('crudPanel')).hide();
                document.getElementById('successToastMsg').textContent = result.data.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else if (result.isJson && !result.data.success) {
                submitter.disabled = false; submitter.innerHTML = orig;
                alert(result.data.message);
            } else {
                document.getElementById('crudPanelBody').innerHTML = DOMPurify.sanitize(result.html);
                bindPanelForms();
            }
        })
        .catch(() => { submitter.disabled = false; submitter.innerHTML = orig; alert(window.i18n.t('SaveFailed')); });
    }

    function deleteItem(e, el) {
        const url = el.dataset.url, name = el.dataset.id;
        if (!confirm(window.i18n.t('ConfirmDelete').replace('{0}', name))) return;
        const token = document.querySelector('#__AjaxAntiForgery input[name="__RequestVerificationToken"]').value;
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
            body: '__RequestVerificationToken=' + encodeURIComponent(token)
        })
        .then(r => r.json())
        .then(result => {
            if (result.success) {
                document.getElementById('successToastMsg').textContent = result.message;
                new bootstrap.Toast(document.getElementById('successToast')).show();
                setTimeout(() => location.reload(), 1200);
            } else {
                alert(result.message || window.i18n.t('DeleteFailed'));
            }
        })
        .catch(() => alert(window.i18n.t('DeleteFailed')));
    }
</script>
}
