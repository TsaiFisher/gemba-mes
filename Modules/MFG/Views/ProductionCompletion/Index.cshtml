@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.MFG.Models
@inject IViewLocalizer Localizer
@model PaginatedList<WorkOrder>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    bool canUpdate = ViewBag.CanUpdate == true;
    var uomDecimals = ViewBag.UomDecimals as IReadOnlyDictionary<string, int>;
    var productUomMap = ViewBag.ProductUomMap as IReadOnlyDictionary<string, string?> ?? new Dictionary<string, string?>();
    int baseDp = ViewBag.BaseCurrencyDp as int? ?? 2;
    string moneyFmt = baseDp <= 0 ? "N0" : $"N{baseDp}";
    string QtyFmt(string? uom) => uomDecimals != null && !string.IsNullOrEmpty(uom) && uomDecimals.TryGetValue(uom, out var v)
        ? (v <= 0 ? "N0" : $"N{v}") : "N4";
}

<div class="container-fluid">
    <div class="row mb-3 align-items-center">
        <div class="col"><h1>@ViewData["Title"]</h1></div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" action="@Url.Action("Index")" class="row g-3 align-items-end">
                <input type="hidden" name="searched" value="true" />
                <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />
                <div class="col-md-5">
                    <label class="form-label">@Localizer["SearchLabel"]</label>
                    <input type="text" name="searchText" class="form-control"
                           value="@ViewBag.SearchText" placeholder="@Localizer["SearchPlaceholder"]" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-search"></i> @Localizer["Search"]
                    </button>
                </div>
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Localizer["WorkOrderId"]</th>
                    <th>@Localizer["ProductCode"]</th>
                    <th>@Localizer["BatchId"]</th>
                    <th class="text-end">@Localizer["Quantity"]</th>
                    <th>@Localizer["PlannedEndDate"]</th>
                    <th class="text-end">@Localizer["ActualCost"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null) @foreach (var item in Model)
                {
                    var actualCost = item.ActualMaterialCost + item.ActualLaborCost + item.ActualOverheadCost;
                    <tr>
                        <td class="font-monospace">@item.WorkOrderId
                            @if (item.ReworkFromWorkOrderId != null) { <span class="badge bg-warning text-dark ms-1">@Localizer["Rework"]</span> }
                        </td>
                        <td>@item.ProductCode</td>
                        <td class="small text-muted">@item.ProductionBatchId</td>
                        <td class="text-end">@item.Quantity.ToString(QtyFmt(productUomMap.GetValueOrDefault(item.ProductCode)))</td>
                        <td>@item.PlannedEndDate.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@actualCost.ToString(moneyFmt)</td>
                        <td>
                            @if (canUpdate)
                            {
                                <button type="button" class="btn btn-sm btn-success"
                                        data-url="@Url.Action("ConfirmForm", new { id = item.WorkOrderId })"
                                        data-label="@Localizer["ConfirmTitle", item.WorkOrderId]"
                                        data-action="openPanel">
                                    <i class="bi bi-box-arrow-in-down-right"></i> @Localizer["Confirm"]
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (Model == null)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-info">@Localizer["NoData"]</div>
    }
    else
    {
        @await Html.PartialAsync("_Pagination", Model)
    }
</div>

<div class="offcanvas offcanvas-end u-min-width-500px u-max-width-95vw" tabindex="-1" id="sidePanel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="sidePanelLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body" id="sidePanelBody"></div>
</div>

<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@Localizer["SaveSuccess"]</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_CrudPanelScripts")
}
