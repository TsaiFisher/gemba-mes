@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.BAS.Models
@using SmartFactory.MES.Modules.MFG.Models
@using SmartFactory.MES.Modules.MFG.Controllers
@using SmartFactory.MES.Modules.MFG.Services
@inject IViewLocalizer Localizer
@model Dispatch

@{
    var machines          = ViewBag.SwitchMachines as List<HoldSwitchMachineOption> ?? new();
    var machineStatus     = ViewBag.MachineStatus as MachineStatus?;
    bool machineDown      = machineStatus is { } ms && DispatchHold.IsMachineDown(ms);
    bool canReleaseQuality = ViewBag.CanReleaseQuality == true;
    bool isQualityHold    = Model.HoldReason is DispatchHoldReason.FpiFailed or DispatchHoldReason.IpqcFailed;
    bool canResume        = !machineDown && (!isQualityHold || canReleaseQuality);
    var reasonKey = Model.HoldReason switch
    {
        DispatchHoldReason.MachineDown => "HoldReasonMachineDown",
        DispatchHoldReason.FpiFailed   => "HoldReasonFpiFailed",
        DispatchHoldReason.IpqcFailed  => "HoldReasonIpqcFailed",
        _                              => "HoldReasonUnknown"
    };
    var remaining = Model.Quantity - Model.QtyDone;
}

<div class="p-3">
    <dl class="row mb-3">
        <dt class="col-sm-4">@Localizer["DispatchId"]</dt>
        <dd class="col-sm-8 font-monospace">@Model.DispatchId</dd>
        <dt class="col-sm-4">@Localizer["WorkOrderId"]</dt>
        <dd class="col-sm-8">@Model.WorkOrderId</dd>
        <dt class="col-sm-4">@Localizer["MachineCode"]</dt>
        <dd class="col-sm-8">@(Model.MachineCode ?? "—")
            @if (machineDown) { <span class="badge bg-danger ms-1">@Localizer["MachineDownBadge"]</span> }
        </dd>
        <dt class="col-sm-4">@Localizer["HoldReason"]</dt>
        <dd class="col-sm-8 text-danger">@Localizer[reasonKey]</dd>
        @if (Model.HoldAt.HasValue)
        {
            <dt class="col-sm-4">@Localizer["HoldAt"]</dt>
            <dd class="col-sm-8">@DateTimeSvc.ToLocalTime(Model.HoldAt.Value).ToString("yyyy-MM-dd HH:mm")</dd>
        }
        <dt class="col-sm-4">@Localizer["Progress"]</dt>
        <dd class="col-sm-8">@Model.QtyDone / @Model.Quantity</dd>
    </dl>

    @* ── 恢復 ─────────────────────────────────────────────────────────────── *@
    <h6 class="border-bottom pb-2 mb-2"><i class="bi bi-play-circle me-1"></i>@Localizer["ResumeSection"]</h6>
    @if (machineDown)
    {
        <div class="alert alert-light border py-2 small">@Localizer["ResumeMachineDownHint"]</div>
    }
    else if (isQualityHold && !canReleaseQuality)
    {
        <div class="alert alert-light border py-2 small">@Localizer["ResumeNeedsQualityHint"]</div>
    }
    else
    {
        <form id="resumeForm" method="post" action="@Url.Action("Resume", new { id = Model.DispatchId })" class="mb-3">
            @Html.AntiForgeryToken()
            <p class="small text-muted mb-2">@Localizer["ResumeHint"]</p>
            <button type="submit" class="btn btn-success btn-sm" name="submit" value="resume" disabled="@(!canResume)">
                <i class="bi bi-play-circle me-1"></i>@Localizer["BtnResume"]
            </button>
        </form>
    }

    @* ── 換機續做 ─────────────────────────────────────────────────────────── *@
    <h6 class="border-bottom pb-2 mb-2 mt-3"><i class="bi bi-arrow-left-right me-1"></i>@Localizer["SwitchSection"]</h6>
    @if (machines.Count == 0)
    {
        <div class="alert alert-light border py-2 small">@Localizer["NoSwitchMachine"]</div>
    }
    else
    {
        <form id="switchForm" method="post" action="@Url.Action("SwitchMachine", new { id = Model.DispatchId })" class="mb-3">
            @Html.AntiForgeryToken()
            <p class="small text-muted mb-2">@(Model.QtyDone > 0
                ? Localizer["SwitchHintPartial", Model.QtyDone, remaining].Value
                : Localizer["SwitchHintNone"].Value)</p>
            <div class="input-group input-group-sm">
                <select name="newMachineCode" class="form-select" required>
                    @foreach (var m in machines)
                    {
                        <option value="@m.MachineCode">@m.MachineCode — @m.MachineName (@m.WorkCenterCode)</option>
                    }
                </select>
                <button type="submit" class="btn btn-outline-primary" name="submit" value="switch">
                    @Localizer["BtnSwitch"]
                </button>
            </div>
        </form>
    }

    @* ── 剩餘量結案 ───────────────────────────────────────────────────────── *@
    <h6 class="border-bottom pb-2 mb-2 mt-3"><i class="bi bi-stop-circle me-1"></i>@Localizer["ShortCloseSection"]</h6>
    <form id="shortCloseForm" method="post" action="@Url.Action("ShortClose", new { id = Model.DispatchId })"
          data-confirm="@Localizer["ShortCloseConfirm", remaining]">
        @Html.AntiForgeryToken()
        <p class="small text-muted mb-2">@(Model.QtyDone > 0
            ? Localizer["ShortCloseHintPartial", Model.QtyDone].Value
            : Localizer["ShortCloseHintNone"].Value)</p>
        <button type="submit" class="btn btn-outline-danger btn-sm" name="submit" value="shortclose">
            <i class="bi bi-stop-circle me-1"></i>@Localizer["BtnShortClose"]
        </button>
    </form>

    <div class="mt-3">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="offcanvas">@Localizer["Cancel"]</button>
    </div>
</div>

<script nonce="@(Context.Items[SmartFactory.MES.Middleware.CspNonceMiddleware.ItemKey] as string)">
    // 三個動作是獨立表單，各自提交（submitPanel 負責成功後的關閉與刷新）
    ['resumeForm', 'switchForm', 'shortCloseForm'].forEach(function (id) {
        var form = document.getElementById(id);
        if (!form) return;
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            var msg = this.dataset.confirm;
            if (msg && !confirm(msg)) return;
            submitPanel(this, this.querySelector('[type=submit]'));
        });
    });
</script>
