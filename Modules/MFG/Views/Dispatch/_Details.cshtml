@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.MFG.Models
@using SmartFactory.MES.Modules.BAS.Services
@inject IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> L
@model Dispatch

@{
    var op        = ViewBag.Operation as WorkOrderOperation;
    var sessions  = ViewBag.Sessions as List<ProductionSession> ?? new();
    var reports   = ViewBag.Reports  as List<ProductionReport>  ?? new();
    var setups    = ViewBag.Setups   as List<ProductionSetup>   ?? new();
    var userNames = ViewBag.UserNames as Dictionary<string, string> ?? new();
    string OperatorDisplay(string? id) => id != null && userNames.TryGetValue(id, out var n) ? n : (id ?? "—");
    var uomDecimals = ViewBag.UomDecimals as IReadOnlyDictionary<string, int>;
    string? productUom = ViewBag.ProductUom as string;
    string QtyFmt(string? uom) => uomDecimals != null && !string.IsNullOrEmpty(uom) && uomDecimals.TryGetValue(uom, out var v)
        ? (v <= 0 ? "N0" : $"N{v}") : "N4";
}

<div class="p-3">
    <h6 class="fw-bold mb-3">@Localizer["DispatchInfo"]</h6>
    <dl class="row mb-4">
        <dt class="col-sm-4">@Localizer["DispatchId"]</dt>
        <dd class="col-sm-8 font-monospace">@Model.DispatchId</dd>
        <dt class="col-sm-4">@Localizer["WorkOrderId"]</dt>
        <dd class="col-sm-8">@Model.WorkOrderId</dd>
        <dt class="col-sm-4">@Localizer["OperationSeq"]</dt>
        <dd class="col-sm-8">@Model.OperationSeq</dd>
        <dt class="col-sm-4">@Localizer["OperationName"]</dt>
        <dd class="col-sm-8">@(op?.OperationName ?? "—")</dd>
        <dt class="col-sm-4">@Localizer["WorkCenterId"]</dt>
        <dd class="col-sm-8">@(op?.WorkCenterId ?? "—")</dd>
        <dt class="col-sm-4">@Localizer["MachineCode"]</dt>
        <dd class="col-sm-8">@(Model.MachineCode ?? "—")</dd>
        <dt class="col-sm-4">@Localizer["Quantity"]</dt>
        <dd class="col-sm-8">@Model.Quantity.ToString(QtyFmt(productUom))</dd>
        <dt class="col-sm-4">@Localizer["QtyDone"]</dt>
        <dd class="col-sm-8">@Model.QtyDone.ToString(QtyFmt(productUom))</dd>
        <dt class="col-sm-4">@Localizer["Status"]</dt>
        <dd class="col-sm-8"><span class="badge bg-secondary">@MfgEnumDisplay.Text(L, Model.Status)</span></dd>
        @* 排程時刻不換算：數字本身就是廠別當地時間，Kind=Utc 只是貼給 Npgsql 的標籤（mfg-domain.md §UTC 地雷）。*@
        <dt class="col-sm-4">@Localizer["ScheduledStart"]</dt>
        <dd class="col-sm-8">@(Model.ScheduledStart?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
        <dt class="col-sm-4">@Localizer["ScheduledEnd"]</dt>
        <dd class="col-sm-8">@(Model.ScheduledEnd?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
    </dl>

    @* Setup 備料紀錄 *@
    <h6 class="fw-bold mb-2"><i class="bi bi-tools me-1"></i>@Localizer["SetupHistory"]</h6>
    @if (!setups.Any())
    {
        <p class="text-muted small">@Localizer["NoSetup"]</p>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["SetupStartAt"]</th>
                        <th>@Localizer["SetupEndAt"]</th>
                        <th>@Localizer["SetupStatus"]</th>
                        <th>@Localizer["Tooling"]</th>
                        <th>@Localizer["Operator"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in setups)
                    {
                        <tr>
                            <td class="small">@DateTimeSvc.ToLocalTime(s.SetupStartAt).ToString("MM/dd HH:mm")</td>
                            <td class="small">@(s.SetupEndAt.HasValue ? DateTimeSvc.ToLocalTime(s.SetupEndAt.Value).ToString("MM/dd HH:mm") : "—")</td>
                            <td>
                                @if (s.Status == ProductionSetupStatus.Open)
                                {
                                    <span class="badge bg-warning text-dark">@Localizer["SetupOpen"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@Localizer["SetupClosed"]</span>
                                }
                            </td>
                            <td class="small">@(s.ToolingCode ?? "—")</td>
                            <td class="small">@OperatorDisplay(s.OperatorId)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* 上工紀錄 *@
    <h6 class="fw-bold mb-2"><i class="bi bi-person-check me-1"></i>@Localizer["SessionHistory"]</h6>
    @if (!sessions.Any())
    {
        <p class="text-muted small">@Localizer["NoSession"]</p>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["StartAt"]</th>
                        <th>@Localizer["EndAt"]</th>
                        <th>@Localizer["SessionStatus"]</th>
                        <th>@Localizer["Machine"]</th>
                        <th>@Localizer["Operator"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in sessions)
                    {
                        <tr>
                            <td class="small">@DateTimeSvc.ToLocalTime(s.StartAt).ToString("MM/dd HH:mm")</td>
                            <td class="small">@(s.EndAt.HasValue ? DateTimeSvc.ToLocalTime(s.EndAt.Value).ToString("MM/dd HH:mm") : "—")</td>
                            <td>
                                @if (s.Status == ProductionSessionStatus.Open)
                                {
                                    <span class="badge bg-success">@Localizer["SessionOpen"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@Localizer["SessionClosed"]</span>
                                }
                            </td>
                            <td class="small">@(s.MachineCode ?? "—")</td>
                            <td class="small">@OperatorDisplay(s.OperatorId)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* 報工紀錄 *@
    <h6 class="fw-bold mb-2"><i class="bi bi-clipboard-check me-1"></i>@Localizer["ReportHistory"]</h6>
    @if (!reports.Any())
    {
        <p class="text-muted small">@Localizer["NoReport"]</p>
    }
    else
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["ReportedAt"]</th>
                        <th class="text-end">@Localizer["QtyOk"]</th>
                        <th class="text-end">@Localizer["QtyNg"]</th>
                        <th>@Localizer["Container"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in reports)
                    {
                        <tr>
                            <td class="small">@DateTimeSvc.ToLocalTime(r.ReportedAt).ToString("MM/dd HH:mm")</td>
                            <td class="text-end">@r.QtyOk.ToString(QtyFmt(productUom))</td>
                            <td class="text-end">@r.QtyNg.ToString(QtyFmt(productUom))</td>
                            <td class="small">@(r.ContainerCode ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="offcanvas">@Localizer["Close"]</button>
    </div>
</div>
