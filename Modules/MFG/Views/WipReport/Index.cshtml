@using SmartFactory.MES.Services
@using SmartFactory.MES.Modules.BAS.Services
@model List<SmartFactory.MES.Modules.MFG.ViewModels.WipReportRowVm>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    bool searched      = ViewBag.Searched == true;
    bool canPrint      = ViewBag.CanPrint == true;
    var rows           = Model ?? new();
    decimal totalWip   = rows.Sum(r => r.WipValue);
    string curProduct  = ViewBag.SearchProduct as string ?? "";
    var productOptions = ViewBag.ProductOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var uomDecimals = ViewBag.UomDecimals as IReadOnlyDictionary<string, int>;
    int baseDp = ViewBag.BaseCurrencyDp as int? ?? 2;
    string moneyFmt = baseDp <= 0 ? "N0" : $"N{baseDp}";
    string QtyFmt(string? uom) => uomDecimals != null && !string.IsNullOrEmpty(uom) && uomDecimals.TryGetValue(uom, out var v)
        ? (v <= 0 ? "N0" : $"N{v}") : "N4";
}

<div class="container-fluid py-3">
    <h4 class="mb-3">@L["PageTitle"]</h4>

    <form method="get" asp-action="Index" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@L["Product"]</label>
                <select name="searchProduct" class="form-select select2-enable w-100"
                        data-placeholder="@L["ProductPlaceholder"]" data-allow-clear="true">
                    <option value=""></option>
                    @foreach (var p in productOptions)
                    {
                        <option value="@p.ProductCode" selected="@(curProduct == (string)p.ProductCode)">@p.ProductCode — @p.ProductName</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" name="searched" value="true" class="btn btn-primary w-100 px-4">
                    <i class="bi bi-search"></i> @L["Search"]
                </button>
            </div>
        </div>
    @await Html.PartialAsync("_PageSizeSelect")
    </form>

    @if (!searched)
    {
        <div class="alert alert-info">@L["SearchFirst"]</div>
    }
    else if (!rows.Any())
    {
        <div class="alert alert-warning">@L["NoData"]</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <strong>@L["ResultTitle"]</strong>
                <span class="text-muted ms-1">@rows.Count @L["Items"]</span>
                <span class="ms-3 text-muted">@L["TotalWip"]：<strong>@totalWip.ToString(moneyFmt)</strong></span>
            </div>
            @if (canPrint)
            {
                <a asp-action="Export" asp-route-searchProduct="@ViewBag.SearchProduct"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> @L["ExportExcel"]
                </a>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>@L["WorkOrderId"]</th>
                        <th>@L["ProductCode"]</th>
                        <th class="text-end">@L["Quantity"]</th>
                        <th>@L["Status"]</th>
                        <th>@L["PlannedStart"]</th>
                        <th>@L["PlannedEnd"]</th>
                        <th class="text-end">@L["StdCost"]</th>
                        <th class="text-end">@L["ActCost"]</th>
                        <th class="text-end">@L["WipValue"]</th>
                        <th class="text-end">@L["CostVariance"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var paged = ReportPaging.Page(rows, ViewData, Context); }
                    @foreach (var r in paged)
                    {
                        <tr>
                            <td>@r.WorkOrderId</td>
                            <td>@r.ProductCode</td>
                            <td class="text-end">@r.Quantity.ToString(QtyFmt(r.UomCode))</td>
                            <td><span class="badge @(r.Status == "InProgress" ? "bg-primary" : "bg-secondary")">@L["Status" + r.Status]</span></td>
                            <td>@r.PlannedStartDate.ToString("yyyy-MM-dd")</td>
                            <td>@r.PlannedEndDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@r.StdTotalCost.ToString(moneyFmt)</td>
                            <td class="text-end">@r.ActTotalCost.ToString(moneyFmt)</td>
                            <td class="text-end fw-bold">@r.WipValue.ToString(moneyFmt)</td>
                            <td class="text-end @(r.CostVariance > 0 ? "text-danger" : r.CostVariance < 0 ? "text-success" : "")">
                                @r.CostVariance.ToString(moneyFmt)
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-secondary fw-bold">
                    <tr>
                        <td colspan="8">@L["Total"]</td>
                        <td class="text-end">@totalWip.ToString(moneyFmt)</td>
                        <td class="text-end @(rows.Sum(r => r.CostVariance) > 0 ? "text-danger" : "text-success")">
                            @rows.Sum(r => r.CostVariance).ToString(moneyFmt)
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", paged)
    }
</div>
