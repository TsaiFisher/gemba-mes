@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.MFG.Models
@using SmartFactory.MES.Modules.MFG.ViewModels
@inject IViewLocalizer Localizer
@model MultiLevelExplosionResult

@{
    ViewData["Title"] = Localizer["PageTitle"];
    bool hasSearched = ViewBag.Searched == true;
    var productOptions = ViewBag.ProductOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var curProduct = ViewBag.SearchProduct as string ?? "";
    var wcNames = ViewBag.WorkCenterNames as Dictionary<string, string> ?? new Dictionary<string, string>();

    var uomDecimals = ViewBag.UomDecimals as IReadOnlyDictionary<string, int>;
    string QtyFmt(string? uom)
    {
        var dp = (uomDecimals != null && !string.IsNullOrEmpty(uom) && uomDecimals.TryGetValue(uom, out var v)) ? v : 4;
        return dp <= 0 ? "N0" : $"N{dp}";
    }
    string WcLabel(string wcId) => wcNames.TryGetValue(wcId, out var n) ? $"{wcId} — {n}" : wcId;
    string TimeUnitLabel(OperationTimeUnit u) => u switch
    {
        OperationTimeUnit.Second => Localizer["TimeUnitSecond"].Value,
        OperationTimeUnit.Hour   => Localizer["TimeUnitHour"].Value,
        _                        => Localizer["TimeUnitMinute"].Value,
    };
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-diagram-3-fill"></i> @Localizer["PageTitle"]</h1>
    </div>

    <!-- 查詢列 -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />

                <div class="col-md-4">
                    <label class="form-label small fw-semibold">@Localizer["ProductCode"]</label>
                    <select name="searchProduct" class="form-select form-select-sm select2-enable w-100"
                            data-placeholder="@Localizer["ProductCodePlaceholder"]" data-allow-clear="true">
                        <option value=""></option>
                        @foreach (var p in productOptions)
                        {
                            <option value="@p.ProductCode" selected="@(curProduct == (string)p.ProductCode)">@p.ProductCode — @p.ProductName</option>
                        }
                    </select>
                </div>

                <div class="col-12 d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-search me-1"></i>@Localizer["Search"]
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Reset"]</a>

                    @if (ViewBag.CanPrint as bool? ?? false)
                    {
                        @* 直接以查詢列「當前」品號送出列印（新分頁），不需先按查詢 *@
                        <button type="submit" formaction="@Url.Action("Print")" formtarget="_blank" formnovalidate
                                class="btn btn-outline-dark btn-sm ms-auto">
                            <i class="bi bi-printer"></i> @Localizer["Print"]
                        </button>
                        <div class="btn-group">
                            <a asp-action="Export"
                               asp-route-searchProduct="@curProduct"
                               asp-route-format="xlsx" class="btn btn-outline-success btn-sm">
                                <i class="bi bi-file-earmark-excel"></i> @Localizer["ExportExcel"]
                            </a>
                            <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle dropdown-toggle-split"
                                    data-bs-toggle="dropdown"></button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-action="Export"
                                       asp-route-searchProduct="@curProduct"
                                       asp-route-format="csv">CSV</a></li>
                                <li><a class="dropdown-item" asp-action="Export"
                                       asp-route-searchProduct="@curProduct"
                                       asp-route-format="json">JSON</a></li>
                            </ul>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>

    @if (!hasSearched || Model == null)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchPrompt"]
        </div>
    }
    else
    {
        @if (Model.Warnings.Count > 0)
        {
            <div class="alert alert-warning py-2">
                <i class="bi bi-exclamation-triangle me-1"></i>
                <ul class="mb-0 small">
                    @foreach (var w in Model.Warnings)
                    {
                        <li>@w</li>
                    }
                </ul>
            </div>
        }

        @if (!Model.RoutingNodes.Any())
        {
            <div class="alert alert-light border text-muted text-center py-4">
                <i class="bi bi-inbox fs-4 d-block mb-2"></i>@Localizer["NoRoutingData"]
            </div>
        }
        else
        {
            foreach (var node in Model.RoutingNodes)
            {
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-light d-flex flex-wrap gap-3 align-items-center">
                        <span class="badge bg-primary">@Localizer["Level"] @node.Level</span>
                        <span class="fw-bold">@node.ProductCode — @node.ProductName</span>
                        <span class="text-muted small">
                            @Localizer["RoutingId"]：@node.RoutingId
                            @if (!string.IsNullOrEmpty(node.RoutingName))
                            {
                                <span>（@node.RoutingName）</span>
                            }
                        </span>
                        @if (node.Level > 0)
                        {
                            <span class="text-muted small ms-auto">@Localizer["RequiredQty"]：@node.RequiredQty.ToString(QtyFmt(node.UomCode))</span>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="u-width-60px">@Localizer["OperationSeq"]</th>
                                    <th>@Localizer["OperationName"]</th>
                                    <th>@Localizer["WorkCenter"]</th>
                                    <th class="text-end">@Localizer["SetupTime"]</th>
                                    <th class="text-end">@Localizer["UnitTime"]</th>
                                    <th class="text-end">@Localizer["YieldRate"]</th>
                                    <th class="pe-4">@Localizer["IsOutsource"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var op in node.Operations)
                                {
                                    <tr class="table-light">
                                        <td class="fw-semibold">@op.OperationSeq</td>
                                        <td class="fw-semibold">@op.OperationName</td>
                                        <td>@WcLabel(op.WorkCenterId)</td>
                                        <td class="text-end">@op.SetupTime.ToString("N2") @TimeUnitLabel(op.SetupTimeUnit)</td>
                                        <td class="text-end">@op.UnitTime.ToString("N4") @TimeUnitLabel(op.TimeUnit)</td>
                                        <td class="text-end">@op.YieldRate.ToString("N2")</td>
                                        <td class="pe-4">
                                            @if (op.IsOutsource)
                                            {
                                                <span class="badge bg-warning text-dark">@Localizer["Outsource"]</span>
                                            }
                                        </td>
                                    </tr>
                                    @if (op.Boms.Any())
                                    {
                                        <tr>
                                            <td></td>
                                            <td colspan="7" class="py-2">
                                                <div class="small text-muted mb-1">
                                                    <i class="bi bi-box-seam me-1"></i>@Localizer["OperationMaterials"]
                                                </div>
                                                <table class="table table-sm table-bordered mb-0 bg-white">
                                                    <thead>
                                                        <tr class="small text-muted">
                                                            <th class="u-width-60px">@Localizer["BomSeq"]</th>
                                                            <th>@Localizer["ProductCode"]</th>
                                                            <th>@Localizer["ProductName"]</th>
                                                            <th>@Localizer["UomCode"]</th>
                                                            <th class="text-end">@Localizer["Quantity"]</th>
                                                            <th class="text-end">@Localizer["ScrapRate"]</th>
                                                            <th class="text-end">@Localizer["OffcutRate"]</th>
                                                            <th>@Localizer["SourceType"]</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var b in op.Boms)
                                                        {
                                                            <tr>
                                                                <td>@b.BomSeq</td>
                                                                <td class="fw-medium">@b.ProductCode</td>
                                                                <td>@b.ProductName</td>
                                                                <td>@b.UomCode</td>
                                                                <td class="text-end">@b.Quantity.ToString(QtyFmt(b.UomCode))</td>
                                                                <td class="text-end">@(b.ScrapRate == 0 ? "—" : b.ScrapRate.ToString("N2"))</td>
                                                                <td class="text-end">@(b.OffcutRate == 0 ? "—" : b.OffcutRate.ToString("N2"))</td>
                                                                <td>
                                                                    @if (b.IsMake)
                                                                    {
                                                                        <span class="badge bg-primary-subtle text-primary border">@Localizer["SourceMake"]</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-secondary-subtle text-secondary border">@Localizer["SourceBuy"]</span>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    }
</div>
