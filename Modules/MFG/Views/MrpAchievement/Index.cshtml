@using SmartFactory.MES.Services
@model List<SmartFactory.MES.Modules.MFG.ViewModels.MrpAchievementRowVm>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer L
@{
    ViewData["Title"] = L["PageTitle"].Value;
    bool searched      = ViewBag.Searched == true;
    bool canPrint      = ViewBag.CanPrint == true;
    var rows           = Model ?? new();
    var mrpRuns        = ViewBag.MrpRuns as dynamic[] ?? Array.Empty<dynamic>();
    decimal avgRate    = rows.Any() ? rows.Average(r => r.AchievementRate) : 0m;
    string curProduct  = ViewBag.SearchProduct as string ?? "";
    var productOptions = ViewBag.ProductOptions as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var uomDecimals = ViewBag.UomDecimals as IReadOnlyDictionary<string, int>;
    string QtyFmt(string? uom) => uomDecimals != null && !string.IsNullOrEmpty(uom) && uomDecimals.TryGetValue(uom, out var v)
        ? (v <= 0 ? "N0" : $"N{v}") : "N4";
}

<div class="container-fluid py-3">
    <h4 class="mb-3">@L["PageTitle"]</h4>

    @* 常用查詢入口（§7.9-6）。放在查詢卡片之外——partial 內有按鈕與輸入框，
       塞進下面那張卡的 <form> 內會變成巢狀表單。 *@
    @await Html.PartialAsync("_SavedQueries", "MrpAchievement")

    <form method="get" asp-action="Index" class="card card-body mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label">@L["MrpRun"]</label>
                <select name="mrpRunId" class="form-select">
                    <option value="">@L["AllRuns"]</option>
                    @foreach (var r in ViewBag.MrpRuns ?? new System.Collections.ArrayList())
                    {
                        <option value="@r.MrpRunId" selected="@(ViewBag.MrpRunId?.ToString() == r.MrpRunId)">
                            @r.MrpRunId (@r.ExecutedAt?.ToString("yyyy-MM-dd HH:mm"))
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">@L["Product"]</label>
                <select name="searchProduct" class="form-select select2-enable w-100"
                        data-placeholder="@L["ProductPlaceholder"]" data-allow-clear="true">
                    <option value=""></option>
                    @foreach (var p in productOptions)
                    {
                        <option value="@p.ProductCode" selected="@(curProduct == (string)p.ProductCode)">@p.ProductCode — @p.ProductName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" name="searched" value="true" class="btn btn-primary w-100 px-4">
                    <i class="bi bi-search"></i> @L["Search"]
                </button>
            </div>
        </div>
    @await Html.PartialAsync("_PageSizeSelect")
    </form>

    @if (!searched)
    {
        <div class="alert alert-info">@L["SearchFirst"]</div>
    }
    else if (!rows.Any())
    {
        <div class="alert alert-warning">@L["NoData"]</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <strong>@L["ResultTitle"]</strong>
                <span class="text-muted ms-1">@rows.Count @L["Items"]</span>
                <span class="ms-3">@L["AvgAchievement"]：
                    <span class="badge @(avgRate >= 95 ? "bg-success" : avgRate >= 80 ? "bg-warning text-dark" : "bg-danger") fs-6">
                        @avgRate.ToString("N1")%
                    </span>
                </span>
            </div>
            @if (canPrint)
            {
                <a asp-action="Export"
                   asp-route-mrpRunId="@ViewBag.MrpRunId" asp-route-searchProduct="@ViewBag.SearchProduct"
                   class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> @L["ExportExcel"]
                </a>
            }
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>@L["MrpRunId"]</th>
                        <th>@L["ProductCode"]</th>
                        <th>@L["RequiredDate"]</th>
                        <th class="text-end">@L["RequiredQty"]</th>
                        <th class="text-end">@L["ActualQty"]</th>
                        <th class="text-end">@L["AchievementRate"]</th>
                        <th class="text-end">@L["Shortfall"]</th>
                        <th>@L["ValidationError"]</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var paged = ReportPaging.Page(rows, ViewData, Context); }
                    @foreach (var r in paged)
                    {
                        <tr>
                            <td>@r.MrpRunId</td>
                            <td>@r.ProductCode</td>
                            <td>@r.RequiredDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@r.RequiredQty.ToString(QtyFmt(r.UomCode))</td>
                            <td class="text-end">@r.ActualQty.ToString(QtyFmt(r.UomCode))</td>
                            <td class="text-end">
                                <span class="badge @(r.AchievementRate >= 95 ? "bg-success" : r.AchievementRate >= 80 ? "bg-warning text-dark" : "bg-danger")">
                                    @r.AchievementRate%
                                </span>
                            </td>
                            <td class="text-end @(r.ShortfallQty > 0 ? "text-danger" : "text-success")">
                                @r.ShortfallQty.ToString(QtyFmt(r.UomCode))
                            </td>
                            <td class="text-danger small">@r.ValidationError</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @await Html.PartialAsync("_Pagination", paged)
    }
</div>
