@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.ACT.Models
@inject IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> L
@model SmartFactory.MES.Models.PaginatedList<SmartFactory.MES.Modules.ACT.Models.JournalEntry>

<link rel="stylesheet" href="~/css/panel-table.css" />

@{
    ViewData["Title"] = Localizer["PageTitle"];
    bool canPrint    = ViewBag.CanPrint == true;
    bool canCreate   = ViewBag.CanCreate == true;
    bool hasSearched = ViewBag.Searched as bool? ?? false;
    int  curPageSize = ViewBag.CurrentPageSize as int? ?? 20;
    string curPeriod  = ViewBag.SearchPeriod  as string ?? "";
    string curDocType = ViewBag.SearchDocType as string ?? "";
    var periodOptions  = ViewBag.PeriodOptions  as IEnumerable<string> ?? Enumerable.Empty<string>();
    var docTypeOptions = ViewBag.DocTypeOptions as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-journal-bookmark me-2"></i>@Localizer["PageTitle"]</h1>
        @if (canCreate)
        {
            <button class="btn btn-primary" data-action="openPanel"
                    data-url="/JournalEntry/Create" data-label="@L["NewManualJournal"]">
                <i class="bi bi-plus-lg me-1"></i>@L["NewManualJournal"]
            </button>
        }
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <input type="hidden" name="searched" value="true" />
                <div class="col-md-2">
                    <label class="form-label small">@Localizer["SearchPeriod"]</label>
                    <select name="searchPeriod" class="form-select">
                        <option value="">@L["AllPeriods"]</option>
                        @foreach (var p in periodOptions)
                        { <option value="@p" selected="@(curPeriod == p)">@p</option> }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">@Localizer["SearchDocType"]</label>
                    <select name="searchDocType" class="form-select">
                        <option value="">@L["AllSourceDocTypes"]</option>
                        @foreach (var t in docTypeOptions)
                        { <option value="@t" selected="@(curDocType == t)">@ActEnumDisplay.SourceDocTypeText(L, t)</option> }
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-search me-1"></i>@Localizer["Search"]</button>
                </div>
                @if (canPrint)
                {
                    <div class="col-auto">
                        <div class="btn-group">
                            <a asp-action="Export" asp-route-searchPeriod="@ViewBag.SearchPeriod"
                               asp-route-searchDocType="@ViewBag.SearchDocType" asp-route-format="xlsx"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-file-earmark-excel me-1"></i>@Localizer["ExportExcel"]
                            </a>
                            <button type="button" class="btn btn-outline-secondary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown"></button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-action="Export" asp-route-format="csv"
                                       asp-route-searchPeriod="@ViewBag.SearchPeriod" asp-route-searchDocType="@ViewBag.SearchDocType">
                                    <i class="bi bi-filetype-csv me-1"></i>@Localizer["ExportCsv"]</a></li>
                            </ul>
                        </div>
                    </div>
                }
                @await Html.PartialAsync("_PageSizeSelect")
            </form>
        </div>
    </div>

    @if (!hasSearched)
    {
        <div class="alert alert-light border text-muted text-center py-4">
            <i class="bi bi-search fs-4 d-block mb-2"></i>@Localizer["SearchFirst"]
        </div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center">@Localizer["NoData"]</div>
    }
    else
    {
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover table-sm align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["JournalId"]</th>
                        <th>@Localizer["PeriodId"]</th>
                        <th>@Localizer["EntryDate"]</th>
                        <th>@Localizer["SourceDocType"]</th>
                        <th>@Localizer["SourceDocId"]</th>
                        <th>@Localizer["Type"]</th>
                        <th>@Localizer["Description"]</th>
                        <th>@Localizer["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var j in Model)
                {
                    var typeBadge = j.Type switch {
                        JournalEntryType.Automatic  => "bg-primary",
                        JournalEntryType.Manual     => "bg-warning text-dark",
                        JournalEntryType.Adjustment => "bg-info text-dark",
                        _ => "bg-secondary"
                    };
                    <tr>
                        <td><code>@j.JournalId</code></td>
                        <td>@j.PeriodId</td>
                        <td>@j.EntryDate.ToString("yyyy-MM-dd")</td>
                        <td class="small">@ActEnumDisplay.SourceDocTypeText(L, j.SourceDocType)</td>
                        <td class="small text-muted">@(j.SourceDocId ?? "—")</td>
                        <td><span class="badge @typeBadge">@ActEnumDisplay.Text(L, j.Type)</span></td>
                        <td class="small text-muted">@(j.Description ?? "—")</td>
                        <td>
                            @await Html.PartialAsync("_PrintButton", Url.Action("Print", new { id = j.JournalId }))
                            <button class="btn btn-sm btn-outline-secondary"
                                    data-url="/JournalEntry/Details/@j.JournalId" data-label="@j.JournalId"
                                    data-action="openPanel"><i class="bi bi-eye"></i> @Localizer["View"]</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_Pagination", Model)
    }
</div>

<div class="offcanvas offcanvas-end shadow-lg u-panel-wide" tabindex="-1" id="sidePanel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="sidePanelLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0" id="sidePanelBody"></div>
</div>

<!-- Success Toast -->
<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@Localizer["SaveSuccess"]</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_CrudPanelScripts")
}
