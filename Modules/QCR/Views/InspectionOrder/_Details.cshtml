@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@model SmartFactory.MES.Models.InspectionOrder

@{
    var typeBadge = Model.InspectionType switch
    {
        "IQC"  => "bg-primary",
        "IPQC" => "bg-info text-dark",
        "FQC"  => "bg-success",
        "RQC"  => "bg-warning text-dark",
        _      => "bg-secondary"
    };
    var statusBadge = Model.Status switch
    {
        "Pass"    => "bg-success",
        "Fail"    => "bg-danger",
        "Pending" => "bg-warning text-dark",
        _         => "bg-secondary"
    };
    var userNames = ViewBag.UserNames as Dictionary<string, string> ?? new();
    var inspectorName = Model.InspectorId != null && userNames.TryGetValue(Model.InspectorId, out var n) ? n : Model.InspectorId;
}


<div class="offcanvas-body">
    <!-- 主檔：標題粗體、值一般字（原本兩者同為小字灰階，分不出哪個是標題；2026-10-27 回報），與其他明細面板同用 dl -->
    <dl class="row mb-3">
        <dt class="col-5">@Localizer["InspectionOrderId"]</dt>
        <dd class="col-7 font-monospace small text-break">@Model.InspectionOrderId</dd>

        <dt class="col-5">@Localizer["InspectionType"]</dt>
        <dd class="col-7"><span class="badge @typeBadge">@Model.InspectionType</span></dd>

        <dt class="col-5">@Localizer["SourceDocId"]</dt>
        <dd class="col-7">@Model.SourceDocId</dd>

        <dt class="col-5">@Localizer["ProductCode"]</dt>
        <dd class="col-7">@Model.ProductCode</dd>

        <dt class="col-5">@Localizer["LotSize"]</dt>
        <dd class="col-7">@Model.LotSize.ToString("N0")</dd>

        <dt class="col-5">@Localizer["SampleSize"]</dt>
        <dd class="col-7">@Model.SampleSize</dd>

        <dt class="col-5">@Localizer["VerificationLevel"]</dt>
        <dd class="col-7">VL-@Model.VerificationLevel</dd>

        <dt class="col-5">@Localizer["ActualSampleQty"]</dt>
        <dd class="col-7">@Model.ActualSampleQty</dd>

        <dt class="col-5">@Localizer["FailQty"]</dt>
        <dd class="col-7 @(Model.FailQty > 0 ? "text-danger fw-bold" : "")">@Model.FailQty</dd>

        <dt class="col-5">@Localizer["StatusCol"]</dt>
        <dd class="col-7"><span class="badge @statusBadge">@Localizer[Model.Status]</span></dd>

        <dt class="col-5">@Localizer["InspectorId"]</dt>
        <dd class="col-7">@(inspectorName ?? "—")</dd>

        <dt class="col-5">@Localizer["InspectedAt"]</dt>
        <dd class="col-7">@(Model.InspectedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>

        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <dt class="col-5">@Localizer["Remarks"]</dt>
            <dd class="col-7">@Model.Remarks</dd>
        }
    </dl>

    <!-- 量測明細 -->
    @if (Model.Items != null && Model.Items.Any())
    {
        <hr class="my-2" />
        <h6 class="fw-semibold mb-2">@Localizer["MeasurementItems"] (@Model.Items.Count)</h6>
        <div class="table-responsive">
            <table class="table table-sm table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th>@Localizer["SeqNo"]</th>
                        <th class="u-col-soft">@Localizer["ItemName"]</th>
                        <th>@Localizer["Spec"]</th>
                        <th class="text-end">@Localizer["MeasuredValue"]</th>
                        <th class="text-center">@Localizer["IsConforming"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items.OrderBy(i => i.SeqNo))
                    {
                        var specStr = item.LowerSpec.HasValue || item.UpperSpec.HasValue
                            ? $"{item.LowerSpec?.ToString("G") ?? "—"} ～ {item.UpperSpec?.ToString("G") ?? "—"}"
                            : (item.TargetValue.HasValue ? $"= {item.TargetValue}" : "—");
                        <tr>
                            <td class="text-center">@item.SeqNo</td>
                            <td>@item.ItemName</td>
                            <td class="small text-muted">@specStr</td>
                            <td class="text-end">@(item.MeasuredValue?.ToString("G") ?? "—") @item.UomCode</td>
                            <td class="text-center">
                                @if (item.IsConforming == true)
                                { <i class="bi bi-check-circle-fill text-success"></i> }
                                else if (item.IsConforming == false)
                                { <i class="bi bi-x-circle-fill text-danger"></i> }
                                else
                                { <span class="text-muted">—</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted small mt-2">@Localizer["NoMeasurementItems"]</p>
    }

    @* 待檢單（IPQC / FQC / RQC）桌機補登：Fail 時後端會自動暫停相關派工 *@
    @if (Model.Status == "Pending" && ViewBag.CanUpdate == true)
    {
        <hr class="my-3" />
        <form id="sideForm" method="post" action="@Url.Action("Submit", new { id = Model.InspectionOrderId })"
              data-action-submit="submitPanel">
            @Html.AntiForgeryToken()
            <h6 class="fw-semibold mb-2">@Localizer["SubmitResult"]</h6>
            <div class="row g-2">
                <div class="col-6">
                    <label class="form-label small fw-semibold" for="ActualSampleQty">
                        @Localizer["ActualSampleQty"] <span class="text-danger">*</span>
                    </label>
                    <input type="number" id="ActualSampleQty" name="ActualSampleQty" class="form-control form-control-sm"
                           step="1" min="0" value="@Model.SampleSize" required />
                </div>
                <div class="col-6">
                    <label class="form-label small fw-semibold" for="FailQty">
                        @Localizer["FailQty"] <span class="text-danger">*</span>
                    </label>
                    <input type="number" id="FailQty" name="FailQty" class="form-control form-control-sm"
                           step="1" min="0" value="0" required />
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold" for="MeasurementNotes">@Localizer["Remarks"]</label>
                    <textarea id="MeasurementNotes" name="MeasurementNotes" class="form-control form-control-sm"
                              rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="alert alert-light border small py-2 mt-2 mb-2">
                <i class="bi bi-info-circle me-1"></i>@Localizer["MilStdHint"]
            </div>
            <div class="d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-primary btn-sm">
                    <i class="bi bi-check-circle me-1"></i>@Localizer["SubmitResult"]
                </button>
                <button type="button" class="btn btn-secondary btn-sm" data-action="closeSidePanel">@Localizer["Close"]</button>
            </div>
        </form>
    }
    else
    {
        <div class="mt-3 d-flex justify-content-end">
            <button class="btn btn-secondary btn-sm" data-action="closeSidePanel">@Localizer["Close"]</button>
        </div>
    }
</div>
