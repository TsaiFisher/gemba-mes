@using Microsoft.AspNetCore.Mvc.Localization
@using SmartFactory.MES.Modules.MFG
@inject IViewLocalizer Localizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<SmartFactory.MES.ProjectZSharedResource> Shared
@model IReadOnlyList<SmartFactory.MES.Modules.QCR.Controllers.FpiPendingRow>

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    bool canCreate = ViewBag.CanCreate == true;
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h4 mb-0"><i class="bi bi-clipboard2-pulse me-2"></i>@Localizer["PageTitle"]</h1>
        <a asp-action="Index" asp-route-searched="true" asp-route-inspectionType="FPI"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-clipboard2-check"></i> @Localizer["BackToRecords"]
        </a>
    </div>

    <div class="alert alert-light border small py-2">
        <i class="bi bi-info-circle me-1"></i>@Localizer["PendingHint"]
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">@Localizer["NoPending"]</div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>@Localizer["DispatchId"]</th>
                                <th>@Localizer["WorkOrderId"]</th>
                                <th>@Localizer["OperationSeq"]</th>
                                <th>@Localizer["OperationName"]</th>
                                <th>@Localizer["ProductCode"]</th>
                                <th class="text-end">@Localizer["LotSize"]</th>
                                <th>@Localizer["MachineCode"]</th>
                                <th>@Localizer["Status"]</th>
                                <th>@Localizer["PlannedStartDate"]</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model)
                            {
                                var formUrl = Url.Action("FpiForm", new { dispatchId = row.DispatchId });
                                <tr>
                                    <td class="font-monospace small">@row.DispatchId</td>
                                    <td class="font-monospace small">@row.WorkOrderId</td>
                                    <td class="text-center">@row.OperationSeq</td>
                                    <td>@row.OperationName</td>
                                    <td>@row.ProductCode</td>
                                    <td class="text-end">@row.Quantity.ToString("N0")</td>
                                    <td class="small text-muted">@row.MachineCode</td>
                                    <td><span class="badge bg-secondary">@MfgEnumDisplay.Text(Shared, row.Status)</span></td>
                                    <td class="small text-muted">@(row.PlannedStartDate?.ToString("yyyy-MM-dd") ?? "")</td>
                                    <td class="text-end">
                                        @if (canCreate)
                                        {
                                            <button class="btn btn-primary btn-sm py-0"
                                                    data-url="@formUrl" data-label="@Localizer["InspectTitle"]"
                                                    data-action="openPanel">
                                                <i class="bi bi-pencil-square"></i> @Localizer["Inspect"]
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<!-- Side Panel offcanvas -->
<div class="offcanvas offcanvas-end u-min-width-560px u-max-width-95vw" tabindex="-1" id="sidePanel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title" id="sidePanelLabel"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body" id="sidePanelBody"></div>
</div>

<!-- Success Toast -->
<div class="position-fixed bottom-0 end-0 p-3 u-z-index-1100">
    <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body"><i class="bi bi-check-circle me-2"></i>@Localizer["Saved"]</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_CrudPanelScripts")
}
